			Guides: {
				Title: คู่มือ
				Intro: คู่มือสั้น ๆ ของระบบและม็อดที่คุณเปิดอยู่ กด {0} ได้ทุกเมื่อเพื่อเปิด Khu Mue

				Categories: {
					start: เริ่มต้นเล่น
					calamity: ระบบของ Calamity
					addons: ม็อดเสริม
					warnings: ข้อผิดพลาดที่ควรเลี่ยง
				}

				using-guide: {
					Title: วิธีใช้ Khu Mue
					Summary: แต่ละแท็บทำอะไร และหาข้อมูลให้เร็วได้อย่างไร

					Open: {
						Title: การเปิดคู่มือ
						Body: กด {0} เพื่อเปิดหรือปิดคู่มือ และกด Esc เพื่อปิดได้ ปุ่มย้อนกลับของเมาส์ (หรือลูกศรด้านบน) พากลับไปหน้าก่อน เปลี่ยนปุ่มได้ที่ Settings > Controls
					}

					Home: {
						Title: หน้าแรก
						Body: หน้าแรกอ่านสถานะโลกของคุณ แล้วแสดงว่าตอนนี้อยู่ช่วงไหน ขั้นหลักถัดไปพร้อมวิธีเริ่ม สิ่งอื่นที่ทำได้ตอนนี้ และอัปเกรดถาวรที่ยังไม่ได้ใช้
					}

					Progress: {
						Title: ความก้าวหน้า
						Body: บอส อีเวนต์ และเควสต์ทั้งหมดจากม็อดที่เปิดอยู่ เรียงตามลำดับ พร้อมสถานะ "ผ่านแล้ว" "ถัดไป" "สามารถทำได้" หรือ "ยังล็อกอยู่" คลิกเพื่อดูวิธีเริ่ม สิ่งที่ปลดล็อก และของที่ดรอป (อ่านจากเกม)
					}

					Gear: {
						Title: ชุดแนะนำ
						Body: อาวุธ ชุดเกราะ เครื่องประดับ และบัฟที่แนะนำตามคลาสและช่วงของคุณ ดัดแปลงจากวิกิของ Calamity และ Terraria หน้านี้จะเปิดที่ช่วงของโลกคุณ ใช้ลูกศรเพื่อดูช่วงอื่น
					}

					Items: {
						Title: ไอเทม
						Body: ค้นหาไอเทมได้ทั้งชื่ออังกฤษและไทย หน้าไอเทมแสดงสูตรคราฟต์พร้อมวัตถุดิบพื้นฐานที่ต้องใช้ทั้งหมด ดรอป ร้านค้า ถุง ผลลัพธ์ Shimmer หีบและจุดตกปลาที่พบไอเทมนั้น และนำไปคราฟต์อะไรได้บ้าง จุดสีเขียวหมายถึงคุณมีไอเทมนั้น
					}

					Upgrades: {
						Title: อัปเกรดถาวร
						Body: อัปเกรดถาวรทั้งหมด (Life Crystal, ผลไม้ของ Calamity, บูสเตอร์ Rage และ Adrenaline...) พร้อมบอกว่าตัวละครนี้ใช้อะไรไปแล้วบ้าง
					}
				}

				first-steps: {
					Title: ก้าวแรกของการเล่น
					Summary: เอาตัวรอดคืนแรก ๆ และเตรียมพร้อมสำหรับบอสตัวแรก

					Shelter: {
						Title: บ้านที่ปลอดภัย
						Body: สร้างบ้านก่อนค่ำ ห้องที่มีผนังพื้นหลัง ประตู แหล่งแสง โต๊ะ และเก้าอี้ จะนับเป็นที่อยู่อาศัย และ NPC ใหม่จะย้ายเข้ามาอยู่ในห้องแบบนี้
					}

					Explore: {
						Title: แร่และอุปกรณ์
						Body: ขุดลงไปหาแร่ แล้วอัปเกรด Pickaxe และชุดเกราะทีละขั้น หีบใต้ดินมักมีเครื่องประดับที่มีประโยชน์ เช่น Hermes Boots และ Cloud in a Bottle
					}

					Life: {
						Title: เพิ่มพลังชีวิตและมานา
						Body: Life Crystal แต่ละชิ้นเพิ่มพลังชีวิตสูงสุด 20 (ได้ถึง 400) ส่วน Mana Crystal คราฟต์จาก Fallen Star 5 ชิ้น ซึ่งตกลงมาตอนกลางคืน ดูรายการทั้งหมดได้ที่แท็บอัปเกรดถาวร
					}

					Progress: {
						Title: ทำอะไรต่อ?
						Body: แท็บหน้าแรกจะแสดงขั้นหลักถัดไปเสมอ เปิดดูเพื่อรู้วิธีเริ่มการต่อสู้และอุปกรณ์ที่ควรเตรียม
					}
				}

				difficulties: {
					Title: ระดับความยากของโลก
					Summary: Classic, Expert, Master และ Journey ต่างกันอย่างไร
					SummaryCal: Classic, Expert, Master และ Journey ต่างกันอย่างไร ส่วนโหมดของ Calamity อธิบายไว้ในหมวด Calamity

					Classic: {
						Title: Classic
						Body: เกมปกติ บอสดรอปไอเทมโดยตรงแทนที่จะอยู่ใน Treasure Bag
					}

					Expert: {
						Title: Expert
						Body: ศัตรูมีพลังชีวิตและดาเมจสูงขึ้น บอสมีท่าโจมตีใหม่ และบอสดรอป Treasure Bag ที่มีไอเทม Expert เฉพาะ ช่องเครื่องประดับเพิ่มจาก Demon Heart ใช้ได้เฉพาะโหมดนี้และ Master
					}

					Master: {
						Title: Master
						Body: แข็งแกร่งกว่า Expert อีกขั้น บอสดรอป Relic และสัตว์เลี้ยงเพิ่ม คุณได้ช่องเครื่องประดับเพิ่ม 1 ช่องตั้งแต่เริ่ม และจะทำเหรียญหล่นทั้งหมดเมื่อตาย
					}

					Journey: {
						Title: Journey
						Body: โหมดสร้างสรรค์: วิจัยไอเทมเพื่อเสกซ้ำได้ ควบคุมเวลาและสภาพอากาศ และปรับความยากของศัตรูด้วยแถบเลื่อน ตัวละคร Journey เล่นได้เฉพาะโลก Journey
					}
				}

				classes: {
					Title: คลาส
					Summary: คลาสดาเมจแต่ละแบบและการใช้ร่วมกัน

					Melee: {
						Title: Melee
						Body: ดาบ หอก โยโย่ และบูมเมอแรง ชุดเกราะสาย Melee มักมีพลังป้องกันสูงที่สุด
					}

					Ranged: {
						Title: Ranged
						Body: ธนูและปืนที่ใช้ลูกธนูและกระสุน รวมถึงเครื่องยิงต่าง ๆ เลือกกระสุนให้เหมาะกับงาน กระสุนเจาะทะลุสำหรับศัตรูเป็นกลุ่ม กระสุนแรงนัดเดียวสำหรับบอส
					}

					Magic: {
						Title: Magic
						Body: อาวุธที่ใช้มานา มานาสูงสุด การฟื้นมานา และ Mana Potion ช่วยให้ยิงได้ต่อเนื่อง
					}

					Summoner: {
						Title: Summoner
						Body: มินเนียนและ Sentry จะสู้แทนคุณ ส่วนแส้ใช้สั่งให้โฟกัสเป้าหมายและเสริมพลังให้มินเนียน
					}

					Mixing: {
						Title: การผสมคลาส
						Body: มินเนียนยังโจมตีต่อไปขณะคุณใช้อาวุธใดก็ได้ อุปกรณ์สาย Summon จึงเพิ่มดาเมจได้เสมอ
						BodyCal: ใน Calamity ถ้าถืออาวุธ Melee, Ranged, Magic หรือ Rogue มินเนียนจะทำดาเมจลดลง 25% และ Calamity ยังเพิ่มคลาส Rogue (ดูคู่มือ Rogue)
					}
				}

				boss-prep: {
					Title: เตรียมตัวสู้บอส
					Summary: สนามสู้ บัฟ และสิ่งที่ช่วยให้รอด

					Arena: {
						Title: สร้างสนามสู้
						Body: แพลตฟอร์มยาวหลายชั้นช่วยให้มีที่หลบ วาง Campfire, Heart Lantern และ Star in a Bottle ไว้ใกล้ ๆ เพื่อเพิ่มการฟื้นฟู และการยืนในน้ำผึ้งก็ช่วยฟื้นพลังชีวิต
					}

					Buffs: {
						Title: บัฟ
						Body: Ironskin, Regeneration, Swiftness, Endurance Potion และบัฟจากอาหาร ช่วยได้ทุกคลาส แท็บชุดแนะนำมีบัฟเฉพาะคลาสของแต่ละช่วง
					}

					Mobility: {
						Title: การเคลื่อนที่มาก่อน
						Body: ปีก การแดช และการกระโดดหลายครั้ง ช่วยลดดาเมจได้มากกว่าชุดเกราะ ควรอัปเกรดก่อนอย่างอื่น
					}

					Healing: {
						Title: การฟื้นพลัง
						Body: ยาฟื้นพลังใช้คูลดาวน์ร่วมกัน (Potion Sickness) ดื่มในจังหวะที่จำเป็น ไม่ใช่เร็วเกินไป
					}
				}

				hardmode: {
					Title: การเข้าสู่ Hardmode
					Summary: อะไรเปลี่ยนไปหลังชนะ Wall of Flesh

					Changes: {
						Title: อะไรเปลี่ยนไป
						Body: ศัตรูที่แรงขึ้นจะปรากฏทุกที่ และแถบ Hallow กับแถบสายชั่วร้ายแถบที่สองจะผ่ากลางโลก
					}

					Ores: {
						Title: แร่ใหม่
						Body: ทุบ Demon Altar หรือ Crimson Altar ด้วย Pwnhammer เพื่อให้แร่ Hardmode เกิด ทุบแต่ละครั้งจะได้แร่ระดับถัดไป (Cobalt/Palladium, Mythril/Orichalcum, Adamantite/Titanium)
						BodyCal: ระบบปรับ Hardmode ช่วงต้นของ Calamity (เปิดเป็นค่าเริ่มต้น): แร่ Cobalt และ Palladium จะเกิดทันทีเมื่อเข้า Hardmode และการทุบแท่นบูชาจะไม่ให้อะไร บอสจักรกลตัวแรกเพิ่ม Mythril และ Orichalcum ตัวที่สองเพิ่ม Adamantite และ Titanium ตัวที่สามเพิ่มแร่ Hallowed ใน Hallow ใต้ดิน และบอสจักรกลสองตัวแรกที่คุณสู้จะอ่อนลงเล็กน้อยด้วย
					}

					Spread: {
						Title: การแพร่กระจาย
						Body: Hallow และ Corruption หรือ Crimson จะค่อย ๆ เปลี่ยนหญ้า หิน ทราย และน้ำแข็งรอบ ๆ ป้องกันพื้นที่สำคัญด้วยช่องว่างหรือบล็อกที่ไม่ถูกเปลี่ยน
					}

					Next: {
						Title: เป้าหมายแรก
						Body: หาปีกให้ได้ แล้วสู้ Queen Slime และบอสจักรกล Soul of Light และ Soul of Night ดรอปจากศัตรูใน Hallow และไบโอมสายชั่วร้ายใต้ดิน
					}
				}

				shimmer: {
					Title: Shimmer
					Summary: ทะเลสาบระยิบระยับที่เปลี่ยนรูปไอเทม

					Find: {
						Title: อยู่ที่ไหน
						Body: ทะเลสาบ Shimmer อยู่ใน Aether ไบโอมใต้ดินใกล้ขอบโลก ฝั่งตรงข้ามกับ Dungeon
					}

					Transform: {
						Title: การเปลี่ยนรูปไอเทม
						Body: โยนไอเทมลงใน Shimmer เพื่อแปลงเป็นอย่างอื่น และไอเทมที่คราฟต์หลายชนิดจะถูกแยกกลับเป็นวัตถุดิบ หน้าไอเทมแสดงผลลัพธ์ Shimmer ไว้ในส่วนวิธีหา
					}

					Boosters: {
						Title: บูสเตอร์ถาวร
						Body: Life Crystal กลายเป็น [item:Terraria/AegisCrystal], Life Fruit กลายเป็น [item:Terraria/AegisFruit], Mana Crystal กลายเป็น [item:Terraria/ArcaneCrystal], Pink Pearl กลายเป็น [item:Terraria/GalaxyPearl], Gold Worm กลายเป็น [item:Terraria/GummyWorm] และผลไม้ชนิดใดก็ได้กลายเป็น [item:Terraria/Ambrosia]
					}

					Careful: {
						Title: ข้อควรระวัง
						Body: การสัมผัส Shimmer จะทำให้คุณทะลุบล็อกและตกลงไปจนกว่าจะหลุดออกมา ไม่ได้รับดาเมจ แต่อาจตกลงไปไกลมาก
					}
				}

				fishing: {
					Title: การตกปลา
					Summary: พลังการตกปลา ขนาดบ่อ การตกปลาในลาวา กล่อง (Crate) และเควสของ Angler

					Basics: {
						Title: เริ่มต้น
						Body: ถือเบ็ดตกปลา มีเหยื่ออยู่ในกระเป๋า แล้วเหวี่ยงเบ็ดลงบ่อ ของที่ได้ขึ้นกับชนิดของของเหลว ไบโอม และระดับความสูงที่ทุ่นตกลงไป หน้าไอเทมในคู่มือนี้บอกไว้ว่าไอเทมแต่ละชิ้นตกได้ที่ไหน
						BodyCal: ถือเบ็ดตกปลา มีเหยื่ออยู่ในกระเป๋า แล้วเหวี่ยงเบ็ดลงบ่อ ของที่ได้ขึ้นกับชนิดของของเหลว ไบโอม และระดับความสูงที่ทุ่นตกลงไป Calamity เพิ่มของที่ตกได้ใน Sunken Sea, Sulphurous Sea, Abyss, Astral Infection และในลาวาของ Brimstone Crag หน้าไอเทมในคู่มือนี้บอกไว้ว่าไอเทมแต่ละชิ้นตกได้ที่ไหน
					}

					Power: {
						Title: พลังการตกปลา
						Body: พลังการตกปลาคือค่าของเบ็ด เหยื่อ และโบนัสรวมกัน Fishing Potion ให้ 15, Angler Tackle Bag ให้ 10 และ Chum ในบ่อสูงสุดสามชิ้นเพิ่มให้อีก 11, 6 และ 3 ยิ่งพลังสูง ยิ่งมีโอกาสได้ของหายาก โชค (Luck) ก็มีผลด้วย โชคไม่ดีอาจทำให้พลังลดลง ส่วนโชคดีอาจทำให้พลังเพิ่มขึ้น
					}

					Water: {
						Title: ขนาดบ่อ
						Body: บ่อต้องมีของเหลวประมาณ 300 ช่องจึงจะได้พลังการตกปลาเต็มที่ ถ้าตกปลาในชั้นท้องฟ้าซึ่งอยู่สูงมาก ใช้น้อยกว่านั้นได้ บ่อที่เล็กกว่านี้จะทำให้พลังการตกปลาลดลง
					}

					Lava: {
						Title: ลาวาและน้ำผึ้ง
						Body: การตกปลาในลาวาต้องมีอย่างใดอย่างหนึ่งต่อไปนี้: Hotline Fishing Hook, เหยื่อลาวา (Magma Snail, Lavafly หรือ Hell Butterfly) หรือ Lavaproof Fishing Hook / Lavaproof Tackle Bag ส่วนน้ำผึ้งตกปลาได้โดยไม่ต้องใช้อะไรเพิ่ม
					}

					Crates: {
						Title: กล่อง (Crate)
						Body: ของที่ตกได้ประมาณ 1 ใน 10 เป็นกล่อง (Crate) และเพิ่มเป็น 1 ใน 4 เมื่อดื่ม Crate Potion ในกล่องมีแร่ แท่งโลหะ ยา เหรียญ และไอเทมของไบโอมที่ตกได้ เมื่อเข้าสู่ Hardmode จะได้กล่องรุ่น Hardmode
					}

					Angler: {
						Title: เควสของ Angler
						Body: ปลุก Angler ที่นอนหลับอยู่ริมทะเล ทุกเช้าเวลา 04:30 น. เขาจะขอปลาเควสหนึ่งตัว ซึ่งตกได้เฉพาะตอนที่เป็นเควสของเขาเท่านั้น นำไปส่งเพื่อรับรางวัล เมื่อทำเควสสำเร็จครั้งที่ 5, 10, 15, 20, 25 และ 30 จะได้ Fuzzy Carrot, Angler Hat, Angler Vest, Angler Pants, Bottomless Water Bucket และ Golden Fishing Rod ตามลำดับ และยิ่งทำเควสมาก รางวัลหายากก็ยิ่งออกบ่อยขึ้น
					}
				}

				cal-difficulty: {
					Title: โหมดความยากของ Calamity
					Summary: Revengeance, Death, Malice และวิธีเปลี่ยนโหมด

					Select: {
						Title: การเลือกโหมด
						Body: เปิดช่องเก็บของ ไอคอนความยากของ Calamity อยู่มุมขวาบนข้างแผนที่ย่อ คลิกเพื่อเลือกโหมด เปลี่ยนไม่ได้ระหว่างที่มีบอสอยู่หรือระหว่าง Boss Rush
					}

					Revengeance: {
						Title: Revengeance
						Body: ต้องเป็นโหมด Expert (ในโลก Master Calamity จะเปลี่ยนเป็น Death ให้เอง) เป็นประสบการณ์ที่ Calamity ตั้งใจให้เล่น และเป็นโหมดที่แท็บชุดแนะนำใช้เป็นฐาน เปิดใช้ Rage และ Adrenaline ศัตรูดุขึ้น บอสทุกตัวมีท่าใหม่ และบอสดรอปทั้งรางวัล Expert และ Master
					}

					Death: {
						Title: Death
						Body: ต้องเป็นโหมด Master ในโลก Master ถ้าเปิด Revengeance ระบบจะเปลี่ยนเป็น Death ให้เอง บอสเร็วและยากกว่า Revengeance มาก ศัตรูทั่วไปดุกว่ามาก Blood Moon มีศัตรูมาเป็นระลอกไม่หยุด ดีบัฟอันตรายขึ้น และ Abyss อันตรายยิ่งขึ้น
					}

					Malice: {
						Title: Malice
						Body: ต้องเป็นโหมด Legendary (โลก Master ที่ใช้ seed For the Worthy) ซึ่งระบบจะเปลี่ยน Revengeance เป็น Malice ให้เอง พฤติกรรมแบบ Death และ For the Worthy พร้อมค่าสถานะแบบ Legendary
					}
				}

				cal-rage-adrenaline: {
					Title: Rage และ Adrenaline
					Summary: เกจดาเมจสองแบบของ Revengeance

					Adrenaline: {
						Title: Adrenaline
						Body: เกจจะเพิ่มขณะสู้บอส และหมดเมื่อโดนโจมตี เมื่อเต็มให้กดปุ่ม Adrenaline เพื่อรับดาเมจ 2.5 เท่าเป็นเวลา 5 วินาที ระหว่างที่เกจเต็มและยังไม่ได้ใช้ ดาเมจที่คุณได้รับจะลดลงครึ่งหนึ่งด้วย
					}

					Rage: {
						Title: Rage
						Body: เกจจะเพิ่มเมื่ออยู่ใกล้ศัตรูหรือใช้ไอเทมบางชนิด เมื่อเต็มให้กดปุ่ม Rage เพื่อรับดาเมจ +35% เป็นเวลา 9 วินาที
					}

					Boosters: {
						Title: บูสเตอร์
						Body: Rage อยู่นานขึ้น 1 วินาทีต่อบูสเตอร์: [item:CalamityMod/MushroomPlasmaRoot], [item:CalamityMod/InfernalBlood], [item:CalamityMod/RedLightningContainer] ส่วน Adrenaline ได้ดาเมจ +20% และลดดาเมจที่ได้รับ +5% ต่อบูสเตอร์: [item:CalamityMod/ElectrolyteGelPack], [item:CalamityMod/StarlightFuelCell], [item:CalamityMod/Ectoheart] ทั้งหมดได้จาก Treasure Bag ในโหมด Revengeance
					}

					TrueMelee: {
						Title: ปุ่มและ True Melee
						Body: ตั้งปุ่ม Rage และ Adrenaline ได้ที่ Settings > Controls การโจมตีแบบ True Melee (ตัวอาวุธกระทบศัตรูโดยตรง) จะได้โบนัสดาเมจจาก Rage และ Adrenaline แค่ครึ่งเดียว
					}
				}

				cal-rogue: {
					Title: Rogue และ Stealth
					Summary: คลาสอาวุธขว้างของ Calamity

					Stealth: {
						Title: Stealth
						Body: การสวมเกราะสาย Rogue ทำให้สะสม Stealth ได้ Stealth จะเพิ่มขณะไม่ได้โจมตี (เพิ่มช้าลงขณะเคลื่อนที่) และจะลดลงเฉพาะตอนโจมตี ยิ่งมี Stealth มาก ดาเมจ Rogue ยิ่งสูง
					}

					Strikes: {
						Title: Stealth Strike
						Body: เมื่อ Stealth เต็ม การโจมตี Rogue ครั้งถัดไปจะเป็น Stealth Strike ซึ่งเป็นท่าพิเศษที่แรงกว่ามาก การฟื้น Stealth ที่เร็วขึ้นจะลดโบนัสดาเมจลงเล็กน้อย แต่ทำให้ใช้ Stealth Strike ได้บ่อยขึ้น
					}

					Gear: {
						Title: สองสไตล์การเล่น
						Body: แท็บชุดแนะนำแยกอาวุธและเครื่องประดับ Rogue เป็นสาย Spam (โจมตีให้เร็วที่สุด) และสาย Stealth Strike
					}
				}

				cal-summon: {
					Title: กติกาของ Summoner
					Summary: บทลงโทษของมินเนียนเมื่อถืออาวุธต่างคลาสใน Calamity

					Penalty: {
						Title: บทลงโทษ
						Body: ขณะถืออาวุธ Melee, Ranged, Magic หรือ Rogue มินเนียนและ Sentry จะทำดาเมจลดลง 25%
					}

					Exceptions: {
						Title: ข้อยกเว้น
						Body: แส้และอาวุธ Summon อื่น เครื่องมือ เครื่องประดับ และกระสุน ไม่ทำให้เกิดบทลงโทษ และบทลงโทษจะหายไปเมื่อใช้เกราะ Forbidden กับอาวุธ Magic, ชุด Forbidden Circlet กับอาวุธ Rogue, เกราะ Fearmonger, อัญมณีสีน้ำเงินของเกราะ GemTech, Profaned Soul Crystal และระหว่างอีเวนต์ Old One's Army
					}
				}

				cal-defense-damage: {
					Title: ดาเมจต่อพลังป้องกัน
					Summary: ทำไมพลังป้องกันลดลงหลังโดนโจมตี

					How: {
						Title: ทำงานอย่างไร
						Body: การโจมตีบางอย่างจะลดพลังป้องกันของคุณชั่วคราว และจะฟื้นกลับอย่างรวดเร็วเมื่อไม่โดนโจมตีต่อ การหลบไม่ให้โดนติด ๆ กันจึงสำคัญกว่าการเพิ่มพลังป้องกันอย่างเดียว
					}
				}

				cal-biomes: {
					Title: ไบโอมของ Calamity
					Summary: Sunken Sea, Sulphurous Sea, Abyss และอื่น ๆ

					SunkenSea: {
						Title: Sunken Sea
						Body: ลึกลงไปใต้ทะเลทรายคือ Sunken Sea ซากอาณาจักรที่ล่มสลาย Giant Clam จะอาศัยอยู่ที่นั่นหลังชนะ Desert Scourge และ Sea King (Amidias) จะย้ายเข้ามาเมื่อชนะทั้งสอง เขาให้ฟองอากาศช่วยหายใจใต้น้ำได้
					}

					Sulphurous: {
						Title: Sulphurous Sea
						Body: ทะเลฝั่งหนึ่งเป็นพิษ น้ำของมันจะทำให้คุณติดพิษเมื่ออยู่นาน Acid Rain และ Aquatic Scourge อยู่ที่นี่
					}

					Abyss: {
						Title: Abyss
						Body: ลึกลงไปใต้ Sulphurous Sea: มืด ลึก และอันตราย เตรียมอุปกรณ์ดำน้ำและแสงให้พร้อม หีบที่ถูกล็อกจะเปิดได้หลังชนะ Skeletron และห้ามวาร์ปด้วย Rod of Discord ที่นั่นเด็ดขาด
					}

					Astral: {
						Title: Astral Infection
						Body: ไบโอมต่างดาวจากดาวที่ตกลงมา สู้ Astrum Aureus และ Astrum Deus ที่นี่ และขุดแร่ Astral ได้หลังชนะ Astrum Deus
					}

					Crag: {
						Title: Brimstone Crag
						Body: พื้นที่ไหม้เกรียมใน Underworld ถิ่นของ Brimstone Elemental
					}

					Labs: {
						Title: ห้องแล็บและ Planetoid
						Body: ห้องแล็บร้างของ Draedon ซ่อนอยู่ใกล้ Sunken Sea, บน Planetoid ใหญ่บนฟ้า, ใน Jungle, ใน Underworld และลึกในถ้ำน้ำแข็ง ดูคู่มือห้องแล็บของ Draedon
					}
				}

				cal-acid-rain: {
					Title: Acid Rain
					Summary: อีเวนต์ของ Sulphurous Sea ที่มีสามระดับ

					Start: {
						Title: การเริ่ม
						Body: หลังชนะ Eye of Cthulhu แล้ว Acid Rain ครั้งแรกจะเริ่มเมื่อคุณเข้า Sulphurous Sea ส่วนครั้งต่อไปจะเริ่มเองตอนกลางคืน หรือใช้ [item:CalamityMod/CausticTear] ก็ได้ แต่ถ้าใช้ Caustic Tear ก่อนชนะ Eye of Cthulhu (หรือก่อน Hardmode) ไอเทมจะหายไปเปล่า ๆ
					}

					Tiers: {
						Title: ระดับ
						Body: ระดับ 1 หลัง Eye of Cthulhu, ระดับ 2 หลัง Aquatic Scourge (มี Cragmaw Mire), ระดับ 3 หลัง Polterghast (มี Mauler และ Nuclear Terror) และเมื่อทำระดับ 3 ให้ครบจะเรียก Old Duke
					}

					Fail: {
						Title: การล้มเหลว
						Body: อีเวนต์จะล้มเหลวถ้าฝนหยุด หรือไม่ได้กำจัดศัตรูของ Acid Rain เลย 2.5 นาที
					}
				}

				cal-draedon: {
					Title: ห้องแล็บของ Draedon และ Codebreaker
					Summary: แบบพิมพ์เขียว Power Cell และเส้นทางสู่ Exo Mechs

					Labs: {
						Title: ห้องแล็บ
						Body: ห้องแล็บของ Draedon มีแบบพิมพ์เขียวที่เข้ารหัส Power Cell Factory และ Charging Station ที่เก็บไปใช้ได้ Power Cell Factory จะผลิต Draedon Power Cell ไปเรื่อย ๆ
					}

					Codebreaker: {
						Title: Codebreaker
						Body: สร้าง [item:CalamityMod/CodebreakerBase] แล้วติดตั้งชิ้นส่วน: Decryption Computer ถอดรหัสแบบพิมพ์เขียวจาก Planetoid ได้ แบบของ Jungle ต้องมี Sensor Array เพิ่ม แบบของ Underworld ต้องมี Advanced Display เพิ่ม และแบบของถ้ำน้ำแข็งต้องมี Voltage Regulation System เพิ่ม
					}

					Power: {
						Title: Power Cell
						Body: การถอดรหัสใช้ Draedon Power Cell: 500 สำหรับแบบของ Planetoid, 950 สำหรับ Jungle, 1750 สำหรับ Underworld และ 5000 สำหรับถ้ำน้ำแข็ง อาวุธ Draedon's Arsenal ใช้พลังงานชาร์จ ซึ่งเติมได้ที่ Charging Station
					}

					ExoMechs: {
						Title: การเรียก Draedon
						Body: เมื่อติดตั้ง [item:CalamityMod/AuricQuantumCoolingCell] (หลังชนะ Yharon) Codebreaker จะติดต่อ Draedon และเริ่มการต่อสู้กับ Exo Mechs ได้
					}
				}

				cal-npcs: {
					Title: NPC ในเมืองของ Calamity
					Summary: ใครย้ายเข้ามา และเมื่อไร

					SeaKing: {
						Title: Sea King (Amidias)
						Body: ย้ายเข้ามาหลังชนะ Desert Scourge และ Giant Clam เขาให้ฟองอากาศช่วยหายใจใต้น้ำได้ และภายหลังจะขายเหยื่อสำหรับเรียก Old Duke
					}

					Bandit: {
						Title: Bandit
						Body: ย้ายเข้ามาหลังชนะ Skeletron ขณะที่มีผู้เล่นพก Platinum Coin (ในช่องเก็บของหรือที่เก็บของพกพา) ถ้าคุณรีฟอร์จบ่อย ลองไปหาเขา อาจคุ้มค่า
					}

					Archmage: {
						Title: Archmage (Permafrost)
						Body: ย้ายเข้ามาหลังชนะ Cryogen
					}

					Witch: {
						Title: Brimstone Witch (Calamitas)
						Body: ย้ายเข้ามาหลังชนะ Supreme Calamitas เธอเสริมพลังใหม่ให้ไอเทมของคุณได้
					}
				}

				cal-boss-rush: {
					Title: Boss Rush
					Summary: สู้บอสทุกตัวต่อเนื่องแบบเสริมพลังอย่างมาก

					Start: {
						Title: การเริ่ม
						Body: กดใช้ [item:CalamityMod/Terminus] ค้างไว้เพื่อเริ่ม Boss Rush ได้ทุกเวลา และใช้อีกครั้งเพื่อหยุด Terminus อยู่ในหีบของศาลเจ้าที่ก้นสุดของ Abyss และ Primordial Wyrm ก็ดรอปด้วย
					}

					Rules: {
						Title: กติกา
						Body: บอสจะมาทีละตัวต่อเนื่องและแข็งแกร่งกว่าปกติมาก ระหว่างนั้นไอเทมเรียกบอสปกติจะใช้ไม่ได้ และเปลี่ยนระดับความยากไม่ได้
					}
				}

				infernum: {
					Title: Infernum Mode
					Summary: การต่อสู้กับบอสแบบเขียนใหม่ที่ยากขึ้นสำหรับ Calamity

					What: {
						Title: คืออะไร
						Body: Infernum เขียนการต่อสู้ของบอสส่วนใหญ่ทั้งของ Calamity และเกมหลักใหม่ ด้วยท่าที่ยากขึ้นมาก และเพิ่มบอสใหม่ เช่น Bereft Vassal และ Dreadnautilus แบบบอสเต็มตัว
					}

					Enable: {
						Title: การเปิดใช้
						Body: เปิดช่องเก็บของ คลิกไอคอนความยากของ Calamity (มุมขวาบน) แล้วเลือก Infernum ระบบจะเปิด Revengeance และตั้งโลกเป็น Expert ให้อัตโนมัติ บอสเพิ่มของ Infernum จะแสดงในแท็บความก้าวหน้าเฉพาะตอนที่เปิด Infernum อยู่
					}

					Limits: {
						Title: ข้อจำกัด
						Body: Infernum จะปิดตัวเองในโลก Master, For the Worthy และ Zenith (Get fixed boi) และจะเตือนถ้าเปิด Eternity Mode ไว้ด้วย
					}
				}

				wotg: {
					Title: Wrath of the Gods
					Summary: เรื่องราวของ Solyn และเหล่าเทพในตอนจบ

					Story: {
						Title: เควสต์ของ Solyn
						Body: ม็อดนี้เล่าเรื่องของ Solyn นักเดินทางจากดวงดาว เควสต์ของเธอจะแสดงในแท็บความก้าวหน้าตามลำดับ: พบเธอ ตั้งแคมป์ ดูดาว สำรวจ Permafrost Keep ฟังเรื่อง Genesis นำ Antiseed กลับมา และสู้ Mars
					}

					Genesis: {
						Title: The Genesis
						Body: การเปิดใช้ Genesis ที่สร้างเสร็จแล้วจะเรียก Avatar of Emptiness หลังจากนั้นจะสู้ Nameless Deity โดยใช้ Terminus
					}
				}

				fables: {
					Title: Calamity Fables
					Summary: บอสช่วงต้นแบบปรับใหม่และศึกดวลในทะเลทราย

					Replace: {
						Title: การแทนที่บอสของ Calamity
						Body: Fables ปรับ Desert Scourge และ Crabulon ใหม่ ขณะที่ตัวเลือก "replace Calamity" เปิดอยู่ (ค่าเริ่มต้น) คู่มือจะแสดงเวอร์ชันของ Fables แทนของ Calamity
					}

					Bosses: {
						Title: บอสของม็อดนี้
						Body: Sir Nautilus รออยู่ในห้องลับใต้เนินทราย ส่วน Desert Scourge ล่อออกมาได้ด้วยตัวอ่อน Stormlion และ Crabulon ถูกยั่วให้ออกมาด้วย Hookstaff บนหญ้าเห็ดใต้ดิน ถ้าเปิด Spirit Reforged ด้วย การถวายตัวอ่อนที่ Ancient Altar จะเริ่มศึกดวล Scourge vs. Scarab
					}
				}

				hunt: {
					Title: Hunt of the Old God
					Summary: Goozma, Auric Soul และคำสาป Shadowspec

					Goozma: {
						Title: Goozma
						Body: โยน [item:CalamityMod/OverloadedSludge] ใส่ King Slime ระหว่าง Slime Rain หรือใช้ [item:CalamityHunt/PluripotentSpawnEgg] กับ Slime Ninja Statue ที่ถูกเสริมพลัง เรียกได้ตั้งแต่ Hardmode แต่ปรับสมดุลไว้สำหรับช่วงท้ายเกม
					}

					Souls: {
						Title: Auric Soul
						Body: Goozma, Yharon และ Old Duke จะดรอป Auric Soul ทุกครั้งที่ถูกชนะ ตราบใดที่ยังมีผู้เล่นในโลกที่ยังไม่ได้ดูดซับ Soul นั้น เดินไปแตะเพื่อดูดซับ: พลังชีวิตสูงสุด +10 มานาสูงสุด +20 พลังป้องกัน +3 และ +3% ให้ดาเมจ อัตราคริติคอล ความเร็วโจมตีระยะประชิด และความเร็วเคลื่อนที่
					}

					Curse: {
						Title: คำสาป Shadowspec
						Body: ตัวเลือก Shadowspec Curse ของ Hunt เปิดอยู่เป็นค่าเริ่มต้น ไอเทมที่คราฟต์จาก Shadowspec Bar จะใช้หรือสวมใส่ไม่ได้จนกว่าจะชนะ Goozma ในโลกนั้น และจะมีเครื่องหมายคำถามในช่องเก็บของ (รวมถึงในคู่มือนี้) ถ้าต้องการยกเลิก ให้ปิดตัวเลือกนี้ในการตั้งค่าม็อด Hunt of the Old God
					}
				}

				catalyst: {
					Title: Catalyst
					Summary: Astrageldon และทำไมต้องสู้ก่อน Moon Lord

					Astrageldon: {
						Title: Astrageldon
						Body: ใช้ [item:CatalystMod/AstralCommunicator] บนผิวดินของ Astral Infection ต้องชนะ Astrageldon ก่อน Moon Lord เพราะหลังจากนั้น Communicator จะใช้ไม่ได้ในโลกนั้น หากยังไม่เคยชนะ Astrageldon
					}
				}

				spirit: {
					Title: Spirit Reforged
					Summary: Scarabeus แห่ง Ziggurat

					Scarabeus: {
						Title: Scarabeus
						Body: ใช้อัญมณีชนิดใดก็ได้ที่ Ancient Altar บน Ziggurat ในทะเลทรายตอนกลางวัน แท่นบูชานี้คราฟต์ได้ด้วย
					}
				}

				mistakes: {
					Title: ข้อผิดพลาดที่พบบ่อย
					Summary: สิ่งที่ทำแล้วอาจเสียใจภายหลัง

					Hardmode: {
						Title: การเริ่ม Hardmode
						Body: การชนะ Wall of Flesh ย้อนกลับไม่ได้ Hallow และไบโอมสายชั่วร้ายจะเริ่มแพร่กระจาย ป้องกันพื้นที่สำคัญก่อน
					}

					Dungeon: {
						Title: เข้า Dungeon เร็วเกินไป
						Body: การเข้า Dungeon ก่อนชนะ Skeletron จะเรียก Dungeon Guardian ซึ่งทำให้คุณตายแทบทันที
					}

					Enrage: {
						Title: ออกจากสนามสู้
						Body: Plantera จะคลั่งเมื่อออกนอก Jungle และ Duke Fishron จะคลั่งเมื่อออกนอกทะเล สู้ในถิ่นของพวกมัน
					}

					Empress: {
						Title: Empress ตอนรุ่งเช้า
						Body: ถ้าพระอาทิตย์ขึ้นระหว่างสู้ Empress of Light การโจมตีของเธอแทบจะทำให้ตายในทีเดียว ควรเริ่มตั้งแต่หัวค่ำ
					}
				}

				cal-mistakes: {
					Title: กับดักใน Calamity
					Summary: ตัวกระตุ้นที่ซ่อนอยู่ซึ่งเรียกบอสหรือทำให้เสียไอเทม

					Abyss: {
						Title: การวาร์ปใน Abyss
						Body: ห้ามใช้ Rod of Discord (หรืออะไรก็ตามที่ทำให้ติด Chaos State) ขณะอยู่ใน Abyss เพราะจะเรียก Primordial Wyrm ออกมาทันที ไม่ว่าจะอยู่ช่วงไหนของเกม
					}

					Triggers: {
						Title: ศัตรูที่เรียกบอส
						Body: การทำลายสิ่งเหล่านี้จะเรียกบอส: Hive Tumor (The Hive Mind), Perforator Cyst (The Perforators), นักร้องลึกลับในทะเล (Anahita และ Leviathan แม้ก่อน Hardmode), Sand Shark 10 ตัวหลัง Plantera (Great Sand Shark) และ Phantom Spirit 30 ตัว (Polterghast)
					}

					Tear: {
						Title: ใช้ Caustic Tear เร็วเกินไป
						Body: Caustic Tear ที่ใช้ก่อนชนะ Eye of Cthulhu (หรือก่อน Hardmode) จะหายไปโดยไม่เริ่ม Acid Rain
					}

					SmallWorld: {
						Title: โลกขนาดเล็ก
						Body: Calamity ไม่รองรับโลกขนาดเล็ก ควรใช้โลกขนาดกลางหรือใหญ่
					}
				}
			}

			Settings: {
				Title: ตั้งค่า
				Options: ตัวเลือก
				Key: เปิดหรือปิดคู่มือด้วยปุ่ม {0} เปลี่ยนปุ่มได้ที่ Settings > Controls (ค้นหา Khu Mue) ถ้าปุ่มนี้ซ้ำกับคำสั่งอื่น ให้เปลี่ยนปุ่มของคำสั่งใดคำสั่งหนึ่ง
				KeyClash: ปุ่ม {0} ถูกตั้งให้ใช้กับ: {1} ด้วย กดแล้วจะทำงานทั้งสองอย่าง
				KeyNone: ยังไม่มีปุ่มเปิดคู่มือ เพราะ tModLoader ไม่ตั้งปุ่มให้ม็อดใหม่เอง ตั้งปุ่มได้ที่ Settings > Controls (ค้นหา Khu Mue) หรือพิมพ์ /khumue ในช่องแชต
				KeyNoneChat: Khu Mue ยังไม่มีปุ่มเปิด ตั้งปุ่มได้ที่ Settings > Controls (ค้นหา Khu Mue) หรือพิมพ์ /khumue ในช่องแชตเพื่อเปิด
				KeyClashChat: Khu Mue เปิดด้วยปุ่ม {0} ซึ่งถูกตั้งให้ใช้กับ: {1} ด้วย ถ้ากดแล้วเกิดสิ่งที่ไม่ต้องการ ให้เปลี่ยนปุ่มใดปุ่มหนึ่งที่ Settings > Controls
				TextSize: ขนาดตัวอักษร
				WindowSize: ขนาดหน้าต่าง
				HideSpoilers: ซ่อนสปอยล์
				OpenForNew: เปิดให้อัตโนมัติสำหรับตัวละครใหม่
				VersionNotice: แจ้งเตือนเวอร์ชัน
				Mods: ม็อดที่รองรับ
				ModsIntro: ข้อมูลเส้นทางและชุดแนะนำตรวจสอบกับเวอร์ชันเหล่านี้โดยตรง ส่วนสูตรคราฟต์ ดรอป และร้านค้าอ่านจากเกมของคุณเสมอ
				NotLoaded: ไม่ได้เปิดใช้
				CheckedFor: ตรวจสอบกับ: {0}

				Match: {
					Exact: ตรงกันทุกประการ
					Near: เวอร์ชันใกล้เคียง
					Different: เวอร์ชันต่างกัน
					NotLoaded: ไม่ได้เปิดใช้
				}

				DataErrors: ข้อมูลคู่มือผิดพลาด
				About: เกี่ยวกับ
				AboutBody: Khu Mue อ่านสูตรคราฟต์ ดรอป ร้านค้า ผลลัพธ์ Shimmer และค่าสถานะจากเกมของคุณโดยตรง จึงตรงกับม็อดที่คุณใช้อยู่เสมอ ส่วนเส้นทาง ช่วงความก้าวหน้า และชุดแนะนำ ตรวจสอบด้วยมือกับเวอร์ชันม็อดที่แสดงด้านบน
				Credits: ชุดแนะนำดัดแปลงจาก Calamity Mod Wiki (CC BY-NC-SA 3.0) และ Terraria Wiki (CC BY-NC-SA 4.0) Khu Mue ไม่ได้เกี่ยวข้องกับ Re-Logic หรือทีมผู้สร้างม็อดที่รองรับ
			}

			Entries: {
				KingSlime: {
					Short: สไลม์ยักษ์ บอสแรกที่ไม่ยาก
					Summary: สไลม์ยักษ์ที่กระโดด วาร์ป และปล่อยสไลม์ตัวเล็กออกมา เหมาะเป็นบอสตัวแรก
					Summon: ใช้ [item:Terraria/SlimeCrown] หรืออาจปรากฏเองในบริเวณริมโลก หรือหลังกำจัดสไลม์ครบ 150 ตัวระหว่าง Slime Rain
					Tips:
						'''
						• สู้บนพื้นเรียบและมีแพลตฟอร์มด้านบนไว้หลบ
						• อาวุธที่ทะลุหรือโจมตีเป็นวงช่วยเคลียร์สไลม์ตัวเล็กที่มันปล่อยออกมา
						'''
				}

				TorchGod: {
					Short: อีเวนต์ลับ: วางคบเพลิงใต้ดินมากเกินไป
					Summary: อีเวนต์ลับ: Torch God จะโจมตีเมื่อคุณวางคบเพลิงใกล้ ๆ กันจำนวนมากใต้ดิน รอดให้ได้เพื่อรับ [item:Terraria/TorchGodsFavor]
					Summon: วางคบเพลิง 101 อันใกล้ ๆ กันขณะอยู่ใต้ดิน อีเวนต์จะเริ่มเมื่อวางอันสุดท้าย
					Unlocks: "[item:Terraria/TorchGodsFavor]: ปุ่มข้างช่องเก็บของที่เปลี่ยนคบเพลิงที่วางให้เป็นคบเพลิงของไบโอมที่คุณอยู่"
					Tips: • ทำในห้องเล็ก ๆ ใต้ดินที่มีที่ว่างพอให้หลบเปลวไฟจากคบเพลิงที่ตกลงมา
				}

				EyeOfCthulhu: {
					Short: บอสหลักตัวแรก ดรอปแร่สายชั่วร้ายของโลก
					Summary: ดวงตายักษ์ที่พุ่งชนใส่คุณและจะเร็วขึ้นมากในเฟสที่สอง เป็นขั้นแรกของเส้นทางหลัก
					Summon: ใช้ [item:Terraria/SuspiciousLookingEye] ตอนกลางคืน หรืออาจมาเองตอนหัวค่ำ (โอกาส 1 ใน 3) เมื่อมีผู้เล่นที่มีพลังชีวิตสูงสุด 200 และพลังป้องกันมากกว่า 10 และมี NPC ในเมืองอย่างน้อย 4 คน
					Unlocks: ดรอปแร่ Demonite หรือ Crimtane (ตามสายชั่วร้ายของโลก) สำหรับทำอุปกรณ์ระดับบอสชุดแรก
					UnlocksCal: ดรอปแร่ Demonite หรือ Crimtane ส่วนใน Calamity ยังทำให้ Acid Rain เริ่มได้ ครั้งแรกจะเริ่มเมื่อคุณเข้าไปใน Sulphurous Sea และศัตรูใน Blood Moon จะเริ่มดรอป Blood Orb
					Tips:
						'''
						• สร้างสะพานแพลตฟอร์มยาว ๆ กลางอากาศเพื่อวิ่งซ้ายขวาได้
						• ในเฟสที่สองมันจะพุ่งหลายครั้งติดกัน ให้เคลื่อนที่ไปด้านข้างตลอด
						'''
				}

				BloodMoon: {
					Name: Blood Moon
					Short: คืนสีแดง: ศัตรูมากขึ้นและแรงขึ้น
					Summary: อีเวนต์กลางคืน: ศัตรูเกิดบ่อยขึ้นมาก มีศัตรูพิเศษของ Blood Moon และการตกปลาอาจได้มอนสเตอร์ขึ้นมา ซอมบี้เปิดประตูได้
					Summon: เกิดเองตอนเริ่มกลางคืนบางคืน (โอกาส 1 ใน 9 และไม่เกิดในคืนเดือนมืด) เมื่อมีผู้เล่นใช้ Life Crystal อย่างน้อย 2 ชิ้น หรือใช้ [item:Terraria/BloodMoonStarter] ตอนกลางคืน
					SummonCal: เกิดเองตอนเริ่มกลางคืนบางคืน (โอกาส 1 ใน 9 และไม่เกิดในคืนเดือนมืด) Calamity เพิ่มเงื่อนไข: ต้องมีผู้เล่นใช้ Life Crystal อย่างน้อย 5 ชิ้น (พลังชีวิตสูงสุด 200) หรือใช้ [item:Terraria/BloodMoonStarter] ตอนกลางคืน
					Tips:
						'''
						• การตกปลาช่วง Blood Moon อาจได้มอนสเตอร์ที่อันตรายแต่ให้ของดี
						• อยู่ในฐานที่ปลอดภัย เพราะซอมบี้เปิดประตูได้
						'''
					TipsCal:
						'''
						• หลังชนะ Eye of Cthulhu ศัตรูใน Blood Moon จะดรอป Blood Orb ซึ่งใช้คราฟต์ยาได้หลายชนิด
						• ในโหมด Death ช่วง Blood Moon ศัตรูจะมาเป็นระลอกไม่หยุด
						• อยู่ในฐานที่ปลอดภัย เพราะซอมบี้เปิดประตูได้
						'''
				}

				EaterOfWorlds: {
					Short: บอสหนอนของ Corruption
					Summary: หนอนยักษ์ที่มีหลายปล้อง ตีกลางลำตัวแล้วจะแยกเป็นหนอนตัวเล็ก เป็นบอสของ Corruption และเป็นขั้นในเส้นทางหลัก
					Summon: ใช้ [item:Terraria/WormFood] ใน Corruption หรือทุบ Shadow Orb ในหุบเหวของ Corruption (ทุบครบลูกที่สามจะเรียกบอส)
					Unlocks: อุกกาบาตเริ่มตกได้และ Tavernkeep ย้ายเข้ามาได้ ส่วน Demonite Bar และ Shadow Scale ที่ได้ใช้ทำอุปกรณ์และ Pickaxe ที่ขุด Hellstone ได้
					UnlocksCal: อุกกาบาตเริ่มตกได้และ Tavernkeep ย้ายเข้ามาได้ ส่วน Demonite Bar และ Shadow Scale ใช้ทำอุปกรณ์และ Pickaxe ที่ขุด Hellstone ได้ บอสถัดไปคือบอส Corruption ของ Calamity: [e:HiveMind]
					Tips:
						'''
						• อาวุธที่ทะลุหรือโจมตีเป็นวงจะโดนหลายปล้องพร้อมกัน
						• ทุบ Shadow Orb ทีละลูกเมื่อพร้อม เพราะลูกที่สามจะเรียกบอส
						'''
				}

				BrainOfCthulhu: {
					Short: บอสสมองของ Crimson
					Summary: สมองลอยได้ที่มี Creeper คอยป้องกัน จะทำดาเมจไม่ได้จนกว่า Creeper จะหมด จากนั้นมันจะวาร์ปรอบตัวคุณ เป็นบอสของ Crimson และเป็นขั้นในเส้นทางหลัก
					Summon: ใช้ [item:Terraria/BloodySpine] ใน Crimson หรือทุบ Crimson Heart ในหุบเหวของ Crimson (ทุบครบลูกที่สามจะเรียกบอส)
					Unlocks: อุกกาบาตเริ่มตกได้และ Tavernkeep ย้ายเข้ามาได้ ส่วน Crimtane Bar และ Tissue Sample ใช้ทำอุปกรณ์และ Pickaxe ที่ขุด Hellstone ได้
					UnlocksCal: อุกกาบาตเริ่มตกได้และ Tavernkeep ย้ายเข้ามาได้ ส่วน Crimtane Bar และ Tissue Sample ใช้ทำอุปกรณ์และ Pickaxe ที่ขุด Hellstone ได้ บอสถัดไปคือบอส Crimson ของ Calamity: [e:Perforators]
					Tips:
						'''
						• กำจัด Creeper ให้หมดก่อน สมองจึงจะโดนดาเมจได้
						• อาวุธโจมตีเป็นวงหรือทะลุช่วยเคลียร์ Creeper ได้เร็ว
						'''
				}

				GoblinArmy: {
					Name: Goblin Army
					Short: ก็อบลินบุก ปลดล็อก Goblin Tinkerer
					Summary: กองทัพก็อบลินบุกเมืองของคุณ ชนะแล้วจะช่วย Goblin Tinkerer ได้ ซึ่งรีฟอร์จไอเทมและขาย Tinkerer's Workshop สำหรับรวมเครื่องประดับ
					Summon: ใช้ [item:Terraria/GoblinBattleStandard] หรืออาจมาเองตอนรุ่งเช้า เมื่อเคยทุบ Shadow Orb หรือ Crimson Heart แล้วและมีผู้เล่นที่มีพลังชีวิตสูงสุด 200
					Unlocks: จะพบ Goblin Tinkerer ถูกมัดอยู่ในชั้นถ้ำ คุยกับเขาเพื่อปลดปล่อย
					Tips: • อีเวนต์จบเมื่อกำจัดก็อบลินได้ครบตามจำนวน ดูความคืบหน้าได้จากแถบด้านบน
				}

				OldOnesArmy: {
					Name: Old One's Army
					Short: ป้องกัน Eternia Crystal (Tavernkeep)
					Summary: อีเวนต์แนวป้องกันฐาน: ศัตรูเดินเป็นระลอกเข้าหา Eternia Crystal รางวัลคือ Defender Medal สำหรับซื้อ Sentry และชุดเกราะจาก Tavernkeep
					Summon: ซื้อ [item:Terraria/DD2ElderCrystalStand] และ [item:Terraria/DD2ElderCrystal] จาก Tavernkeep วางแท่นแล้วใช้คริสตัลกับแท่น
					Unlocks: ระดับ 1 เล่นได้ตลอด ระดับ 2 หลังชนะบอสจักรกลตัวใดก็ได้ ระดับ 3 หลังชนะ Golem แต่ละระดับศัตรูแรงขึ้นและรางวัลดีขึ้น
					Requires: Tavernkeep จะย้ายเข้ามาหลังชนะ Eater of Worlds หรือ Brain of Cthulhu
					Tips:
						'''
						• ศัตรูมุ่งโจมตีคริสตัล ไม่ใช่คุณ วาง Sentry ไว้ทั้งสองฝั่ง
						• ถ้าคริสตัลแตก อีเวนต์จะจบทันที
						'''
				}

				DarkMage: {
					Short: มินิบอสของ Old One's Army (ระดับ 1 และ 3)
					Summary: มินิบอสของ Old One's Army ระดับ 1 และ 3 ปรากฏในระลอกที่ 5 ของระดับ 1 และระลอกที่ 5 กับ 6 ของระดับ 3
					Tips: • จัดการให้เร็วเพื่อไม่ให้ศัตรูตัวอื่นล้นแนวป้องกัน
				}

				QueenBee: {
					Short: ราชินีผึ้งแห่ง Jungle ไม่บังคับ
					Summary: ผึ้งยักษ์ที่พุ่งข้ามจอและปล่อยฝูงผึ้ง ไม่บังคับ แต่ของที่ดรอปเป็นอุปกรณ์ช่วงต้นที่ดี
					Summon: ใช้ [item:Terraria/Abeemination] ใน Jungle หรือทุบตัวอ่อนในรังผึ้ง (Bee Hive) ใน Jungle ใต้ดิน
					Tips:
						'''
						• ยืนในน้ำผึ้งจะได้บัฟฟื้นพลังชีวิต
						• ท่าพุ่งของเธอเป็นแนวนอน หลบโดยขยับขึ้นหรือลง
						'''
				}

				Skeletron: {
					Short: ผู้พิทักษ์ Dungeon ชนะแล้วจึงเข้า Dungeon ได้
					Summary: หัวกะโหลกยักษ์พร้อมมือสองข้างที่เฝ้า Dungeon ชนะแล้ว Dungeon จะเปิดและ Clothier จะเป็นอิสระ
					Summon: คุยกับ Old Man ที่หน้าทางเข้า Dungeon ตอนกลางคืนแล้วเลือกสาปเขา หรือสวม [item:Terraria/ClothierVoodooDoll] แล้วกำจัด Clothier ตอนกลางคืน
					Unlocks: Dungeon: ศัตรู หีบ (ใช้ Golden Key) และ Mechanic ที่ถูกมัดอยู่ข้างใน
					UnlocksCal: Dungeon: ศัตรู หีบ (ใช้ Golden Key) และ Mechanic ที่ถูกมัดอยู่ข้างใน ส่วนใน Calamity ยังปลดล็อกหีบที่ถูกล็อกใน Abyss ด้วย
					Warning: อย่าเข้า Dungeon ก่อนชนะ Skeletron เพราะ Dungeon Guardian จะทำให้คุณตายแทบทันที
					Tips:
						'''
						• ท่าหมุนตัวของมันแรงมาก เคลื่อนที่ตลอดและใช้สนามแพลตฟอร์มยาว
						• ต้องชนะก่อนรุ่งเช้า ไม่อย่างนั้นมันจะแรงขึ้นจนแทบสู้ไม่ได้
						'''
				}

				Deerclops: {
					Short: บอสไบโอมหิมะ ไม่บังคับ
					Summary: สัตว์ประหลาดกวางตาเดียวแห่งดินแดนหิมะ สร้างหนามน้ำแข็งและมือเงา และทำให้คุณช้าลงได้ ไม่บังคับ
					Summon: ใช้ [item:Terraria/DeerThing] ในไบโอมหิมะ หรืออาจปรากฏเองตอนเที่ยงคืนระหว่างพายุหิมะ (Blizzard)
					Tips: • สู้บนพื้นเรียบ เพราะหนามน้ำแข็งของมันวิ่งไปตามพื้น
				}

				WallOfFlesh: {
					Short: ประตูสู่ Hardmode
					Summary: กำแพงเนื้อที่เคลื่อนผ่านทั่วทั้ง Underworld ชนะแล้วโลกจะเข้าสู่ Hardmode
					Summon: โยน [item:Terraria/GuideVoodooDoll] ลงลาวาใน Underworld ขณะที่ Guide ยังมีชีวิตอยู่
					Unlocks: Hardmode: ศัตรูใหม่ ไบโอม Hallow และแถบสายชั่วร้ายใหม่ รวมถึง Pwnhammer สำหรับทุบแท่นบูชา และบอสใหม่อีกมาก
					UnlocksCal: Hardmode: ศัตรูใหม่ ไบโอม Hallow และแถบสายชั่วร้ายใหม่ รวมถึงบอสใหม่อีกมาก ด้วยระบบปรับ Hardmode ช่วงต้นของ Calamity (เปิดเป็นค่าเริ่มต้น) แร่ Cobalt และ Palladium จะเกิดทันที การทุบแท่นบูชาจะไม่ให้อะไร และบอสจักรกลแต่ละตัวจะเพิ่มแร่ระดับถัดไป
					Warning: Hardmode ทำให้ Hallow และ Corruption หรือ Crimson แพร่กระจาย ควรป้องกันพื้นที่สำคัญก่อนสู้
					Tips:
						'''
						• สร้างสะพานยาวผ่าน Underworld เพื่อวิ่งหนีไปพร้อมกับโจมตี
						• อย่าอยู่ห่างจากมันเกินไป เพราะมันจะใช้ลิ้นดึงคุณกลับไป
						'''
				}

				FrostLegion: {
					Name: Frost Legion
					Short: มนุษย์หิมะบุก ช่วงคริสต์มาสเท่านั้น
					Summary: การบุกของมนุษย์หิมะติดอาวุธในช่วงเทศกาลคริสต์มาส
					Summon: ใช้ [item:Terraria/SnowGlobe] ในช่วงเทศกาลคริสต์มาส Snow Globe ได้จากการเปิด Present
					Requires: ต้องเป็น Hardmode และอยู่ในช่วงเทศกาลคริสต์มาส
				}

				PirateInvasion: {
					Name: Pirate Invasion
					Short: โจรสลัดบุกจากทะเล
					Summary: โจรสลัดบุกเมืองของคุณ บางครั้งมีเรือ Flying Dutchman มาด้วย ดรอปเหรียญและอุปกรณ์โจรสลัด
					Summon: ใช้ [item:Terraria/PirateMap] ซึ่งดรอปจากศัตรูในทะเลช่วง Hardmode หรืออาจเริ่มเองในช่วง Hardmode
					Unlocks: หลังชนะครั้งแรก Pirate จะย้ายเข้ามาได้
					Requires: ต้องเป็น Hardmode
				}

				FlyingDutchman: {
					Short: มินิบอสเรือโจรสลัดบินได้
					Summary: เรือโจรสลัดบินได้ที่มีปืนใหญ่ 4 กระบอก บางครั้งจะปรากฏระหว่างการบุกของโจรสลัด
					Tips: • ทำลายปืนใหญ่ทีละกระบอกจากด้านบนหรือด้านล่าง
				}

				QueenSlime: {
					Short: ราชินีสไลม์แห่ง Hallow บอส Hardmode ตัวแรก
					Summary: ราชินีสไลม์คริสตัลแห่ง Hallow ในเฟสที่สองจะบินได้ เป็นบอส Hardmode ที่เหมาะเริ่มต้น
					Summon: ใช้ [item:Terraria/QueenSlimeCrystal] ใน Hallow
					Requires: ต้องเป็น Hardmode
					Tips: • กำจัดสไลม์คริสตัลที่เธอปล่อยออกมา เพราะมันยิงได้ทุกทิศทาง
				}

				Twins: {
					Name: The Twins
					Short: บอสจักรกล: ดวงตาเลเซอร์สองดวง
					Summary: Retinazer และ Spazmatism ดวงตาจักรกลสองดวงที่สู้พร้อมกัน เป็นหนึ่งในบอสจักรกลสามตัวที่ต้องชนะก่อนสู้ Plantera
					Summon: ใช้ [item:Terraria/MechanicalEye] ตอนกลางคืน บอสจักรกลยังอาจปรากฏเองตอนกลางคืนในช่วง Hardmode จนกว่าจะชนะตัวใดตัวหนึ่ง
					Unlocks: Soul of Sight เมื่อรวมกับบอสจักรกลอีกสองตัว: Plantera, เครื่องมือขุด Chlorophyte และ Life Fruit
					UnlocksCal: Soul of Sight ส่วนบอสจักรกลแต่ละตัวจะเพิ่มแร่ Hardmode ระดับถัดไป (ระบบปรับ Hardmode ช่วงต้นของ Calamity) และเมื่อชนะครบสามตัว: Plantera และแร่ Hallowed
					Requires: ต้องเป็น Hardmode
					Tips: • โฟกัสทีละดวง เพราะไฟคำสาปของ Spazmatism แรงมากเมื่ออยู่ใกล้
				}

				Destroyer: {
					Short: บอสจักรกล: หนอนเหล็กยักษ์
					Summary: หนอนจักรกลยักษ์ที่แต่ละปล้องปล่อยโดรนและยิงเลเซอร์ เป็นหนึ่งในบอสจักรกลสามตัวที่ต้องชนะก่อนสู้ Plantera
					Summon: ใช้ [item:Terraria/MechanicalWorm] ตอนกลางคืน
					Unlocks: Soul of Might เมื่อรวมกับบอสจักรกลอีกสองตัว: Plantera, เครื่องมือขุด Chlorophyte และ Life Fruit
					UnlocksCal: Soul of Might ส่วนบอสจักรกลแต่ละตัวจะเพิ่มแร่ Hardmode ระดับถัดไป (ระบบปรับ Hardmode ช่วงต้นของ Calamity) และเมื่อชนะครบสามตัว: Plantera และแร่ Hallowed
					Requires: ต้องเป็น Hardmode
					Tips: • อาวุธที่ทะลุจะโดนหลายปล้องพร้อมกัน
				}

				SkeletronPrime: {
					Short: บอสจักรกล: Skeletron ติดอาวุธ
					Summary: Skeletron เวอร์ชันจักรกลที่มีแขนอาวุธ 4 ข้าง เป็นหนึ่งในบอสจักรกลสามตัวที่ต้องชนะก่อนสู้ Plantera
					Summon: ใช้ [item:Terraria/MechanicalSkull] ตอนกลางคืน
					Unlocks: Soul of Fright เมื่อรวมกับบอสจักรกลอีกสองตัว: Plantera, เครื่องมือขุด Chlorophyte และ Life Fruit
					UnlocksCal: Soul of Fright ส่วนบอสจักรกลแต่ละตัวจะเพิ่มแร่ Hardmode ระดับถัดไป (ระบบปรับ Hardmode ช่วงต้นของ Calamity) และเมื่อชนะครบสามตัว: Plantera และแร่ Hallowed
					Requires: ต้องเป็น Hardmode
					Tips: • ทำลายแขนก่อนจะทำให้สู้กับหัวง่ายขึ้นมาก
				}

				Ogre: {
					Short: มินิบอสของ Old One's Army (ระดับ 2 และ 3)
					Summary: มินิบอสตัวใหญ่ของ Old One's Army ระดับ 2 และ 3 ปรากฏในระลอกที่ 7 ของระดับ 2 และระลอกที่ 4 กับ 6 ของระดับ 3
					Requires: Old One's Army ระดับ 2 เปิดหลังชนะบอสจักรกลตัวใดก็ได้
				}

				SolarEclipse: {
					Name: Solar Eclipse
					Short: มอนสเตอร์หนังสยองขวัญตอนกลางวัน
					Summary: อีเวนต์กลางวันที่เต็มไปด้วยมอนสเตอร์จากหนังสยองขวัญ Mothron จะปรากฏหลังชนะ Plantera
					Summon: ใช้ [item:Terraria/SolarTablet] ตอนกลางวัน หรืออาจเกิดเองตอนรุ่งเช้า (โอกาส 1 ใน 20) หลังชนะบอสจักรกล
					Requires: ต้องชนะบอสจักรกลตัวใดก็ได้ก่อน
					TipsCal: • หลังชนะ Devourer of Gods ศัตรูใน Eclipse จะดรอป Darksun Fragment ด้วย
				}

				Plantera: {
					Short: บอสพืชแห่ง Jungle เปิดทางสู่วิหาร
					Summary: พืชยักษ์ที่หยั่งรากใน Jungle ใต้ดิน ยิงเมล็ดและลูกหนาม ในเฟสที่สองจะพุ่งกัดอย่างรุนแรง ชนะแล้วจะเปิดทางสู่ Jungle Temple
					Summon: ทุบ Plantera's Bulb ใน Jungle ใต้ดิน ดอกนี้จะงอกหลังชนะบอสจักรกลครบทั้งสามตัว
					SummonCal: ทุบ Plantera's Bulb ใน Jungle ใต้ดิน ดอกนี้จะงอกหลังชนะบอสจักรกลครบทั้งสามตัว ส่วน [item:CalamityMod/Portabulb] ของ Calamity ใช้เรียกซ้ำได้ใน Jungle
					Unlocks: Temple Key สำหรับเข้า Jungle Temple (Golem), Dungeon ที่อัปเกรดแล้ว, Pumpkin Moon และ Frost Moon รวมถึงเนื้อหา Hardmode ช่วงท้ายอีกมาก
					UnlocksCal: Temple Key สำหรับเข้า Jungle Temple (Golem) และเนื้อหา Hardmode ช่วงท้าย ส่วน Calamity เพิ่มแร่ Perennial ใต้ดินและ Great Sand Shark
					Requires: ต้องชนะบอสจักรกลครบทั้งสามตัวก่อน
					Tips:
						'''
						• ถางพื้นที่ใน Jungle ใต้ดินให้กว้างและวางแพลตฟอร์มก่อนทุบดอก
						• ถ้าออกจาก Jungle ระหว่างสู้ เธอจะคลั่ง
						'''
				}

				Golem: {
					Short: โกเลม Lihzahrd แห่ง Jungle Temple
					Summary: โกเลมหินที่ Lihzahrd สร้างขึ้น หัวของมันจะแยกออกในเฟสที่สอง ชนะแล้ว Lunatic Cultist จะปรากฏได้
					Summon: ใช้ [item:Terraria/LihzahrdPowerCell] กับ Lihzahrd Altar ในส่วนลึกของ Jungle Temple
					Unlocks: Lunatic Cultist และพวกลัทธิที่หน้าทางเข้า Dungeon, Martian Probe และ Old One's Army ระดับ 3
					UnlocksCal: Lunatic Cultist ที่หน้าทางเข้า Dungeon, Martian Probe และ Old One's Army ระดับ 3 ส่วน Calamity เพิ่มโรคระบาดใน Jungle และ Plaguebringer Goliath
					Requires: Temple Key ดรอปจาก Plantera
					Tips: • เคลียร์กับดักรอบห้องแท่นบูชาก่อนสู้
				}

				PumpkinMoon: {
					Name: Pumpkin Moon
					Short: อีเวนต์ฮาโลวีนแบบระลอกตอนกลางคืน
					Summary: อีเวนต์ตอนกลางคืนแบบระลอก สะสมแต้มจากการกำจัดศัตรูเพื่อไปถึงระลอกหลังที่มี Mourning Wood และ Pumpking
					Summon: ใช้ [item:Terraria/PumpkinMoonMedallion] ตอนกลางคืน อีเวนต์จะอยู่จนถึงรุ่งเช้า
					Requires: การคราฟต์เหรียญต้องใช้ Ectoplasm ซึ่งดรอปหลังชนะ Plantera
					Tips:
						'''
						• เริ่มทันทีเมื่อค่ำเพื่อให้ได้ระลอกมากที่สุด
						• สร้างสนามที่มีแพลตฟอร์มหลายชั้นใกล้ฐาน
						'''
					TipsCal:
						'''
						• เริ่มทันทีเมื่อค่ำเพื่อให้ได้ระลอกมากที่สุด
						• หลังชนะ Devourer of Gods ศัตรูในอีเวนต์นี้จะดรอป Nightmare Fuel ด้วย
						'''
				}

				MourningWood: {
					Short: มินิบอสของ Pumpkin Moon (ระลอก 4 ขึ้นไป)
					Summary: ต้นไม้ผีสิงที่ปรากฏตั้งแต่ระลอกที่ 4 ของ Pumpkin Moon
				}

				Pumpking: {
					Short: มินิบอสของ Pumpkin Moon (ระลอก 7 ขึ้นไป)
					Summary: ราชาฟักทองที่ปรากฏตั้งแต่ระลอกที่ 7 ของ Pumpkin Moon
				}

				FrostMoon: {
					Name: Frost Moon
					Short: อีเวนต์คริสต์มาสแบบระลอกตอนกลางคืน
					Summary: อีเวนต์ตอนกลางคืนแบบระลอก ระลอกหลังจะมี Everscream, Santa-NK1 และ Ice Queen
					Summon: ใช้ [item:Terraria/NaughtyPresent] ตอนกลางคืน อีเวนต์จะอยู่จนถึงรุ่งเช้า
					Requires: การคราฟต์ Naughty Present ต้องใช้ Ectoplasm ซึ่งดรอปหลังชนะ Plantera
					Tips: • เริ่มทันทีเมื่อค่ำเพื่อให้ได้ระลอกมากที่สุด
					TipsCal:
						'''
						• เริ่มทันทีเมื่อค่ำเพื่อให้ได้ระลอกมากที่สุด
						• หลังชนะ Devourer of Gods ศัตรูในอีเวนต์นี้จะดรอป Endothermic Energy ด้วย
						'''
				}

				Everscream: {
					Short: มินิบอสของ Frost Moon (ระลอก 4 ขึ้นไป)
					Summary: ต้นคริสต์มาสชั่วร้ายที่ปรากฏตั้งแต่ระลอกที่ 4 ของ Frost Moon
				}

				SantaNK1: {
					Short: มินิบอสของ Frost Moon (ระลอก 7 ขึ้นไป)
					Summary: หุ่นยนต์ซานต้าแบบรถถังที่ปรากฏตั้งแต่ระลอกที่ 7 ของ Frost Moon
				}

				IceQueen: {
					Short: มินิบอสของ Frost Moon (ระลอก 11 ขึ้นไป)
					Summary: ราชินีน้ำแข็งบินได้ที่ปรากฏตั้งแต่ระลอกที่ 11 ของ Frost Moon
				}

				MartianMadness: {
					Name: Martian Madness
					Short: เอเลี่ยนบุกหลัง Golem
					Summary: การบุกของเอเลี่ยนที่นำโดย Martian Saucer ของที่ดรอปมีอาวุธแรงและพาหนะ
					Summon: หลังชนะ Golem อาจมี Martian Probe ปรากฏเหนือพื้นดิน ถ้ามันเห็นคุณแล้วบินหนีกลับไปได้ อีเวนต์จะเริ่ม
					Requires: ต้องชนะ Golem ก่อน
					Tips: • ถ้ายังไม่พร้อม ให้กำจัด Probe ก่อนที่มันจะหนีไป
				}

				MartianSaucer: {
					Short: มินิบอสของ Martian Madness
					Summary: จานบินพร้อมป้อมปืนที่ปรากฏระหว่าง Martian Madness
				}

				DukeFishron: {
					Short: บอสทะเลที่ตกได้ด้วย Truffle Worm
					Summary: หมูผสมฉลามกลายพันธุ์ที่พุ่งเร็วมากและสร้างพายุฉลาม ไม่บังคับแต่ดรอปอุปกรณ์ดีมาก
					Summon: ตกปลาในทะเลโดยใช้ [item:Terraria/TruffleWorm] เป็นเหยื่อ ส่วน Truffle Worm จับได้ในไบโอม Glowing Mushroom ใต้ดินช่วง Hardmode
					Requires: ต้องเป็น Hardmode
					Warning: ถ้าออกจากทะเลระหว่างสู้ มันจะคลั่ง
				}

				EmpressOfLight: {
					Short: จักรพรรดินีภูตแห่ง Hallow ไม่บังคับ
					Summary: จักรพรรดินีภูตผู้เจิดจ้าที่ยิงกระสุนหนาแน่น ไม่บังคับแต่ดรอปของระดับสูง สู้ตอนกลางวันจะอันตรายกว่ามาก
					Summon: กำจัด [item:Terraria/EmpressButterfly] (Prismatic Lacewing) ใน Hallow บนผิวดินตอนกลางคืนหลังชนะ Plantera
					Requires: ต้องชนะ Plantera ก่อน
					Warning: ถ้าพระอาทิตย์ขึ้นระหว่างสู้ การโจมตีของเธอแทบจะทำให้ตายในทีเดียว
				}

				Betsy: {
					Short: บอสสุดท้ายของ Old One's Army (ระดับ 3)
					Summary: มังกรพ่นไฟที่ปรากฏในระลอกสุดท้าย (ที่ 7) ของ Old One's Army ระดับ 3
					Summon: เริ่ม Old One's Army ระดับ 3 (ใช้ [item:Terraria/DD2ElderCrystal] กับแท่น) แล้วไปให้ถึงระลอกที่ 7
					Requires: Old One's Army ระดับ 3 เปิดหลังชนะ Golem
				}

				LunaticCultist: {
					Short: ผู้นำลัทธิที่ Dungeon เริ่มอีเวนต์เสา
					Summary: ผู้นำลัทธิที่หน้าทางเข้า Dungeon ชนะแล้วจะเริ่มอีเวนต์ Celestial Pillars
					Summon: หลังชนะ Golem จะมีสาวกลัทธิ 4 คนบูชาอยู่หน้า Dungeon โจมตีพวกเขาเพื่อเริ่มการต่อสู้
					SummonCal: หลังชนะ Golem จะมีสาวกลัทธิ 4 คนบูชาอยู่หน้า Dungeon โจมตีพวกเขาเพื่อเริ่มการต่อสู้ หรือใช้ [item:CalamityMod/EidolonTablet] ของ Calamity เรียกได้เช่นกัน
					Unlocks: Celestial Pillar จะปรากฏทั่วโลก
					Requires: ต้องชนะ Golem ก่อน
					Tips: • ระหว่างทำพิธีเขาจะซ่อนตัวปนกับร่างโคลน รีบหาตัวจริงให้เจอ
				}

				CelestialPillars: {
					Name: Celestial Pillars
					Short: ทำลายหอคอยดวงจันทร์ทั้ง 4
					Summary: หอคอยดวงจันทร์ 4 ต้น (Solar, Vortex, Nebula, Stardust) มีโล่ป้องกันจนกว่าจะกำจัดศัตรูรอบ ๆ ได้ครบ ทำลายครบทั้ง 4 ต้นจะเรียก Moon Lord
					Summon: เสาจะปรากฏเมื่อชนะ Lunatic Cultist
					Unlocks: เศษชิ้นส่วนดวงจันทร์สำหรับอุปกรณ์ช่วงท้าย และ Moon Lord
					Requires: ต้องชนะ Lunatic Cultist ก่อน
				}

				MoonLord: {
					Short: บอสสุดท้ายของ Terraria
					Summary: บอสสุดท้ายของ Terraria ต้องทำลายมือทั้งสองข้างและหัวก่อน แกนกลางจึงจะโดนดาเมจได้
					Summon: จะมาหลังทำลาย Celestial Pillar ครบ 4 ต้นไม่นาน หลังจากนั้นใช้ [item:Terraria/CelestialSigil] เรียกซ้ำได้
					Unlocks: แร่ Luminite และอุปกรณ์ที่ดีที่สุดของเกมหลัก
					UnlocksCal: แร่ Luminite และอุปกรณ์ที่ดีที่สุดของเกมหลัก แต่ใน Calamity นี่เพิ่งครึ่งทาง: Profaned Guardians, Providence และเส้นทางหลัง Moon Lord จะเปิดขึ้น
					Requires: ทำลาย Celestial Pillar ทั้ง 4 ต้น
					Warning: ถ้าเปิดม็อด Catalyst อยู่ Astral Communicator จะใช้ไม่ได้หลังชนะ Moon Lord หากยังไม่เคยชนะ Astrageldon
					Tips: • ลำแสงจากดวงตาและ Phantasmal Deathray แรงมาก เคลื่อนที่ตลอดและเตรียมยาฟื้นพลังให้พอ
				}

				DesertScourge: {
					Short: หนอนทะเลทราย บอสแรกของ Calamity
					Summary: หนอนยักษ์แห่งทะเลทรายและบอสตัวแรกของ Calamity ชนะแล้ว Giant Clam จะเริ่มปรากฏใน Sunken Sea
					Summon: ใช้ [item:CalamityMod/DesertMedallion] ในทะเลทราย เหรียญไม่หายเมื่อใช้
					Unlocks: Giant Clam ใน Sunken Sea และพายุทราย ส่วน Sea King จะย้ายเข้ามาได้เมื่อชนะทั้งบอสนี้และ Giant Clam
					Tips: • สู้ในทะเลทรายโล่ง ๆ และสร้างสะพานแพลตฟอร์มเหนือพื้นทราย
				}

				GiantClam: {
					Short: มินิบอสของ Sunken Sea
					Summary: หอยยักษ์ที่อาศัยในน้ำของ Sunken Sea ใต้ทะเลทราย
					Summon: เกิดเองในน้ำของ Sunken Sea หลังชนะ Desert Scourge
					Requires: ต้องชนะ Desert Scourge ก่อน
				}

				AcidRain1: {
					Name: Acid Rain
					Short: พายุพิษที่ Sulphurous Sea
					Summary: อีเวนต์ของ Sulphurous Sea ใน Calamity ศัตรูกรดและสัตว์กลายพันธุ์จากรังสีจะโจมตี ระดับแรกดรอปวัตถุดิบช่วงต้น
					Summon: หลังชนะ Eye of Cthulhu แล้ว Acid Rain ครั้งแรกจะเริ่มเมื่อคุณเข้าไปใน Sulphurous Sea ส่วนครั้งต่อไปจะเริ่มเองตอนกลางคืน หรือใช้ [item:CalamityMod/CausticTear]
					Requires: ต้องชนะ Eye of Cthulhu ก่อน
					Warning: Caustic Tear ที่ใช้ก่อนชนะ Eye of Cthulhu (หรือก่อน Hardmode) จะหายไปโดยไม่เริ่มอีเวนต์
					Tips:
						'''
						• อีเวนต์จะล้มเหลวถ้าฝนหยุด หรือไม่ได้กำจัดศัตรูของ Acid Rain เลย 2.5 นาที
						• น้ำของ Sulphurous Sea มีพิษ ช่วงต้นอย่าว่ายน้ำนาน
						'''
				}

				Crabulon: {
					Short: บอสปูเห็ด
					Summary: ปูยักษ์ที่ปกคลุมด้วยเห็ดเรืองแสง จากไบโอม Glowing Mushroom ใต้ดิน
					Summon: ใช้ [item:CalamityMod/DecapoditaSprout] ในไบโอม Glowing Mushroom ใต้ดิน ไอเทมไม่หายเมื่อใช้
					Unlocks: ในโหมด Revengeance ถุงของมันมี [item:CalamityMod/MushroomPlasmaRoot] (Rage อยู่นานขึ้น)
					Tips: • ขุดพื้นที่ในไบโอมเห็ดให้กว้างก่อนเรียก เพราะมันกระโดดบ่อย
				}

				HiveMind: {
					Short: บอส Corruption ของ Calamity
					Summary: บอสแห่ง Corruption ของ Calamity การชนะครั้งแรก (หรือชนะ Perforators) ทำให้ขุดแร่ Aerialite บนฟ้าได้
					Summon: ทำลาย Hive Tumor ใน Corruption หรือใช้ [item:CalamityMod/Teratoma] ใน Corruption
					Unlocks: ขุดแร่ Aerialite บนเกาะลอยฟ้าได้แล้ว (Pickaxe พลัง 65%)
					Warning: การทำลาย Hive Tumor จะเรียกบอสทันที ระวังอย่าทำลายโดยไม่ตั้งใจ
				}

				Perforators: {
					Name: The Perforators
					Short: บอส Crimson ของ Calamity
					Summary: รังของ Crimson ที่ปล่อยหนอนสามขนาดออกมา การชนะครั้งแรก (หรือชนะ Hive Mind) ทำให้ขุดแร่ Aerialite บนฟ้าได้
					Summon: ทำลาย Perforator Cyst ใน Crimson หรือใช้ [item:CalamityMod/BloodyWormFood] ใน Crimson
					Unlocks: ขุดแร่ Aerialite บนเกาะลอยฟ้าได้แล้ว (Pickaxe พลัง 65%)
					Warning: การทำลาย Perforator Cyst จะเรียกบอสทันที ระวังอย่าทำลายโดยไม่ตั้งใจ
				}

				SlimeGod: {
					Short: สไลม์ยักษ์สองตัวกับแกนกลาง
					Summary: แกนสไลม์ที่มีสไลม์ Paladin ยักษ์สองตัว (Corruption และ Crimson) ซึ่งแยกร่างเมื่อโดนดาเมจ
					Summon: ใช้ [item:CalamityMod/OverloadedSludge] ที่ไหนก็ได้
					Unlocks: ในโหมด Revengeance ถุงของมันมี [item:CalamityMod/ElectrolyteGelPack] (Adrenaline แรงขึ้น)
					Tips: • สไลม์ใหญ่จะแยกเป็นตัวเล็กเมื่อโดนดาเมจ อาวุธโจมตีเป็นวงช่วยได้มาก
				}

				Cryogen: {
					Short: บอสผลึกน้ำแข็งแห่งไบโอมหิมะ
					Summary: ผลึกน้ำแข็งที่ยิงน้ำแข็งหลายรูปแบบ ชนะแล้วแร่ Cryonic จะขุดได้ และ Permafrost (Archmage) ย้ายเข้ามาได้
					Summon: ใช้ [item:CalamityMod/CryoKey] ในไบโอมหิมะ
					Unlocks: แร่ Cryonic ในถ้ำน้ำแข็ง และ Archmage (Permafrost) ย้ายเข้ามาได้
					Requires: ต้องเป็น Hardmode
				}

				AquaticScourge: {
					Short: หนอนแห่ง Sulphurous Sea ทำให้ Acid Rain แรงขึ้น
					Summary: หนอนทะเลยักษ์แห่ง Sulphurous Sea ชนะแล้ว Acid Rain จะอัปเกรดเป็นระดับที่สอง
					Summon: ใช้ [item:CalamityMod/Seafood] ใน Sulphurous Sea หรือรอให้มันปรากฏเองที่นั่น
					Unlocks: Acid Rain ระดับ 2 ที่มี Cragmaw Mire และของดรอปใหม่
					Requires: ต้องเป็น Hardmode
				}

				AcidRain2: {
					Name: Acid Rain (ระดับ 2)
					Short: Acid Rain ระดับ 2 (หลัง Aquatic Scourge)
					Summary: Acid Rain ระดับที่สอง ศัตรูแรงขึ้นและมี Cragmaw Mire
					Summon: เริ่มเองตอนกลางคืน หรือใช้ [item:CalamityMod/CausticTear] หลังชนะ Aquatic Scourge
					Requires: ต้องชนะ Aquatic Scourge ก่อน
				}

				CragmawMire: {
					Short: มินิบอสของ Acid Rain (ระดับ 2 ขึ้นไป)
					Summary: มินิบอสปูกลายพันธุ์ที่ปรากฏใน Acid Rain หลังชนะ Aquatic Scourge
				}

				BrimstoneElemental: {
					Short: ธาตุไฟแห่ง Brimstone Crag
					Summary: วิญญาณธาตุไฟ Brimstone จาก Brimstone Crag ใน Underworld
					Summon: ใช้ [item:CalamityMod/CharredIdol] ใน Brimstone Crag
					Requires: ต้องเป็น Hardmode
				}

				CalamitasClone: {
					Short: ร่างโคลนแม่มด Brimstone ทดสอบอุปกรณ์
					Summary: ร่างโคลนของแม่มด Calamitas พร้อมพี่น้องอีกสองตัว เป็นบททดสอบที่ดีก่อนสู้ Plantera
					Summon: ใช้ [item:CalamityMod/EyeofDesolation]
					Unlocks: Ashes of Calamity ซึ่งภายหลังใช้เรียก Supreme Calamitas
					Requires: ต้องเป็น Hardmode
				}

				GreatSandShark: {
					Short: มินิบอสฉลามทรายหลัง Plantera
					Summary: ฉลามยักษ์ที่ว่ายผ่านทราย พบในทะเลทราย
					Summon: กำจัด Sand Shark ครบ 10 ตัวหลังชนะ Plantera หรือใช้ [item:CalamityMod/SandstormsCore] ในทะเลทราย
					Requires: ต้องชนะ Plantera ก่อน
				}

				Leviathan: {
					Name: Leviathan และ Anahita
					Short: คู่บอสทะเล: Anahita และ Leviathan
					Summary: Anahita นางไซเรนจะสู้ก่อน แล้ว Leviathan จะมาร่วมภายหลัง ชนะแล้วจะปลดล็อกของดรอปใหม่ใน Abyss
					Summon: กำจัดนักร้องลึกลับที่บางครั้งปรากฏในทะเล หรือใช้ [item:CalamityMod/NaiadsWarhorn] ในทะเล แตรต้องใช้ Lumenyl ซึ่งดรอปหลังชนะบอสนี้เท่านั้น ครั้งแรกจึงต้องเรียกผ่านนักร้อง
					Unlocks: Lumenyl และของดรอปอื่นใน Abyss
					Warning: นักร้องอาจปรากฏในทะเลได้ตั้งแต่ก่อน Hardmode ถ้ากำจัดเร็วเกินไปจะเรียก Anahita ออกมา
					Requires: นักร้องจะปรากฏบ่อยขึ้นมากหลังชนะ Plantera หรือ Calamitas Clone
				}

				AstrumAureus: {
					Short: หุ่นเดินแห่งดวงดาว ทำให้อุกกาบาต Astral ตกอีก
					Summary: หุ่นเดินยักษ์จาก Astral Infection ชนะแล้วจะมีอุกกาบาต Astral ตกอีกลูกและศัตรู Astral จะแรงขึ้น
					Summon: ใช้ [item:CalamityMod/AstralChunk] ใน Astral Infection
					Unlocks: ในโหมด Revengeance ถุงของมันมี [item:CalamityMod/StarlightFuelCell] (Adrenaline แรงขึ้น)
					Requires: Astral Chunk ต้องใช้แบบพิมพ์เขียวที่ถอดรหัสแล้วจากห้องแล็บบน Planetoid ใหญ่บนฟ้า
				}

				PlaguebringerGoliath: {
					Short: ผึ้งจักรกลแห่งโรคระบาดใน Jungle
					Summary: ผึ้งจักรกลยักษ์ที่แพร่โรคระบาด สู้ใน Jungle หลังชนะ Golem
					Summon: ใช้ [item:CalamityMod/Abombination] ใน Jungle
					Requires: Abombination ต้องใช้ Plague Cell Canister (จากศัตรูโรคระบาดหลัง Golem) และแบบพิมพ์เขียวที่ถอดรหัสจากห้องแล็บใน Jungle
				}

				Ravager: {
					Short: โกเลมเนื้อหนังจากหินและกระดูก
					Summary: โกเลมเนื้อหนังยักษ์ที่แขนขาแยกออกได้
					Summon: ใช้ [item:CalamityMod/DeathWhistle]
					Unlocks: ในโหมด Revengeance ถุงของมันมี [item:CalamityMod/InfernalBlood] (Rage อยู่นานขึ้น)
					Requires: นกหวีดต้องใช้ Lunar Tablet Fragment จากศัตรูใน Jungle Temple (หลัง Plantera)
				}

				AstrumDeus: {
					Short: หนอนดวงดาว ปลดล็อกแร่ Astral
					Summary: หนอนจักรวาลแห่ง Astral Infection ที่แยกเป็นสองตัว ชนะแล้วจะขุดแร่ Astral ได้
					Summon: ถวาย [item:CalamityMod/TitanHeart] หรือ [item:CalamityMod/Starcore] ที่ [item:CalamityMod/AstralBeaconItem] (มีแท่นตั้งอยู่ใน Astral Infection ด้วย)
					Unlocks: ขุดแร่ Astral ได้
					Requires: แนะนำให้สู้หลัง Lunatic Cultist ส่วน Titan Heart ดรอปจาก Atlas ศัตรูของ Astral Infection บนผิวดิน
				}

				ProfanedGuardians: {
					Name: Profaned Guardians
					Short: ผู้พิทักษ์เปลวไฟศักดิ์สิทธิ์สามตน
					Summary: ผู้พิทักษ์ของ Providence สามตน: ฝ่ายโจมตี ฝ่ายป้องกัน และฝ่ายรักษา ชนะแล้วจะได้ Profaned Core
					Summon: ใช้ [item:CalamityMod/ProfanedShard] ใน Hallow หรือใน Underworld
					Unlocks: "[item:CalamityMod/ProfanedCore] สำหรับเรียก Providence"
					Requires: ต้องชนะ Moon Lord ก่อน
				}

				Dragonfolly: {
					Short: นกสายฟ้าแห่ง Jungle
					Summary: นกไฟฟ้ายักษ์แห่ง Jungle ส่วน Effulgent Feather ของมันใช้ทำไข่สำหรับเรียก Yharon
					Summon: ใช้ [item:CalamityMod/ExoticPheromones] ใน Jungle
					Unlocks: Effulgent Feather สำหรับไข่ Yharon และในโหมด Revengeance ถุงของมันมี [item:CalamityMod/RedLightningContainer] (Rage อยู่นานขึ้น)
					Requires: ต้องชนะ Moon Lord ก่อน
				}

				Providence: {
					Short: เทพีแห่งเปลวไฟศักดิ์สิทธิ์
					Summary: เทพีแห่งเปลวไฟศักดิ์สิทธิ์ ชนะแล้วแร่ Uelibloom จะเกิดและสู้ Sentinel ได้
					Summon: ใช้ [item:CalamityMod/ProfanedCore] ใน Hallow หรือใน Underworld
					Unlocks: แร่ Uelibloom ใน Jungle และ Mark of Providence สำหรับเรียก Sentinel
					Requires: Profaned Core ดรอปจาก Profaned Guardians
				}

				CeaselessVoid: {
					Short: Sentinel แห่ง Dungeon
					Summary: หนึ่งใน Sentinel สามตนของ Devourer: ความว่างเปล่าที่ดูดคุณเข้าไป สู้ใน Dungeon
					Summon: ใช้ [item:CalamityMod/MarkofProvidence] ใน Dungeon
					Requires: ต้องชนะ Moon Lord ก่อน ส่วน Mark of Providence ดรอปจาก Providence หรือคราฟต์ได้
				}

				StormWeaver: {
					Short: Sentinel แห่งอวกาศ
					Summary: หนึ่งใน Sentinel สามตนของ Devourer: หนอนพายุหุ้มเกราะ สู้บนท้องฟ้าสูงหรือในอวกาศ
					Summon: ใช้ [item:CalamityMod/MarkofProvidence] บนท้องฟ้าสูงหรือในอวกาศ
					Requires: ต้องชนะ Moon Lord ก่อน ส่วน Mark of Providence ดรอปจาก Providence หรือคราฟต์ได้
				}

				Signus: {
					Short: Sentinel แห่ง Underworld
					Summary: หนึ่งใน Sentinel สามตนของ Devourer: นักฆ่าที่วาร์ปได้ สู้ใน Underworld
					Summon: ใช้ [item:CalamityMod/MarkofProvidence] ใน Underworld
					Requires: ต้องชนะ Moon Lord ก่อน ส่วน Mark of Providence ดรอปจาก Providence หรือคราฟต์ได้
				}

				Polterghast: {
					Short: ผีแห่ง Dungeon ปลดล็อก Acid Rain ระดับสุดท้าย
					Summary: กลุ่มวิญญาณที่ไม่สงบซึ่งหลอกหลอน Dungeon ชนะแล้ว Acid Rain ระดับสุดท้ายจะเริ่มได้
					Summon: กำจัด Phantom Spirit ครบ 30 ตัว (ศัตรูตัวแกร่งใน Dungeon ปล่อยออกมาหลัง Moon Lord) หรือใช้ [item:CalamityMod/NecroplasmicBeacon] ใน Dungeon
					Unlocks: Acid Rain ระดับ 3 (Mauler, Nuclear Terror และ Old Duke) และในโหมด Revengeance ถุงของมันมี [item:CalamityMod/Ectoheart]
					Requires: ต้องชนะ Moon Lord ก่อน
					Tips: • จำนวน Phantom Spirit ที่กำจัดจะรีเซ็ตเมื่อออกจากโลก
				}

				AcidRain3: {
					Name: Acid Rain (ระดับ 3)
					Short: Acid Rain ระดับสุดท้าย จบด้วย Old Duke
					Summary: Acid Rain ระดับสุดท้าย มี Mauler และ Nuclear Terror ทำอีเวนต์ให้ครบจะเรียก Old Duke
					Summon: เริ่มเองตอนกลางคืน หรือใช้ [item:CalamityMod/CausticTear] หลังชนะ Polterghast
					Requires: ต้องชนะ Polterghast ก่อน
				}

				Mauler: {
					Short: มินิบอสของ Acid Rain (ระดับ 3)
					Summary: มินิบอสฉลามกลายพันธุ์ของ Acid Rain ระดับสุดท้าย
				}

				NuclearTerror: {
					Short: มินิบอสของ Acid Rain (ระดับ 3)
					Summary: มินิบอสกัมมันตรังสีของ Acid Rain ระดับสุดท้าย
				}

				OldDuke: {
					Short: Duke Fishron กลายพันธุ์
					Summary: Duke Fishron ที่เน่าเปื่อยและปนเปื้อนรังสีจาก Sulphurous Sea
					Summon: ทำ Acid Rain ระดับ 3 ให้ครบ หรือตกปลาใน Sulphurous Sea โดยใช้ [item:CalamityMod/BloodwormItem] เป็นเหยื่อ (Sea King ขายหลังชนะครั้งแรก)
					Requires: ต้องชนะ Polterghast ก่อน
				}

				DevourerOfGods: {
					Short: งูยักษ์แห่งจักรวาล
					Summary: งูจักรวาลผู้กลืนกินเทพเจ้า ชนะแล้ว Pumpkin Moon, Frost Moon และ Solar Eclipse จะดรอปวัตถุดิบใหม่
					Summon: ใช้ [item:CalamityMod/CosmicWorm] ซึ่งคราฟต์ได้จากของดรอปของ Sentinel ทั้งสาม หรือจาก Luminite, เศษชิ้นส่วนดวงจันทร์, Meld Blob และ Necroplasm
					Unlocks: Nightmare Fuel, Endothermic Energy และ Darksun Fragment จากอีเวนต์ดวงจันทร์และ Eclipse
					Requires: ต้องชนะ Moon Lord ก่อน
					Tips: • ท่าโจมตีเร็วมาก ต้องมีแดชและการบินที่ดี
				}

				Yharon: {
					Short: มังกรแห่งการเกิดใหม่ ปลดล็อกแร่ Auric
					Summary: มังกรแห่ง Jungle นามว่า Yharon ชนะแล้วแร่ Auric จะเกิด ซึ่งจำเป็นสำหรับบอสสุดท้าย
					Summon: ใช้ [item:CalamityMod/YharonEgg]
					Unlocks: แร่ Auric ในถ้ำ และวัตถุดิบสำหรับ Exo Mechs และ Supreme Calamitas
					Requires: ไข่ต้องใช้ Effulgent Feather จาก Dragonfolly
				}

				ExoMechs: {
					Name: Exo Mechs
					Short: เครื่องจักรสงครามสามตัวของ Draedon
					Summary: เครื่องจักรสุดท้ายของ Draedon: Thanatos, Ares และแฝด Artemis กับ Apollo คุณเลือกได้ว่าจะสู้ตัวไหนก่อน
					Summon: อัปเกรด Codebreaker ให้ครบ ใส่ [item:CalamityMod/AuricQuantumCoolingCell] แล้วติดต่อ Draedon
					Requires: ต้องชนะ Yharon ก่อน เพราะ Cooling Cell ต้องใช้ Auric Bar
					Tips: • ดูวิธีอัปเกรด Codebreaker ได้ในคู่มือห้องแล็บของ Draedon
				}

				SupremeCalamitas: {
					Short: แม่มด Brimstone ตัวจริง
					Summary: Supreme Witch, Calamitas: หนึ่งในบอสสุดท้ายสองตัวของ Calamity ชนะแล้วแม่มด Brimstone จะย้ายเข้ามาอยู่ได้
					Summon: ถวาย [item:CalamityMod/AshesofCalamity] (หรือ [item:CalamityMod/CeremonialUrn] สำหรับการสู้ครั้งต่อไป) ที่ [item:CalamityMod/AltarOfTheAccursedItem]
					Unlocks: Brimstone Witch (Calamitas) เป็น NPC ในเมือง เธอเสริมเวทมนตร์ให้ไอเทมได้
					Requires: Altar of the Accursed ต้องใช้ Auric Bar (หลัง Yharon)
				}

				PrimordialWyrm: {
					Short: งูโบราณแห่งก้น Abyss
					Summary: งูโบราณที่อาศัยในชั้นลึกที่สุดของ Abyss จะคลั่งเมื่ออยู่นอกชั้นนั้น
					Summon: มันจะปรากฏเมื่อมีผู้เล่นใน Abyss ติดสถานะ Chaos State เช่น วาร์ปด้วย Rod of Discord และถ้าเปิด Infernum จะเรียกด้วย Evoking Searune ในชั้นลึกสุดได้ด้วย
					Unlocks: ดรอป [item:CalamityMod/Terminus]
					Warning: เรื่องนี้เกิดได้ทุกช่วงของเกม ถ้าวาร์ปใน Abyss เร็วเกินไปจะต้องเจอบอสที่ยังสู้ไม่ได้
				}

				BossRush: {
					Name: Boss Rush
					Short: สู้บอสทุกตัวต่อเนื่องกัน
					Summary: ความท้าทายสุดขีด: สู้บอสทุกตัวตามลำดับโดยเสริมพลังอย่างมาก และไม่มีช่วงพัก
					Summon: ใช้ [item:CalamityMod/Terminus] (กดค้างเพื่อร่าย) ใช้ได้ทุกเวลา และใช้อีกครั้งเพื่อหยุด
					Warning: บอสใน Boss Rush แข็งแกร่งกว่าปกติมาก เริ่มเมื่อพร้อมจริง ๆ เท่านั้น
				}

				Astrageldon: {
					Short: สไลม์ดวงดาว ต้องชนะก่อน Moon Lord
					Summary: สไลม์ดวงดาวยักษ์จากม็อด Catalyst
					Summon: ใช้ [item:CatalystMod/AstralCommunicator] บนผิวดินของ Astral Infection อุปกรณ์นี้ไม่หายเมื่อใช้ และได้จากการกำจัด Ascended Astral Slime
					Warning: ต้องชนะ Astrageldon ก่อน Moon Lord เพราะหลังจากนั้น Astral Communicator จะใช้ไม่ได้ ถ้ายังไม่เคยชนะ Astrageldon
					Requires: ถ้าชนะ Moon Lord ก่อน Astrageldon ไปแล้ว จะเรียกมันในโลกนี้ไม่ได้อีก
				}

				Dreadnautilus: {
					Short: บอสหอยงวงแห่ง Blood Moon (Infernum)
					Summary: Infernum เปลี่ยน Dreadnautilus ของ Blood Moon ให้เป็นบอสเต็มตัว
					Summon: ใช้ [item:InfernumMode/RedBait] ตอนกลางคืน (ไม่หายเมื่อใช้) หรือตกขึ้นมาระหว่าง Blood Moon
					Requires: ต้องเป็น Hardmode และเปิด Infernum
				}

				BereftVassal: {
					Short: บอสนักรบแห่งทะเลทรายของ Infernum
					Summary: บอสใหม่จาก Infernum: นักรบผู้โดดเดี่ยวที่สู้พร้อม Great Sand Shark ใจกลางทะเลทราย
					Summon: ใช้ [item:CalamityMod/SandstormsCore] ที่แท่นใจกลางทะเลทราย
					Requires: ต้องชนะ Lunatic Cultist ก่อน และเปิด Infernum
				}

				Goozma: {
					Short: เทพสไลม์แห่ง Hunt of the Old God
					Summary: Goozma เทพสไลม์โบราณ เป็นการต่อสู้ที่ยากมากซึ่งออกแบบไว้สำหรับช่วงท้ายเกม แม้จะเรียกได้ตั้งแต่ Hardmode
					Summon: โยน [item:CalamityMod/OverloadedSludge] ใส่ King Slime ระหว่าง Slime Rain หรือใช้ [item:CalamityHunt/PluripotentSpawnEgg] กับ Slime Ninja Statue ที่ถูกเสริมพลัง
					Unlocks: "[item:CalamityHunt/GoozmaSoul]: เดินไปแตะเพื่อดูดซับรับค่าสถานะถาวร (ดูในแท็บอัปเกรดถาวร) และถ้าเปิดตัวเลือก Shadowspec Curse ของ Hunt ไว้ (ค่าเริ่มต้น) ไอเทมที่คราฟต์จาก Shadowspec Bar จะใช้ได้หลังชนะ Goozma แล้วเท่านั้น"
					Requires: ต้องเป็น Hardmode
					Warning: บอสนี้ปรับสมดุลไว้สำหรับช่วงท้ายเกม ถ้าเรียกมาสู้เร็วเกินไปจะเสียเปรียบมาก
				}

				SolynMeet: {
					Name: พบกับ Solyn
					Short: Wrath of the Gods: พบนักเดินทางแห่งดวงดาว
					Summary: Solyn นักเดินทางจากดวงดาว คือจุดเริ่มต้นของเนื้อเรื่อง Wrath of the Gods
					Summon: หลังชนะ Skeletron (หรือเมื่อเข้า Hardmode) Solyn จะปรากฏในโลกของคุณได้ ตามหาเธอแล้วคุยจนบทแนะนำตัวจบ
					Requires: ต้องชนะ Skeletron ก่อน
				}

				SolynCamp: {
					Name: แคมป์ของ Solyn
					Short: เลือกที่ตั้งแคมป์ให้ Solyn
					Summary: Solyn อยากได้ที่ตั้งแคมป์ในโลกของคุณ
					Summon: คุยกับ Solyn เธอจะมอบ [item:NoxusBoss/StrangeFlagpole] ให้ วางบนพื้นเรียบที่โล่งเพื่อเลือกที่ตั้งแคมป์
					Requires: ต้องพบ Solyn ก่อน
				}

				SolynStargaze: {
					Name: ดูดาว
					Short: ซ่อมกล้องโทรทรรศน์แล้วดูดาวกับ Solyn
					Summary: Solyn อยากดูดาว เควสต์จบลงด้วยของขวัญ: [item:NoxusBoss/StarCharm]
					Summon: คุยกับ Solyn เรื่องดูดาว จากนั้นซ่อมกล้องโทรทรรศน์ที่แคมป์ด้วย Gold Bar หรือ Platinum Bar 10 แท่ง (แล้วแต่โลกของคุณมีแร่ชนิดไหน) และไม้ 15 ชิ้น แล้วคุยกับเธออีกครั้งเพื่อดูท้องฟ้า
					Requires: ต้องพบ Solyn ก่อน
				}

				PermafrostKeep: {
					Name: ป้อมปราการ Permafrost
					Short: สำรวจป้อมปราการน้ำแข็งกับ Solyn
					Summary: ป้อมปราการน้ำแข็งที่ซ่อนอยู่ในหิมะ Solyn จะไปสำรวจด้วยกัน
					Summon: หลังชนะ Cryogen แล้ว Permafrost จะมอบ [item:NoxusBoss/DormantKey] ให้เป็นการขอบคุณที่ปลดปล่อยเขา นำไปคุยกับ Solyn แล้วเปิดป้อมปราการไปพร้อมกับเธอ
					Requires: ทำเควสต์ดูดาวให้เสร็จและชนะ Cryogen
				}

				GenesisReveal: {
					Name: The Genesis
					Short: Solyn เล่าเรื่อง Genesis
					Summary: หลัง Moon Lord จะมีรอยแยกปรากฏบนท้องฟ้า Solyn จะอธิบายเรื่อง Genesis
					Summon: คุยกับ Solyn เมื่อรอยแยกปรากฏบนฟ้าหลังชนะ Moon Lord
					Requires: ทำเควสต์ Permafrost Keep ให้เสร็จและชนะ Moon Lord
				}

				Antiseed: {
					Name: The Antiseed
					Short: เข้าไปในรอยแยกกับ Solyn เพื่อรับ Antiseed
					Summary: Solyn ขอความช่วยเหลือเรื่องรอยแยกของ Ceaseless Void ข้างในมี [item:NoxusBoss/TheAntiseed] รออยู่
					Summon: หลังชนะ Providence ให้คุยกับ Solyn เรื่อง Ceaseless Void จากนั้นชนะ Ceaseless Void แล้วตามเธอเข้าไปในรอยแยก
					Requires: ต้องฟังเรื่อง Genesis และชนะ Providence
				}

				Mars: {
					Short: เครื่องจักรของ Draedon สู้ร่วมกับ Solyn
					Summary: เครื่องจักรสงครามของ Draedon ที่สู้ร่วมกับ Solyn ในเควสต์พิเศษ
					Summon: เริ่มเควสต์พิเศษกับ Solyn แล้วติดต่อ Draedon ด้วย Codebreaker
					Requires: ต้องได้ Antiseed และชนะ Exo Mechs
				}

				AvatarOfEmptiness: {
					Short: บอสของ Wrath of the Gods: เปิดใช้ Genesis
					Summary: Avatar of Emptiness จะปรากฏเมื่อเปิดใช้ Genesis
					Summon: สร้างและเปิดใช้ Genesis
					Requires: ต้องชนะ Mars และสร้าง Genesis ให้เสร็จ
				}

				NamelessDeity: {
					Short: เทพองค์สุดท้ายของ Wrath of the Gods
					Summary: Nameless Deity ความท้าทายสุดท้ายของ Wrath of the Gods
					Summon: ใช้ [item:CalamityMod/Terminus] หลังจากดวงตาของมันเปิดขึ้น
					Requires: ต้องชนะ Avatar of Emptiness ก่อน
				}

				SirNautilus: {
					Short: Fables: ทหารผู้โดดเดี่ยวใต้เนินทราย
					Summary: ทหารผู้โดดเดี่ยวจาก Calamity Fables ที่รออยู่ในห้องลับใต้ทะเลทราย
					Summon: ตามหาห้องลับของเขาใต้เนินทราย สุสานหินทรายโบราณคือจุดสังเกต
				}

				FablesDesertScourge: {
					Short: Desert Scourge เวอร์ชันปรับใหม่ของ Fables
					Summary: Desert Scourge เวอร์ชันของ Calamity Fables ถ้าเปิด Calamity อยู่ จะใช้แทน Desert Scourge ของ Calamity ขณะที่ตัวเลือก "replace Calamity" ของ Fables เปิดอยู่ (ค่าเริ่มต้น)
					Summon: ล่อมันออกมาด้วยตัวอ่อน Stormlion: [item:CalamityFables/StormlionLarvaItem], [item:CalamityFables/DeadStormlionLarvaItem] หรือ [item:CalamityFables/BucketOfLarvae]
				}

				ScourgeVsScarab: {
					Short: ศึกดวล: Desert Scourge ปะทะ Scarabeus
					Summary: ศึกดวลพิเศษจาก Calamity Fables เมื่อเปิด Spirit Reforged ด้วย: Desert Scourge และ Scarabeus จะสู้กันเองและสู้กับคุณ
					Summon: ถวายตัวอ่อน Stormlion ([item:CalamityFables/StormlionLarvaItem], [item:CalamityFables/DeadStormlionLarvaItem] หรือ [item:CalamityFables/BucketOfLarvae]) บน [item:SpiritReforged/ScarabAltarItem]
				}

				FablesCrabulon: {
					Short: Crabulon เวอร์ชันปรับใหม่ของ Fables
					Summary: Crabulon เวอร์ชันของ Calamity Fables ถ้าเปิด Calamity อยู่ จะใช้แทน Crabulon ของ Calamity ขณะที่ตัวเลือก "replace Calamity" ของ Fables เปิดอยู่ (ค่าเริ่มต้น)
					Summon: ก่อนถูกชนะครั้งแรก มันอาจโผล่ออกมาเองในถ้ำเห็ด ดึงความสนใจของมันด้วย [item:CalamityFables/Hookstaff] โดยใช้ขณะยืนบนหญ้าเห็ดใต้ดิน
				}

				Scarabeus: {
					Short: Spirit Reforged: แมลงปีกแข็งยักษ์แห่ง Ziggurat
					Summary: แมลงปีกแข็งยักษ์จาก Spirit Reforged สู้ที่ Ziggurat ในทะเลทราย
					Summon: ใช้อัญมณีชนิดใดก็ได้ที่ [item:SpiritReforged/ScarabAltarItem] บน Ziggurat ตอนกลางวัน
				}
			}

			Stages: {
				pre-boss: {
					Name: ก่อนสู้บอส
					Hint: สร้างบ้านสัก 2-3 หลัง เก็บ Life Crystal และทำชุดเกราะจากแร่ บอสแรกที่เหมาะคือ King Slime และ Desert Scourge ถ้ามี Gravitation Potion ก็ขึ้นไปสำรวจเกาะลอยฟ้าและ Planetoid ได้
				}

				pre-evil1: {
					Name: ก่อน Eater of Worlds / Brain of Cthulhu
					Hint: หลังชนะ Eye of Cthulhu อีเวนต์ Acid Rain จะเริ่มได้ที่ Sulphurous Sea และหลังชนะ Desert Scourge จะมี Giant Clam ปรากฏใน Sunken Sea ส่วน Crabulon รออยู่ในไบโอม Glowing Mushroom ใต้ดิน จากนั้นไปสู้บอสสายชั่วร้ายของโลกคุณ
				}

				pre-evil2: {
					Name: ก่อน Hive Mind / Perforators
					Hint: เมื่อชนะบอสสายชั่วร้ายตัวแรกแล้ว อุกกาบาต (Meteorite) จะเริ่มตกได้และ Tavernkeep ย้ายเข้ามาได้ บอสถัดไปคือบอสสายชั่วร้ายของ Calamity: The Hive Mind ใน Corruption หรือ The Perforators ใน Crimson
				}

				pre-skeletron: {
					Name: ก่อน Skeletron
					Hint: การชนะ The Hive Mind หรือ The Perforators ทำให้ขุดแร่ Aerialite บนเกาะลอยฟ้าได้ (ต้องใช้ Pickaxe พลัง 65%) ส่วน Queen Bee และ Deerclops ไม่บังคับ แต่ดรอปของที่ช่วยในการสู้ Skeletron
				}

				pre-wof: {
					Name: ก่อน Wall of Flesh
					Hint: Skeletron เปิดทางเข้า Dungeon และปลดล็อกหีบที่ถูกล็อกใน Abyss สู้ Slime God แล้วสร้างสนามยาวเรียบใน Underworld เพื่อสู้ Wall of Flesh
				}

				pre-mech: {
					Name: ก่อนบอสจักรกล
					Hint: เข้าสู่ Hardmode แล้ว! ด้วยระบบปรับ Hardmode ช่วงต้นของ Calamity (เปิดเป็นค่าเริ่มต้น) แร่ Cobalt และ Palladium จะเกิดทันทีและการทุบแท่นบูชาจะไม่ให้แร่ ทุกครั้งที่ชนะบอสจักรกลจะได้แร่ระดับถัดไป Cryogen และ Queen Slime เป็นบอสช่วงต้นที่เหมาะ
				}

				post-mech1: {
					Name: หลังบอสจักรกลตัวที่ 1
					Hint: ชนะบอสจักรกลไป 1 ตัว: แร่ Mythril และ Orichalcum เกิดแล้ว ส่วน Aquatic Scourge (Sulphurous Sea) เหมาะเป็นบอสถัดไป และ Solar Eclipse เริ่มเกิดได้แล้ว
				}

				post-mech2: {
					Name: หลังบอสจักรกลตัวที่ 2
					Hint: ชนะบอสจักรกลไป 2 ตัว: แร่ Adamantite และ Titanium เกิดแล้ว ส่วน Brimstone Elemental รออยู่ที่ Brimstone Crag ใน Underworld
				}

				pre-plantera: {
					Name: ก่อน Plantera
					Hint: ชนะบอสจักรกลครบ 3 ตัว: แร่ Hallowed เกิดใน Hallow ใต้ดิน และ Plantera's Bulb จะงอกใน Jungle ใต้ดิน ส่วน Calamitas Clone เป็นบททดสอบที่ดีก่อนสู้ Plantera
				}

				pre-golem: {
					Name: ก่อน Golem
					Hint: Plantera ดรอป Temple Key และทำให้แร่ Perennial เกิดใต้ดิน ช่วงนี้ Leviathan กับ Anahita, Astrum Aureus และ Great Sand Shark เป็นบอสที่สู้ได้ก่อน Golem
				}

				post-golem: {
					Name: หลัง Golem
					Hint: Golem ทำให้โรคระบาด (Plague) เกิดใน Jungle และ Martian Probe ปรากฏบนผิวดิน ส่วน The Plaguebringer Goliath, Ravager, Duke Fishron, Empress of Light รวมถึง Pumpkin Moon และ Frost Moon ให้ของที่แข็งแกร่ง
				}

				pre-lunar: {
					Name: ก่อนอีเวนต์ดวงจันทร์
					Hint: ชนะ Lunatic Cultist ที่หน้าทางเข้า Dungeon เพื่อเริ่มอีเวนต์ Celestial Pillars
				}

				pre-moonlord: {
					Name: ก่อน Moon Lord
					Hint: ทำลายเสาทั้ง 4 ต้นเพื่อเรียก Moon Lord ส่วน Astrum Deus สู้ได้ก่อน Moon Lord และถ้าเล่นกับม็อด Catalyst ให้ชนะ Astrageldon ก่อน Moon Lord
				}

				pre-provi: {
					Name: ก่อน Providence
					Hint: Moon Lord ปลุกเปลวไฟศักดิ์สิทธิ์ขึ้นมา บอสถัดไปคือ Profaned Guardians และ Providence แร่ชนิดใหม่เกิดในอวกาศ ศัตรูตัวแกร่งใน Dungeon อาจปล่อย Phantom Spirit ออกมา และสามารถสู้ Dragonfolly ได้ใน Jungle
				}

				pre-polter: {
					Name: ก่อน Polterghast
					Hint: Providence ทำให้แร่ Uelibloom เกิดใน Jungle ใช้ Mark of Providence ใน Dungeon, Underworld และอวกาศ เพื่อสู้ Sentinel ทั้ง 3 ตัว แล้วไปสู้ Polterghast ใน Dungeon
				}

				pre-dog: {
					Name: ก่อน Devourer of Gods
					Hint: Polterghast ทำให้ Acid Rain ระดับสุดท้ายเริ่มได้ ซึ่งจบด้วย Old Duke ส่วน Cosmic Worm ที่ใช้เรียก Devourer of Gods คราฟต์ได้จากของดรอปของ Sentinel หรือจาก Luminite, เศษชิ้นส่วนดวงจันทร์, Meld Blob และ Necroplasm
				}

				pre-yharon: {
					Name: ก่อน Yharon
					Hint: Devourer of Gods ทำให้ Pumpkin Moon, Frost Moon และ Solar Eclipse ดรอปวัตถุดิบใหม่ ไข่สำหรับเรียก Yharon ต้องใช้ Effulgent Feather จาก Dragonfolly
				}

				pre-scal-exo: {
					Name: ก่อน Exo Mechs / Supreme Calamitas
					Hint: Yharon ทำให้แร่ Auric เกิด เหลือบอสสุดท้าย 2 ตัว: Exo Mechs (ใช้ Codebreaker ที่อัปเกรดครบพร้อม Auric Quantum Cooling Cell) และ Supreme Witch, Calamitas (ใช้ Altar of the Accursed)
				}

				endgame: {
					Name: ช่วงท้ายเกม
					Hint: ชนะบอสสุดท้ายทั้งสองแล้ว ความท้าทายที่เหลือ: Boss Rush, Primordial Wyrm ใน Abyss และบอสของม็อดเสริม
				}

				v-pre-boss: {
					Name: ก่อนสู้บอส
					Hint: สร้างบ้าน เก็บ Life Crystal และทำชุดเกราะจากแร่ การทุบ Shadow Orb หรือ Crimson Heart ให้อาวุธช่วงต้นเกม
				}

				v-pre-skeletron: {
					Name: ก่อน Skeletron
					Hint: ชนะบอสสายชั่วร้ายแล้ว: อุกกาบาตตกได้ Tavernkeep ย้ายเข้ามาได้ และแท่งแร่จากบอสใช้ทำ Pickaxe ที่ขุด Hellstone ได้ Skeletron จะเปิดทางเข้า Dungeon
				}

				v-pre-wof: {
					Name: ก่อน Wall of Flesh
					Hint: Dungeon เปิดแล้ว สร้างสนามยาวเรียบใน Underworld เพื่อสู้ Wall of Flesh การชนะจะเริ่ม Hardmode
				}

				v-pre-mech: {
					Name: ก่อนบอสจักรกล
					Hint: Hardmode: ทุบ Demon Altar หรือ Crimson Altar ด้วย Pwnhammer เพื่อให้แร่ใหม่เกิด บอสถัดไปคือ Queen Slime และบอสจักรกลทั้ง 3 ตัว
				}

				v-pre-plantera: {
					Name: ก่อน Plantera
					Hint: ชนะบอสจักรกลครบแล้ว: Plantera's Bulb จะงอกใน Jungle ใต้ดิน และขุด Chlorophyte ได้
				}

				v-pre-golem: {
					Name: ก่อน Golem
					Hint: Plantera ดรอป Temple Key ส่วน Golem รออยู่ใน Jungle Temple และ Pumpkin Moon, Frost Moon, Duke Fishron และ Empress of Light เป็นการต่อสู้เสริมที่ให้ของดี
				}

				v-pre-cultist: {
					Name: ก่อน Lunatic Cultist
					Hint: ชนะ Golem แล้ว: Lunatic Cultist จะปรากฏที่หน้าทางเข้า Dungeon และ Martian Probe สามารถเริ่ม Martian Madness ได้
				}

				v-pre-moonlord: {
					Name: ก่อน Moon Lord
					Hint: ทำลาย Celestial Pillar ทั้ง 4 ต้น แล้ว Moon Lord จะปรากฏหลังจากนั้นไม่นาน
				}

				v-endgame: {
					Name: ช่วงท้ายเกม
					Hint: ชนะ Moon Lord แล้ว สามารถคราฟต์ของที่ดีที่สุดจาก Luminite และเศษชิ้นส่วนดวงจันทร์ได้
				}
			}

			LoadoutNotes: {
				C1: ได้จากการโยน Enchanted Sword ลงใน Shimmer
				C2: ชิ้นนี้หายาก
				C3: เหมาะกับบอสหนอนและเป้าหมายที่โดนได้หลายจุด
				C4: เหมาะกับบอสหนอนและเป้าหมายที่โดนได้หลายจุด และเป็นอาวุธซัพพอร์ตด้วย
				C5: Mystic Robe หายาก
				C6: ชิ้นเหล่านี้หายาก
				C7: รุ่นอัปเกรดของชิ้นนี้ก็ใช้ได้
				C8: ชิ้นนี้ใช้ยาก
				C9: ใช้คู่กับ Purple Haze
				C10: ใช้เป็นเกราะสาย Rogue ได้ และหายาก
				C11: ใช้คู่กับ Wulfrum Knife
				C12: ใช้ในรูปแบบป้องกัน
				C13: ชุดนี้มีโบนัสเซ็ตใหม่
				C14: มีโบนัสเซ็ตใหม่ และหายากถ้าโลกของคุณไม่มีแร่ Silver
				C15: หายาก และได้แค่ชิ้นเดียวต่อโลก
				C16: อาจหายากขึ้นอยู่กับสายชั่วร้ายของโลกคุณ
				C17: ชิ้นนี้ใช้แล้วเสี่ยง
				C18: ใช้คู่กับ Musket Ball หรือ Tungsten Bullet
				C19: ใช้เป็นซัพพอร์ต
				C20: ใช้คู่กับ Fungicide
				C21: ใช้ยากและหายาก
				C22: ใช้ชิ้นที่ตรงกับสายชั่วร้ายของโลกคุณ
				C23: ใช้คู่กับ Counterweight
				C24: ใช้คู่กับ Smoking Comet
				C25: ใช้คู่กับชุด Meteor
				C26: ใช้คู่กับ Space Gun
				C27: ไอเทมนี้ใช้ยาก
				C28: ใน Calamity การหลบจะหลบได้แน่นอนแต่มีคูลดาวน์
				C29: ใช้กับ Skeletron
				C30: ใช้กับ Deerclops
				C31: ใช้คู่กับ Musket Ball หรือ Tungsten Bullet
				C32: ใช้คู่กับ Aquashard Shotgun
				C33: ใช้คู่กับ Hive Pack
				C34: ใช้คู่กับ Hornet Staff
				C35: อาวุธนี้ไม่ได้รับผลจากความเร็วโจมตีระยะประชิด
				C36: ใช้กับ Slime God
				C37: ใช้กับ Wall of Flesh
				C38: ชุดนี้มีโบนัสเซ็ตใหม่
				C39: ใช้คู่กับ Archerfish
				C40: ต้องมีสนามที่อยู่ระดับความสูงเดียวกับตาข้างใดข้างหนึ่งของ Wall of Flesh
				C41: ต้องเล่นแบบบุกเข้าหา

				GroupNotes: {
					rage: These drop from the boss's Treasure Bag only in Revengeance or Death, and only if you have not used one yet.
					adrenaline: These drop from the boss's Treasure Bag only in Revengeance or Death, and only if you have not used one yet.
					souls: A soul drops every time its boss is defeated while anyone in the world has not absorbed it yet. Touch it to absorb it.
					world: Shared by everyone in this world.
				}

				Items: {
					LifeCrystal: {
						Effect: +20 max life. Up to 15 (400 life).
						Where: Glowing hearts underground and in caverns: break them with a pickaxe. Also found in Gold Crates.
					}

					LifeFruit: {
						Effect: +5 max life. Up to 20 (500 life). Use all 15 Life Crystals first.
						Where: Grows in the underground Jungle once any mechanical boss is defeated.
					}

					SanguineTangerine: {
						Effect: +25 max life. Use all 20 Life Fruits first.
						Where: Craft at a Mythril or Orichalcum Anvil: Life Fruit, Blood Orbs and the three mechanical souls.
					}

					MiracleFruit: {
						Effect: +25 max life. Use all 20 Life Fruits first.
						Where: Craft at a Mythril or Orichalcum Anvil: Life Fruit, Life Alloy and Living Shards.
					}

					TaintedCloudberry: {
						Effect: +25 max life. Use all 20 Life Fruits first.
						Where: Craft after Providence: Life Fruit, Uelibloom Bars and Divine Geodes.
					}

					SacredStrawberry: {
						Effect: +25 max life. Use all 20 Life Fruits first.
						Where: Craft at the Cosmic Anvil after Yharon: Life Fruit, Yharon Soul Fragments and Ascendant Spirit Essence.
					}

					ManaCrystal: {
						Effect: +20 max mana. Up to 9 (200 mana).
						Where: Craft from 5 Fallen Stars (no station needed).
						WhereCal: Craft from 5 Fallen Stars (no station needed). Calamity's Enchanted Starfish (caught by fishing) counts as a Mana Crystal.
					}

					CometShard: {
						Effect: +60 max mana. Use all 9 Mana Crystals first.
						Where: Craft at an Anvil: Meteorite Bars, Fallen Stars and Starblight Soot (from Astral Infection enemies).
					}

					EtherealCore: {
						Effect: +60 max mana. Use all 9 Mana Crystals first.
						Where: Craft at the Ancient Manipulator: Astral Bars, Nebula Fragments and Fallen Stars.
					}

					PhantomHeart: {
						Effect: +60 max mana. Use all 9 Mana Crystals first.
						Where: Craft after Polterghast: Ruinous Souls and Necroplasm.
					}

					DemonHeart: {
						Effect: +1 accessory slot. Only usable in Expert and Master worlds.
						Where: Wall of Flesh Treasure Bag.
					}

					CelestialOnion: {
						Effect: +1 accessory slot. In Master Mode it gives the Demon Heart's slot instead, so the two do not stack there.
						Where: Moon Lord: dropped directly in Classic, from the Treasure Bag in Expert and Master (only while you still need it).
					}

					AegisCrystal: {
						Effect: Natural life regeneration builds up faster.
						Where: Throw a Life Crystal into Shimmer.
					}

					AegisFruit: {
						Effect: +4 defense.
						Where: Throw a Life Fruit into Shimmer.
					}

					ArcaneCrystal: {
						Effect: Faster mana regeneration.
						Where: Throw a Mana Crystal into Shimmer.
					}

					GalaxyPearl: {
						Effect: +0.03 luck.
						Where: Throw a Pink Pearl into Shimmer.
					}

					GummyWorm: {
						Effect: +3 fishing power.
						Where: Throw a Gold Worm into Shimmer.
					}

					Ambrosia: {
						Effect: +5% mining speed and +5% block and wall placement speed.
						Where: Throw any fruit into Shimmer.
					}

					ArtisanLoaf: {
						Effect: Crafting stations work from 4 more tiles away.
						Where: Sold by the Skeleton Merchant (underground) during certain moon phases.
					}

					TorchGodsFavor: {
						Effect: Unlocks a toggle next to the inventory: placed torches become the torch of your current biome.
						Where: Survive the Torch God event: place 101 torches close together underground.
					}

					MinecartUpgradeKit: {
						Effect: Faster minecarts with a defensive probe.
						Where: Craft from the three Mechanical Cart pieces, one in each mechanical boss's Treasure Bag.
					}

					MushroomPlasmaRoot: {
						Effect: Rage Mode lasts 1 second longer.
						Where: Crabulon's Treasure Bag.
					}

					InfernalBlood: {
						Effect: Rage Mode lasts 1 second longer.
						Where: Ravager's Treasure Bag.
					}

					RedLightningContainer: {
						Effect: Rage Mode lasts 1 second longer.
						Where: The Dragonfolly's Treasure Bag.
					}

					ElectrolyteGelPack: {
						Effect: Adrenaline Mode: +20% damage and +5% damage reduction.
						Where: The Slime God's Treasure Bag.
					}

					StarlightFuelCell: {
						Effect: Adrenaline Mode: +20% damage and +5% damage reduction.
						Where: Astrum Aureus's Treasure Bag.
					}

					Ectoheart: {
						Effect: Adrenaline Mode: +20% damage and +5% damage reduction.
						Where: Polterghast's Treasure Bag.
					}

					GoozmaSoul: {
						Effect: +10 max life, +20 max mana, +3 defense, +3% damage, crit chance, melee speed and movement speed, +1% damage reduction.
						Where: Dropped by Goozma.
					}

					YharonSoul: {
						Effect: +10 max life, +20 max mana, +3 defense, +3% damage, crit chance, melee speed and movement speed, +1% damage reduction.
						Where: Dropped by Yharon.
					}

					RottenSoul: {
						Effect: +10 max life, +20 max mana, +3 defense, +3% damage, crit chance, melee speed and movement speed, +1% damage reduction.
						Where: Dropped by the Old Duke.
					}

					PeddlersSatchel: {
						Effect: The Traveling Merchant sells one more item.
						Where: The Traveling Merchant drops a Peddler's Hat when killed; throw it into Shimmer.
					}
				}
			}

			Guides: {
				Title: Guides
				Intro: Short guides for the mechanics and mods you have loaded. Press {0} any time to open Khu Mue.

				Categories: {
					start: Getting started
					calamity: Calamity mechanics
					addons: Add-on mods
					warnings: Avoid these mistakes
				}

				using-guide: {
					Title: How to use Khu Mue
					Summary: What each tab does and how to find things fast.

					Open: {
						Title: Opening the guide
						Body: Press {0} to open or close the guide; Esc also closes it. The mouse back button (or the arrow at the top) returns to the previous page. You can change the key in Settings > Controls.
					}

					Home: {
						Title: Home
						Body: Home reads your world and shows where you are, the next main step with how to start it, other things you can do now, and permanent upgrades you have not used yet.
					}

					Progress: {
						Title: Progression
						Body: Every boss, event and quest of your mods in order, marked as done, next, available or locked. Click one for how to start it, what it unlocks and its drops (read from the game).
					}

					Gear: {
						Title: Gear
						Body: Recommended weapons, armor, accessories and buffs for your class and stage, adapted from the Calamity and Terraria wikis. It opens on your world's stage; the arrows browse other stages.
					}

					Items: {
						Title: Items
						Body: Search any item in English or Thai. Its page shows every recipe with the base materials it needs in total, drops, shops, bags, Shimmer results, the chests and fishing spots it comes from and what it is used for. A green dot means you own it.
					}

					Upgrades: {
						Title: Upgrades
						Body: Every permanent upgrade (Life Crystals, Calamity fruits, Rage and Adrenaline boosters...) with what this character has already used.
					}
				}

				first-steps: {
					Title: First steps
					Summary: Survive the first nights and get ready for the first bosses.

					Shelter: {
						Title: A safe house
						Body: Build a house before night. A room with background walls, a door, a light source, a table and a chair counts as housing, and new town NPCs move into such rooms.
					}

					Explore: {
						Title: Ore and gear
						Body: Dig down for ore and upgrade your pickaxe and armor step by step. Chests underground often hold useful accessories such as Hermes Boots and Cloud in a Bottle.
					}

					Life: {
						Title: More life and mana
						Body: Each Life Crystal gives +20 max life (up to 400). Mana Crystals are crafted from 5 Fallen Stars, which fall at night. The Upgrades tab tracks them.
					}

					Progress: {
						Title: What next?
						Body: The Home tab always shows your next main step. Open it for how to start the fight and what gear to bring.
					}
				}

				difficulties: {
					Title: World difficulty
					Summary: What Classic, Expert, Master and Journey change.
					SummaryCal: What Classic, Expert, Master and Journey change. Calamity's own modes are explained in the Calamity section.

					Classic: {
						Title: Classic
						Body: The normal game. Bosses drop their items directly instead of in Treasure Bags.
					}

					Expert: {
						Title: Expert
						Body: Enemies have more health and damage, bosses gain new attacks, and bosses drop Treasure Bags with an exclusive Expert item. The Demon Heart's extra accessory slot only works here and in Master.
					}

					Master: {
						Title: Master
						Body: Even stronger than Expert. Bosses also drop relics and pets, you get one extra accessory slot from the start, and you drop all your coins on death.
					}

					Journey: {
						Title: Journey
						Body: A creative mode: research items to duplicate them, control time and weather, and set enemy difficulty with a slider. Journey characters can only play Journey worlds.
					}
				}

				classes: {
					Title: Classes
					Summary: The damage classes and how they fit together.

					Melee: {
						Title: Melee
						Body: Swords, spears, yoyos and boomerangs. Melee armor tends to have the most defense.
					}

					Ranged: {
						Title: Ranged
						Body: Bows and guns that use arrows and bullets, plus launchers. Pick the ammo for the job: piercing for crowds, strong single shots for bosses.
					}

					Magic: {
						Title: Magic
						Body: Weapons that spend mana. Max mana, mana regeneration and Mana Potions keep you firing.
					}

					Summoner: {
						Title: Summoner
						Body: Minions and sentries fight for you, and whips focus them on a target and boost them.
					}

					Mixing: {
						Title: Mixing classes
						Body: Minions keep attacking while you use any weapon, so summoning gear always adds damage.
						BodyCal: In Calamity, holding a melee, ranged, magic or rogue weapon makes your minions deal 25% less damage. Calamity also adds the Rogue class (see the Rogue guide).
					}
				}

				boss-prep: {
					Title: Preparing for a boss
					Summary: Arenas, buffs and the things that save a fight.

					Arena: {
						Title: Build an arena
						Body: Several long rows of platforms give room to dodge. A Campfire, a Heart Lantern and a Star in a Bottle nearby add regeneration; standing in honey heals too.
					}

					Buffs: {
						Title: Buffs
						Body: Ironskin, Regeneration, Swiftness and Endurance Potions and a food buff help every class. The Gear tab lists class buffs for each stage.
					}

					Mobility: {
						Title: Mobility first
						Body: Wings, dashes and extra jumps prevent more damage than armor. Upgrade them before anything else.
					}

					Healing: {
						Title: Healing
						Body: Healing potions share a cooldown (Potion Sickness), so drink at the right moment instead of too early.
					}
				}

				hardmode: {
					Title: Entering Hardmode
					Summary: What changes after the Wall of Flesh.

					Changes: {
						Title: What changes
						Body: Stronger enemies appear everywhere, and a Hallow stripe and a second evil stripe cut through the world.
					}

					Ores: {
						Title: New ores
						Body: Smash Demon or Crimson Altars with the Pwnhammer to spawn Hardmode ores: each smash adds ore of the next tier (Cobalt/Palladium, Mythril/Orichalcum, Adamantite/Titanium).
						BodyCal: Calamity's early Hardmode rework (on by default): Cobalt and Palladium appear as soon as Hardmode starts and altars give nothing. The first mechanical boss adds Mythril and Orichalcum, the second Adamantite and Titanium, the third Hallowed ore in the underground Hallow. The first two mechanical bosses you fight are also a little weaker.
					}

					Spread: {
						Title: The spread
						Body: The Hallow and the Corruption or Crimson slowly convert nearby grass, stone, sand and ice. Protect important areas with gaps or blocks that do not convert.
					}

					Next: {
						Title: First goals
						Body: Get wings, then take on Queen Slime and the mechanical bosses. Souls of Light and Night drop from enemies in the underground Hallow and evil biomes.
					}
				}

				shimmer: {
					Title: Shimmer
					Summary: The shimmering lake that transforms items.

					Find: {
						Title: Where it is
						Body: The Shimmer lake lies in the Aether, an underground biome near the edge of the world on the side opposite the Dungeon.
					}

					Transform: {
						Title: Transforming items
						Body: Throw an item into Shimmer to transmute it, and many crafted items are taken apart into their ingredients. Item pages show Shimmer results under How to get.
					}

					Boosters: {
						Title: Permanent boosters
						Body: Life Crystal becomes [item:Terraria/AegisCrystal], Life Fruit becomes [item:Terraria/AegisFruit], Mana Crystal becomes [item:Terraria/ArcaneCrystal], a Pink Pearl becomes [item:Terraria/GalaxyPearl], a Gold Worm becomes [item:Terraria/GummyWorm] and any fruit becomes [item:Terraria/Ambrosia].
					}

					Careful: {
						Title: Careful
						Body: Touching Shimmer makes you phase through blocks and fall until you leave it. It does not hurt, but it can drop you far.
					}
				}

				fishing: {
					Title: Fishing
					Summary: Fishing power, pond size, lava fishing, crates and the Angler's quests.

					Basics: {
						Title: Getting started
						Body: Hold a fishing pole, keep bait in your inventory and cast into a pond. What you catch depends on the liquid, the biome and the height where the bobber lands. Every item page in this guide lists where that item can be caught.
						BodyCal: Hold a fishing pole, keep bait in your inventory and cast into a pond. What you catch depends on the liquid, the biome and the height where the bobber lands. Calamity adds catches in the Sunken Sea, the Sulphurous Sea, the Abyss, the Astral Infection and the lava of the Brimstone Crag. Every item page in this guide lists where that item can be caught.
					}

					Power: {
						Title: Fishing power
						Body: Fishing power is the pole, the bait and your bonuses added up: a Fishing Potion gives 15, an Angler Tackle Bag 10, and up to three Chum in the pond add 11, 6 and 3. The higher it is, the better your chance of rare catches. Luck changes it as well: bad luck can lower it, good luck can raise it.
					}

					Water: {
						Title: Pond size
						Body: A pond needs about 300 tiles of liquid for full fishing power; high up in the sky layer fewer are enough. A smaller pond lowers your fishing power.
					}

					Lava: {
						Title: Lava and honey
						Body: Fishing in lava needs one of these: the Hotline Fishing Hook, lava bait (Magma Snail, Lavafly or Hell Butterfly), or a Lavaproof Fishing Hook or Lavaproof Tackle Bag. Honey needs nothing special.
					}

					Crates: {
						Title: Crates
						Body: About one catch in ten is a crate, one in four with a Crate Potion. Crates hold ores, bars, potions, coins and items of the biome where they were caught; in Hardmode you get the Hardmode versions.
					}

					Angler: {
						Title: The Angler's quests
						Body: Wake the Angler sleeping at the beach. Every morning at 4:30 AM he asks for one quest fish, which can only be caught while it is his quest. Hand it in for a reward: your 5th, 10th, 15th, 20th, 25th and 30th finished quests give the Fuzzy Carrot, the Angler Hat, Vest and Pants, the Bottomless Water Bucket and the Golden Fishing Rod, and rare rewards come more often the more quests you finish.
					}
				}

				cal-difficulty: {
					Title: Calamity difficulty modes
					Summary: Revengeance, Death and Malice, and how to switch.

					Select: {
						Title: Choosing a mode
						Body: Open your inventory: Calamity's difficulty icon sits at the top right, next to the minimap. Click it to choose a mode. It cannot be changed while a boss is alive or during Boss Rush.
					}

					Revengeance: {
						Title: Revengeance
						Body: Needs Expert Mode (in a Master world Calamity turns it into Death by itself). The intended Calamity experience and what the Gear tab assumes. Enables Rage and Adrenaline, makes enemies more aggressive, gives every boss new attacks, and bosses drop both Expert and Master rewards.
					}

					Death: {
						Title: Death
						Body: Needs Master Mode: in a Master world Calamity switches Revengeance to Death on its own. Bosses are much faster and harder than in Revengeance, basic enemies are far more aggressive, Blood Moons send endless waves, debuffs are more lethal and the Abyss is more dangerous.
					}

					Malice: {
						Title: Malice
						Body: Needs Legendary Mode (a Master world with the For the Worthy seed), where Calamity switches Revengeance to Malice on its own: Death Mode and For the Worthy behavior with Legendary stats.
					}
				}

				cal-rage-adrenaline: {
					Title: Rage and Adrenaline
					Summary: Revengeance's two damage meters.

					Adrenaline: {
						Title: Adrenaline
						Body: Fills while you fight bosses; getting hit empties it. When full, press the Adrenaline key for 5 seconds of 2.5x damage. While it is full and unused, hits against you are also halved.
					}

					Rage: {
						Title: Rage
						Body: Fills when you are near enemies or use certain items. When full, press the Rage key for +35% damage for 9 seconds.
					}

					Boosters: {
						Title: Boosters
						Body: Rage lasts 1 second longer per booster: [item:CalamityMod/MushroomPlasmaRoot], [item:CalamityMod/InfernalBlood], [item:CalamityMod/RedLightningContainer]. Adrenaline gains +20% damage and +5% damage reduction per booster: [item:CalamityMod/ElectrolyteGelPack], [item:CalamityMod/StarlightFuelCell], [item:CalamityMod/Ectoheart]. All come from Treasure Bags in Revengeance.
					}

					TrueMelee: {
						Title: Keys and true melee
						Body: Bind the Rage and Adrenaline keys in Settings > Controls. True melee hits (the weapon itself touching the enemy) get only half of the Rage and Adrenaline damage bonus.
					}
				}

				cal-rogue: {
					Title: Rogue and stealth
					Summary: Calamity's throwing class.

					Stealth: {
						Title: Stealth
						Body: Wearing rogue armor lets you build stealth. It builds while you are not attacking (more slowly while moving) and is only used up by attacking. The more stealth you have, the more rogue damage you deal.
					}

					Strikes: {
						Title: Stealth Strikes
						Body: At full stealth your next rogue attack becomes a Stealth Strike: a special, much stronger version of the weapon's attack. More stealth regeneration slightly lowers the stealth damage bonus but lets you strike more often.
					}

					Gear: {
						Title: Two play styles
						Body: The Gear tab splits rogue weapons and accessories into Spam (attack as fast as possible) and Stealth strike builds.
					}
				}

				cal-summon: {
					Title: Summoner rules
					Summary: Calamity's cross-class penalty for minions.

					Penalty: {
						Title: The penalty
						Body: While you hold a melee, ranged, magic or rogue weapon, your minions and sentries deal 25% less damage.
					}

					Exceptions: {
						Title: Exceptions
						Body: Whips and other summon weapons, tools, accessories and ammo do not trigger it. It is also lifted by Forbidden armor with a magic weapon, a Forbidden Circlet set with a rogue weapon, Fearmonger armor, GemTech armor's blue gem, the Profaned Soul Crystal, and during the Old One's Army.
					}
				}

				cal-defense-damage: {
					Title: Defense damage
					Summary: Why your defense drops after hits.

					How: {
						Title: How it works
						Body: Certain attacks also chip away at your defense for a short time. It regenerates quickly once you stop getting hit, so avoiding hits in a row matters more than stacking defense.
					}
				}

				cal-biomes: {
					Title: Calamity's biomes
					Summary: The Sunken Sea, the Sulphurous Sea, the Abyss and more.

					SunkenSea: {
						Title: Sunken Sea
						Body: Deep below the Desert lies the Sunken Sea, the ruins of a fallen kingdom. The Giant Clam lives there after the Desert Scourge, and the Sea King (Amidias) moves in once both are beaten; he can give you a bubble for breathing underwater.
					}

					Sulphurous: {
						Title: Sulphurous Sea
						Body: One ocean is toxic: its water poisons you over time. Acid Rain and the Aquatic Scourge belong here.
					}

					Abyss: {
						Title: The Abyss
						Body: Deep below the Sulphurous Sea: dark, deep and dangerous. Bring proper diving gear and light. Its locked chests open after Skeletron. Never teleport there with a Rod of Discord.
					}

					Astral: {
						Title: Astral Infection
						Body: An alien biome from a fallen star. Astrum Aureus and Astrum Deus are fought here, and Astral Ore can be mined after Astrum Deus.
					}

					Crag: {
						Title: Brimstone Crag
						Body: A scorched region of the Underworld, home of the Brimstone Elemental.
					}

					Labs: {
						Title: Labs and planetoids
						Body: Draedon's abandoned labs are hidden near the Sunken Sea, on a large planetoid in the sky, in the Jungle, in the Underworld and deep in the ice caves. See the Draedon's labs guide.
					}
				}

				cal-acid-rain: {
					Title: Acid Rain
					Summary: The Sulphurous Sea's event in three tiers.

					Start: {
						Title: Starting it
						Body: After the Eye of Cthulhu, the first Acid Rain starts when you enter the Sulphurous Sea. Later ones start by themselves at night or with a [item:CalamityMod/CausticTear]. A Caustic Tear used before the Eye of Cthulhu (or Hardmode) is wasted.
					}

					Tiers: {
						Title: Tiers
						Body: Tier 1 after the Eye of Cthulhu, tier 2 after the Aquatic Scourge (with the Cragmaw Mire), tier 3 after Polterghast (with the Mauler and the Nuclear Terror). Completing tier 3 summons the Old Duke.
					}

					Fail: {
						Title: Failing
						Body: The event fails if the rain stops, or if no Acid Rain enemy is killed for 2.5 minutes.
					}
				}

				cal-draedon: {
					Title: Draedon's labs and the Codebreaker
					Summary: Schematics, power cells and the road to the Exo Mechs.

					Labs: {
						Title: The labs
						Body: Draedon's labs hold encrypted schematics, Power Cell Factories and Charging Stations that you can take. Power Cell Factories make Draedon Power Cells over time.
					}

					Codebreaker: {
						Title: The Codebreaker
						Body: Build the [item:CalamityMod/CodebreakerBase] and install parts: the Decryption Computer decrypts the planetoid schematic; the Jungle one also needs the Sensor Array; the Underworld one also the Advanced Display; the ice one also the Voltage Regulation System.
					}

					Power: {
						Title: Power cells
						Body: Decrypting costs Draedon Power Cells: 500 for the planetoid schematic, 950 for the Jungle, 1750 for the Underworld and 5000 for the ice caves. Draedon's Arsenal weapons use charge, refilled at a Charging Station.
					}

					ExoMechs: {
						Title: Calling Draedon
						Body: With an [item:CalamityMod/AuricQuantumCoolingCell] installed (after Yharon), the Codebreaker can contact Draedon and start the Exo Mechs fight.
					}
				}

				cal-npcs: {
					Title: Calamity's town NPCs
					Summary: Who moves in, and when.

					SeaKing: {
						Title: Sea King (Amidias)
						Body: Moves in after the Desert Scourge and the Giant Clam are defeated. He can give you a bubble for breathing underwater and later sells the Old Duke's bait.
					}

					Bandit: {
						Title: Bandit
						Body: Moves in after Skeletron while someone carries a Platinum Coin (inventory or portable storage). If you reforge a lot, visit him: it can pay off.
					}

					Archmage: {
						Title: Archmage (Permafrost)
						Body: Moves in after Cryogen is defeated.
					}

					Witch: {
						Title: Brimstone Witch (Calamitas)
						Body: Moves in after Supreme Calamitas is defeated. She can enchant your items with new powers.
					}
				}

				cal-boss-rush: {
					Title: Boss Rush
					Summary: Every boss in a row, greatly strengthened.

					Start: {
						Title: Starting it
						Body: Hold the [item:CalamityMod/Terminus] to start Boss Rush at any time; use it again to stop. The Terminus is in the shrine chest at the very bottom of the Abyss, and the Primordial Wyrm drops one.
					}

					Rules: {
						Title: Rules
						Body: Bosses come one after another and are far stronger than normal. Normal boss summons do not work during it, and the difficulty cannot be changed.
					}
				}

				infernum: {
					Title: Infernum Mode
					Summary: Harder, rewritten boss fights for Calamity.

					What: {
						Title: What it is
						Body: Infernum rewrites the fights of most Calamity and vanilla bosses with new, much harder attacks, and adds bosses such as the Bereft Vassal and a boss version of the Dreadnautilus.
					}

					Enable: {
						Title: Turning it on
						Body: Open your inventory, click Calamity's difficulty icon (top right) and choose Infernum. It turns on Revengeance and sets the world to Expert. Its extra bosses appear in the Progression tab only while Infernum is on.
					}

					Limits: {
						Title: Limits
						Body: Infernum turns itself off in Master Mode, For the Worthy and Zenith (Get fixed boi) worlds, and it warns you if Eternity Mode is also on.
					}
				}

				wotg: {
					Title: Wrath of the Gods
					Summary: Solyn's story and the gods at the end of it.

					Story: {
						Title: Solyn's quests
						Body: The mod follows Solyn, a traveler from the stars. Her quests appear in the Progression tab in order: meet her, set up camp, go stargazing, explore Permafrost Keep, learn about the Genesis, recover the Antiseed and fight Mars.
					}

					Genesis: {
						Title: The Genesis
						Body: Activating the finished Genesis summons the Avatar of Emptiness. After it, the Nameless Deity is fought with the Terminus.
					}
				}

				fables: {
					Title: Calamity Fables
					Summary: Reworked early bosses and a desert duel.

					Replace: {
						Title: Replacing Calamity's bosses
						Body: Fables reworks the Desert Scourge and Crabulon. While its "replace Calamity" option is on (the default), the guide shows the Fables versions instead of Calamity's.
					}

					Bosses: {
						Title: Its bosses
						Body: Sir Nautilus waits in a hidden chamber under the dunes. The Desert Scourge is lured out with stormlion grubs. Crabulon is provoked with the Hookstaff on underground mushroom grass. With Spirit Reforged, a grub offered at the Ancient Altar starts the Scourge vs. Scarab duel.
					}
				}

				hunt: {
					Title: Hunt of the Old God
					Summary: Goozma, the Auric Souls and the Shadowspec Curse.

					Goozma: {
						Title: Goozma
						Body: Throw an [item:CalamityMod/OverloadedSludge] onto King Slime during a Slime Rain, or use a [item:CalamityHunt/PluripotentSpawnEgg] on an empowered Slime Ninja Statue. It can be summoned from Hardmode on, but it is balanced for the end of the game.
					}

					Souls: {
						Title: Auric Souls
						Body: Goozma, Yharon and the Old Duke each drop an Auric Soul every time they are defeated while anyone in the world has not absorbed that soul. Touch it to absorb it: +10 max life, +20 max mana, +3 defense and +3% to damage, crit chance, melee speed and movement speed.
					}

					Curse: {
						Title: The Shadowspec Curse
						Body: Hunt's client option Shadowspec Curse is on by default: items crafted from Shadowspec Bars cannot be used or equipped until Goozma is defeated in the world, and they show a question mark in the inventory (and in this guide). Turn the option off in Hunt of the Old God's mod settings to lift it.
					}
				}

				catalyst: {
					Title: Catalyst
					Summary: Astrageldon, and why it must come before the Moon Lord.

					Astrageldon: {
						Title: Astrageldon
						Body: Use the [item:CatalystMod/AstralCommunicator] on the surface of the Astral Infection. Defeat Astrageldon before the Moon Lord: afterwards the Communicator stops working in that world unless Astrageldon was already killed.
					}
				}

				spirit: {
					Title: Spirit Reforged
					Summary: Scarabeus of the Ziggurat.

					Scarabeus: {
						Title: Scarabeus
						Body: Use any gem at the Ancient Altar on the desert Ziggurat during the day. The altar can also be crafted.
					}
				}

				mistakes: {
					Title: Common mistakes
					Summary: Things that are easy to regret.

					Hardmode: {
						Title: Starting Hardmode
						Body: Defeating the Wall of Flesh cannot be undone: the Hallow and the evil biomes start spreading. Protect key areas first.
					}

					Dungeon: {
						Title: The Dungeon too early
						Body: Entering the Dungeon before Skeletron is defeated summons the Dungeon Guardian, which kills almost instantly.
					}

					Enrage: {
						Title: Leaving the arena
						Body: Plantera enrages outside the Jungle and Duke Fishron outside the Ocean. Fight them where they belong.
					}

					Empress: {
						Title: The Empress at dawn
						Body: If the sun rises while you fight the Empress of Light, her attacks kill almost instantly. Start early in the night.
					}
				}

				cal-mistakes: {
					Title: Calamity traps
					Summary: Hidden triggers that summon bosses or waste items.

					Abyss: {
						Title: Teleporting in the Abyss
						Body: Never use a Rod of Discord (or anything that gives Chaos State) while in the Abyss: it immediately summons the Primordial Wyrm, at any point of the game.
					}

					Triggers: {
						Title: Enemies that summon bosses
						Body: Killing these summons a boss: a Hive Tumor (The Hive Mind), a Perforator Cyst (The Perforators), the elusive singer in the Ocean (Anahita and the Leviathan, even before Hardmode), 10 Sand Sharks after Plantera (Great Sand Shark) and 30 Phantom Spirits (Polterghast).
					}

					Tear: {
						Title: Caustic Tear too early
						Body: A Caustic Tear used before the Eye of Cthulhu (or Hardmode) is consumed but does not start Acid Rain.
					}

					SmallWorld: {
						Title: Small worlds
						Body: Calamity does not support small worlds; use a medium or large world.
					}
				}
			}

			Settings: {
				Title: Settings
				Options: Options
				Key: Open or close the guide with {0}. You can change the key in Settings > Controls (search for Khu Mue). If the key does something else too, give one of them another key.
				KeyClash: "{0} is also bound to: {1}. Pressing it does both."
				KeyNone: No key opens the guide yet: tModLoader leaves new mod keys unbound. Set one in Settings > Controls (search for Khu Mue), or type /khumue in chat.
				KeyNoneChat: Khu Mue has no key yet. Set one in Settings > Controls (search for Khu Mue), or type /khumue in chat to open it.
				KeyClashChat: Khu Mue opens with {0}, which is also bound to: {1}. Change one of them in Settings > Controls if pressing it does something you do not want.
				TextSize: Text size
				WindowSize: Window size
				HideSpoilers: Hide spoilers
				OpenForNew: Open for new characters
				VersionNotice: Version notice
				Mods: Supported mods
				ModsIntro: The guide's route and gear data was checked against these exact versions. Recipes, drops and shops are always read live from your game.
				NotLoaded: not loaded
				CheckedFor: checked: {0}

				Match: {
					Exact: Exact match
					Near: Same minor version
					Different: Different version
					NotLoaded: Not loaded
				}

				DataErrors: Guide data errors
				About: About
				AboutBody: Khu Mue reads recipes, drops, shops, shimmer results and stats directly from your game, so they always match the mods you run. The route, stage and gear advice was checked by hand against the mod versions listed above.
				Credits: Gear recommendations adapted from the Calamity Mod Wiki (CC BY-NC-SA 3.0) and the Terraria Wiki (CC BY-NC-SA 4.0). Khu Mue is not affiliated with Re-Logic or the teams of the supported mods.
			}

			Entries: {
				KingSlime: {
					Short: A giant slime; an easy first boss.
					Summary: A giant slime that jumps, teleports and spits out smaller slimes. A good first boss.
					Summon: Use a [item:Terraria/SlimeCrown]. It can also appear by itself in the outer parts of the world, or after 150 slimes are killed during a Slime Rain.
					Tips:
						'''
						• Fight on flat ground with a few platforms above you.
						• Piercing or area weapons clear the small slimes it spawns.
						'''
				}

				TorchGod: {
					Short: Secret event: too many torches underground.
					Summary: A secret event: the Torch God attacks when you place too many torches close together underground. Survive it to get [item:Terraria/TorchGodsFavor].
					Summon: Place 101 torches close together while underground. The event starts when the last torch is placed.
					Unlocks: "[item:Terraria/TorchGodsFavor]: a toggle next to your inventory that turns placed torches into the torch of your current biome."
					Tips: • Do it in a small underground room with space to dodge the falling torch flames.
				}

				EyeOfCthulhu: {
					Short: First main boss; drops your world's evil ore.
					Summary: A giant eye that charges at you and becomes much faster in its second phase. The first step of the main route.
					Summon: Use a [item:Terraria/SuspiciousLookingEye] at night. It may also come by itself at nightfall (1 in 3) once a player has 200 max life and more than 10 defense and at least 4 town NPCs live in the world.
					Unlocks: Drops Demonite or Crimtane Ore (matching your world's evil) for your first boss-tier gear.
					UnlocksCal: Drops Demonite or Crimtane Ore. In Calamity it also lets Acid Rain start: the first one begins when you enter the Sulphurous Sea. Blood Moon enemies start dropping Blood Orbs.
					Tips:
						'''
						• Build a long skybridge of platforms so you can run left and right.
						• In the second phase it dashes several times in a row; keep moving sideways.
						'''
				}

				BloodMoon: {
					Name: Blood Moon
					Short: Red night: more and stronger enemies.
					Summary: A night event: enemies spawn much more often, special Blood Moon enemies appear and fishing can pull up monsters. Zombies can open doors.
					Summon: Happens by itself at the start of some nights (1 in 9, never on a new moon) once a player has used at least 2 Life Crystals. Or use a [item:Terraria/BloodMoonStarter] at night.
					SummonCal: Happens by itself at the start of some nights (1 in 9, never on a new moon). Calamity raises the requirement: a player must have used at least 5 Life Crystals (200 max life). Or use a [item:Terraria/BloodMoonStarter] at night.
					Tips:
						'''
						• Fishing during a Blood Moon can catch dangerous but rewarding monsters.
						• Stay in a safe base: zombies can open doors.
						'''
					TipsCal:
						'''
						• After the Eye of Cthulhu, Blood Moon enemies drop Blood Orbs, which can craft many potions.
						• In Death Mode, Blood Moons send endless waves of enemies.
						• Stay in a safe base: zombies can open doors.
						'''
				}

				EaterOfWorlds: {
					Short: The Corruption's worm boss.
					Summary: A huge worm made of many segments; hitting the body splits it into smaller worms. The Corruption's boss and a main-route step.
					Summon: Use [item:Terraria/WormFood] in the Corruption, or break Shadow Orbs in the Corruption chasms (every third orb summons it).
					Unlocks: Meteorites can now land and the Tavernkeep can move in. Its Demonite Bars and Shadow Scales make gear and a pickaxe strong enough for Hellstone.
					UnlocksCal: Meteorites can now land and the Tavernkeep can move in. Its Demonite Bars and Shadow Scales make gear and a pickaxe strong enough for Hellstone. Calamity's own Corruption boss, [e:HiveMind], is next.
					Tips:
						'''
						• Piercing and area weapons hit many segments at once.
						• Break the Shadow Orbs one at a time when you are ready: every third one summons the boss.
						'''
				}

				BrainOfCthulhu: {
					Short: The Crimson's brain boss.
					Summary: A floating brain protected by Creepers. It cannot be hurt until its Creepers are gone, then it teleports around you. The Crimson's boss and a main-route step.
					Summon: Use a [item:Terraria/BloodySpine] in the Crimson, or break Crimson Hearts in the Crimson chasms (every third heart summons it).
					Unlocks: Meteorites can now land and the Tavernkeep can move in. Its Crimtane Bars and Tissue Samples make gear and a pickaxe strong enough for Hellstone.
					UnlocksCal: Meteorites can now land and the Tavernkeep can move in. Its Crimtane Bars and Tissue Samples make gear and a pickaxe strong enough for Hellstone. Calamity's own Crimson boss, [e:Perforators], is next.
					Tips:
						'''
						• Kill the Creepers first; only then can the brain be damaged.
						• Area and piercing weapons clear the Creepers quickly.
						'''
				}

				GoblinArmy: {
					Name: Goblin Army
					Short: Goblin invasion; frees the Goblin Tinkerer.
					Summary: An army of goblins invades your town. Beating it lets you rescue the Goblin Tinkerer, who reforges items and sells the Tinkerer's Workshop for combining accessories.
					Summon: Use a [item:Terraria/GoblinBattleStandard]. It can also arrive at dawn once a Shadow Orb or Crimson Heart has been broken and a player has 200 max life.
					Unlocks: The Goblin Tinkerer can be found tied up in the Cavern layer. Talk to him to free him.
					Tips: • The event ends when enough goblins are killed; the progress bar shows how far you are.
				}

				OldOnesArmy: {
					Name: Old One's Army
					Short: Defend the Eternia Crystal (Tavernkeep).
					Summary: A tower-defense event: waves of enemies march toward the Eternia Crystal. Rewards are Defender Medals for the Tavernkeep's sentries and armor.
					Summon: Buy an [item:Terraria/DD2ElderCrystalStand] and an [item:Terraria/DD2ElderCrystal] from the Tavernkeep, place the stand and use the crystal on it.
					Unlocks: Tier 1 works any time, Tier 2 after any mechanical boss, Tier 3 after Golem. Each tier has stronger waves and better rewards.
					Requires: The Tavernkeep moves in after the Eater of Worlds or Brain of Cthulhu is defeated.
					Tips:
						'''
						• Enemies go for the crystal, not you: build sentries along both lanes.
						• If the crystal breaks, the event ends.
						'''
				}

				DarkMage: {
					Short: Old One's Army miniboss (Tier 1 and 3).
					Summary: The miniboss of the Old One's Army's first and third tiers. It appears in wave 5 of Tier 1 and waves 5 and 6 of Tier 3.
					Tips: • Focus it quickly so the other enemies do not overwhelm your lanes.
				}

				QueenBee: {
					Short: Jungle bee queen; optional.
					Summary: A giant bee that charges across the screen and releases swarms of bees. Optional, but her drops are strong early gear.
					Summon: Use an [item:Terraria/Abeemination] in the Jungle, or break the larva inside a Bee Hive in the underground Jungle.
					Tips:
						'''
						• Standing in honey gives regeneration.
						• Her charges are horizontal: dodge by moving up or down.
						'''
				}

				Skeletron: {
					Short: Guardian of the Dungeon; opens it.
					Summary: A giant skull with two hands that guards the Dungeon. Defeating it opens the Dungeon and frees the Clothier.
					Summon: Talk to the Old Man at the Dungeon entrance at night and choose to curse him. Or equip a [item:Terraria/ClothierVoodooDoll] and kill the Clothier at night.
					Unlocks: The Dungeon: its enemies, chests (Golden Keys) and the Mechanic, who is found bound inside.
					UnlocksCal: The Dungeon: its enemies, chests (Golden Keys) and the Mechanic, who is found bound inside. Calamity also unlocks the locked chests of the Abyss.
					Warning: Do not enter the Dungeon before Skeletron is defeated: the Dungeon Guardian kills almost instantly.
					Tips:
						'''
						• Its spinning attack hurts a lot; keep moving and use a long platform arena.
						• The fight must end before dawn, or it becomes deadly.
						'''
				}

				Deerclops: {
					Short: Snow biome boss; optional.
					Summary: A one-eyed deer monster from the snow. It creates ice spikes and shadow hands and can slow you. Optional.
					Summon: Use a [item:Terraria/DeerThing] in a Snow biome. It can also appear at midnight during a Blizzard.
					Tips: • Fight on flat ground; its ice spikes travel along the floor.
				}

				WallOfFlesh: {
					Short: Gatekeeper of Hardmode.
					Summary: A wall of flesh that moves across the whole Underworld. Defeating it turns the world into Hardmode.
					Summon: Throw a [item:Terraria/GuideVoodooDoll] into lava in the Underworld while the Guide is alive.
					Unlocks: Hardmode: new enemies, the Hallow and a second evil stripe, Pwnhammer for smashing altars, and many new bosses.
					UnlocksCal: Hardmode: new enemies, the Hallow and a second evil stripe, and many new bosses. With Calamity's early Hardmode rework (on by default) Cobalt and Palladium appear right away, altars give nothing when smashed, and each mechanical boss adds the next ore tier.
					Warning: Hardmode spreads the Hallow and the Corruption or Crimson. Consider protecting important areas before you fight it.
					Tips:
						'''
						• Build a long bridge through the Underworld so you can keep running away from it while attacking.
						• Do not get too far from it: it pulls you back with its tongue.
						'''
				}

				FrostLegion: {
					Name: Frost Legion
					Short: Snowman invasion; Christmas only.
					Summary: An invasion of armed snowmen during the Christmas season.
					Summon: Use a [item:Terraria/SnowGlobe] during the Christmas season. Snow Globes come from opening Presents.
					Requires: Hardmode, during the Christmas season.
				}

				PirateInvasion: {
					Name: Pirate Invasion
					Short: Pirate invasion from the ocean.
					Summary: Pirates invade your town, sometimes with the Flying Dutchman ship. They drop coins and pirate gear.
					Summon: Use a [item:Terraria/PirateMap], dropped by enemies in the Ocean in Hardmode. It can also start by itself in Hardmode.
					Unlocks: After the first win, the Pirate can move in.
					Requires: Hardmode.
				}

				FlyingDutchman: {
					Short: Flying pirate ship miniboss.
					Summary: A flying pirate ship with four cannons. It sometimes appears during a Pirate Invasion.
					Tips: • Destroy its cannons one by one from above or below.
				}

				QueenSlime: {
					Short: Hallow slime queen; first Hardmode boss.
					Summary: A crystal slime queen from the Hallow. In her second phase she flies. A good first Hardmode fight.
					Summon: Use a [item:Terraria/QueenSlimeCrystal] in the Hallow.
					Requires: Hardmode.
					Tips: • Kill the crystal slimes she spawns; they fire in all directions.
				}

				Twins: {
					Name: The Twins
					Short: Mechanical boss: two laser eyes.
					Summary: Retinazer and Spazmatism: two mechanical eyes that fight together. One of the three mechanical bosses needed for Plantera.
					Summon: Use a [item:Terraria/MechanicalEye] at night. Mechanical bosses can also appear by themselves at night in Hardmode until one of them is defeated.
					Unlocks: Souls of Sight. Together with the other two mechanical bosses: Plantera, Chlorophyte tools and the Life Fruit.
					UnlocksCal: Souls of Sight. Each mechanical boss adds the next Hardmode ore tier (Calamity's early Hardmode rework). After all three: Plantera and Hallowed ore.
					Requires: Hardmode.
					Tips: • Focus one eye at a time; Spazmatism's cursed flames hit hard up close.
				}

				Destroyer: {
					Short: Mechanical boss: giant metal worm.
					Summary: A giant mechanical worm whose segments release probes and fire lasers. One of the three mechanical bosses needed for Plantera.
					Summon: Use a [item:Terraria/MechanicalWorm] at night.
					Unlocks: Souls of Might. Together with the other two mechanical bosses: Plantera, Chlorophyte tools and the Life Fruit.
					UnlocksCal: Souls of Might. Each mechanical boss adds the next Hardmode ore tier (Calamity's early Hardmode rework). After all three: Plantera and Hallowed ore.
					Requires: Hardmode.
					Tips: • Piercing weapons hit many segments at once.
				}

				SkeletronPrime: {
					Short: Mechanical boss: Skeletron with weapons.
					Summary: A mechanical Skeletron with four weapon arms. One of the three mechanical bosses needed for Plantera.
					Summon: Use a [item:Terraria/MechanicalSkull] at night.
					Unlocks: Souls of Fright. Together with the other two mechanical bosses: Plantera, Chlorophyte tools and the Life Fruit.
					UnlocksCal: Souls of Fright. Each mechanical boss adds the next Hardmode ore tier (Calamity's early Hardmode rework). After all three: Plantera and Hallowed ore.
					Requires: Hardmode.
					Tips: • Destroying the arms first makes the head much easier.
				}

				Ogre: {
					Short: Old One's Army miniboss (Tier 2 and 3).
					Summary: The big miniboss of the Old One's Army's second and third tiers. It appears in wave 7 of Tier 2 and waves 4 and 6 of Tier 3.
					Requires: Tier 2 of the Old One's Army opens after any mechanical boss is defeated.
				}

				SolarEclipse: {
					Name: Solar Eclipse
					Short: Daytime horror-movie monsters.
					Summary: A daytime event full of monsters from horror movies. Mothron appears after Plantera.
					Summon: Use a [item:Terraria/SolarTablet] during the day. It can also happen by itself at dawn (1 in 20) once a mechanical boss is defeated.
					Requires: Defeat any mechanical boss first.
					TipsCal: • After the Devourer of Gods, Eclipse enemies also drop Darksun Fragments.
				}

				Plantera: {
					Short: Jungle plant boss; opens the Temple.
					Summary: A giant plant rooted in the underground Jungle. It shoots seeds and thorn balls and, in its second phase, charges with a biting maw. Defeating it opens the Jungle Temple.
					Summon: Break a Plantera's Bulb in the underground Jungle. Bulbs only grow after all three mechanical bosses are defeated.
					SummonCal: Break a Plantera's Bulb in the underground Jungle; bulbs only grow after all three mechanical bosses are defeated. Calamity's [item:CalamityMod/Portabulb] can summon it again in the Jungle.
					Unlocks: The Temple Key for the Jungle Temple (Golem), Dungeon upgrades, the Pumpkin and Frost Moons and much more of late Hardmode.
					UnlocksCal: The Temple Key for the Jungle Temple (Golem) and late Hardmode. Calamity adds Perennial ore underground and the Great Sand Shark.
					Requires: Defeat all three mechanical bosses first.
					Tips:
						'''
						• Clear a large area of the underground Jungle and build platforms before breaking the bulb.
						• If you leave the Jungle during the fight, she becomes enraged.
						'''
				}

				Golem: {
					Short: Lihzahrd golem of the Jungle Temple.
					Summary: A stone golem built by the Lihzahrds. Its head detaches in the second phase. Defeating it lets the Lunatic Cultist appear.
					Summon: Use a [item:Terraria/LihzahrdPowerCell] on the Lihzahrd Altar deep inside the Jungle Temple.
					Unlocks: The Lunatic Cultist and its cultists at the Dungeon entrance, Martian Probes, Tier 3 of the Old One's Army.
					UnlocksCal: The Lunatic Cultist at the Dungeon entrance, Martian Probes and Tier 3 of the Old One's Army. Calamity adds the plague in the Jungle and the Plaguebringer Goliath.
					Requires: The Temple Key drops from Plantera.
					Tips: • Clear the temple traps around the altar room first.
				}

				PumpkinMoon: {
					Name: Pumpkin Moon
					Short: Halloween wave event at night.
					Summary: A wave-based night event. Score points by killing enemies to reach later waves with Mourning Wood and the Pumpking.
					Summon: Use a [item:Terraria/PumpkinMoonMedallion] at night. It lasts until dawn.
					Requires: The medallion needs Ectoplasm, which drops after Plantera.
					Tips:
						'''
						• Start right at nightfall to get the most waves.
						• Build an arena with lots of platforms near your base.
						'''
					TipsCal:
						'''
						• Start right at nightfall to get the most waves.
						• After the Devourer of Gods its enemies also drop Nightmare Fuel.
						'''
				}

				MourningWood: {
					Short: Pumpkin Moon miniboss (wave 4+).
					Summary: A haunted tree that appears from wave 4 of the Pumpkin Moon.
				}

				Pumpking: {
					Short: Pumpkin Moon miniboss (wave 7+).
					Summary: The pumpkin king that appears from wave 7 of the Pumpkin Moon.
				}

				FrostMoon: {
					Name: Frost Moon
					Short: Christmas wave event at night.
					Summary: A wave-based night event with Everscream, Santa-NK1 and the Ice Queen in later waves.
					Summon: Use a [item:Terraria/NaughtyPresent] at night. It lasts until dawn.
					Requires: The present needs Ectoplasm, which drops after Plantera.
					Tips: • Start right at nightfall to get the most waves.
					TipsCal:
						'''
						• Start right at nightfall to get the most waves.
						• After the Devourer of Gods its enemies also drop Endothermic Energy.
						'''
				}

				Everscream: {
					Short: Frost Moon miniboss (wave 4+).
					Summary: An evil Christmas tree that appears from wave 4 of the Frost Moon.
				}

				SantaNK1: {
					Short: Frost Moon miniboss (wave 7+).
					Summary: A robot Santa tank that appears from wave 7 of the Frost Moon.
				}

				IceQueen: {
					Short: Frost Moon miniboss (wave 11+).
					Summary: A flying ice queen that appears from wave 11 of the Frost Moon.
				}

				MartianMadness: {
					Name: Martian Madness
					Short: Alien invasion after Golem.
					Summary: An alien invasion led by the Martian Saucer. Its drops include strong weapons and mounts.
					Summon: After Golem, a Martian Probe may appear above ground. Let it see you and fly away to start the invasion.
					Requires: Defeat Golem first.
					Tips: • Kill the probe before it escapes if you are not ready.
				}

				MartianSaucer: {
					Short: Martian Madness miniboss.
					Summary: A flying saucer with turrets that appears during Martian Madness.
				}

				DukeFishron: {
					Short: Ocean boss fished up with a Truffle Worm.
					Summary: A mutant pig-shark that charges very fast and spawns sharknadoes. Optional but drops excellent gear.
					Summon: Fish in the Ocean using a [item:Terraria/TruffleWorm] as bait. Truffle Worms are caught in the underground Glowing Mushroom biome in Hardmode.
					Requires: Hardmode.
					Warning: If you leave the Ocean during the fight, it becomes enraged.
				}

				EmpressOfLight: {
					Short: Hallow fairy empress; optional.
					Summary: A radiant fairy empress with dense bullet patterns. Optional but drops top-tier gear. Fighting her during the day is far deadlier.
					Summon: Kill a [item:Terraria/EmpressButterfly] (Prismatic Lacewing) in the surface Hallow at night after Plantera.
					Requires: Defeat Plantera first.
					Warning: If the sun rises during the fight, her attacks kill almost instantly.
				}

				Betsy: {
					Short: Old One's Army final boss (Tier 3).
					Summary: A fire-breathing dragon that appears in the final wave (7) of the Old One's Army's third tier.
					Summon: Start Tier 3 of the Old One's Army ([item:Terraria/DD2ElderCrystal] on its stand) and reach wave 7.
					Requires: Tier 3 of the Old One's Army opens after Golem.
				}

				LunaticCultist: {
					Short: Cultist at the Dungeon; starts the pillars.
					Summary: The leader of the cultists at the Dungeon entrance. Defeating him starts the Celestial Pillars.
					Summon: After Golem, four cultists worship in front of the Dungeon. Attack them to start the fight.
					SummonCal: After Golem, four cultists worship in front of the Dungeon; attack them to start the fight. Calamity's [item:CalamityMod/EidolonTablet] can also summon it.
					Unlocks: The Celestial Pillars appear across the world.
					Requires: Defeat Golem first.
					Tips: • During his ritual he hides among copies of himself; find the real one quickly.
				}

				CelestialPillars: {
					Name: Celestial Pillars
					Short: Destroy the four lunar towers.
					Summary: Four Celestial Towers (Solar, Vortex, Nebula, Stardust) are shielded until you kill enough enemies around each. Destroying all four summons the Moon Lord.
					Summon: They appear when the Lunatic Cultist is defeated.
					Unlocks: Lunar fragments for endgame gear, and the Moon Lord.
					Requires: Defeat the Lunatic Cultist first.
				}

				MoonLord: {
					Short: Final boss of Terraria.
					Summary: The final boss of Terraria. Destroy both hands and the head before the core becomes vulnerable.
					Summon: It arrives shortly after all four Celestial Pillars are destroyed. Later, a [item:Terraria/CelestialSigil] summons it again.
					Unlocks: Luminite ore and the best vanilla gear.
					UnlocksCal: Luminite ore and the best vanilla gear. In Calamity this is only halfway: the Profaned Guardians, Providence and the rest of the post-Moon Lord route open.
					Requires: Destroy the four Celestial Pillars.
					Warning: With Catalyst loaded, the Astral Communicator stops working after the Moon Lord unless Astrageldon was already defeated.
					Tips: • Its gaze attacks and the Phantasmal Deathray hit hard: keep moving and bring healing.
				}

				DesertScourge: {
					Short: Desert worm; Calamity's first boss.
					Summary: A giant worm of the desert and Calamity's first boss. Defeating it lets the Giant Clam appear in the Sunken Sea.
					Summon: Use a [item:CalamityMod/DesertMedallion] in the Desert. The medallion is not consumed.
					Unlocks: The Giant Clam in the Sunken Sea, and a sandstorm starts. The Sea King can move in once both it and the Giant Clam are defeated.
					Tips: • Fight in the open desert with a platform skybridge above the sand.
				}

				GiantClam: {
					Short: Sunken Sea miniboss.
					Summary: A giant clam living in the waters of the Sunken Sea, below the Desert.
					Summon: Spawns naturally in the water of the Sunken Sea once the Desert Scourge is defeated.
					Requires: Defeat the Desert Scourge first.
				}

				AcidRain1: {
					Name: Acid Rain
					Short: Toxic storm at the Sulphurous Sea.
					Summary: Calamity's Sulphurous Sea event. Acidic enemies and irradiated creatures attack; the first tier drops early materials.
					Summon: After the Eye of Cthulhu, the first Acid Rain starts when you enter the Sulphurous Sea. Later ones start by themselves at night, or use a [item:CalamityMod/CausticTear].
					Requires: Defeat the Eye of Cthulhu first.
					Warning: A Caustic Tear used before the Eye of Cthulhu (or Hardmode) is consumed but starts nothing.
					Tips:
						'''
						• The event fails if the rain stops or if no Acid Rain enemy is killed for 2.5 minutes.
						• Sulphurous water poisons you; avoid swimming in it early.
						'''
				}

				Crabulon: {
					Short: Mushroom crab boss.
					Summary: A giant crab covered in glowing mushrooms, from the underground Glowing Mushroom biome.
					Summon: Use a [item:CalamityMod/DecapoditaSprout] in an underground Glowing Mushroom biome. The sprout is not consumed.
					Unlocks: In Revengeance its Treasure Bag holds the [item:CalamityMod/MushroomPlasmaRoot] (longer Rage).
					Tips: • Dig out a wide space in the mushroom biome before summoning; it jumps a lot.
				}

				HiveMind: {
					Short: Calamity's Corruption boss.
					Summary: Calamity's boss of the Corruption. Its first defeat (or the Perforators') activates Aerialite ore in the sky.
					Summon: Kill a Hive Tumor in the Corruption, or use a [item:CalamityMod/Teratoma] in the Corruption.
					Unlocks: Aerialite ore on floating islands can now be mined (65% pickaxe power).
					Warning: Killing a Hive Tumor summons the boss: do not break them by accident.
				}

				Perforators: {
					Name: The Perforators
					Short: Calamity's Crimson boss.
					Summary: A hive of the Crimson that releases three worms of different sizes. Its first defeat (or the Hive Mind's) activates Aerialite ore in the sky.
					Summon: Kill a Perforator Cyst in the Crimson, or use [item:CalamityMod/BloodyWormFood] in the Crimson.
					Unlocks: Aerialite ore on floating islands can now be mined (65% pickaxe power).
					Warning: Killing a Perforator Cyst summons the boss: do not break them by accident.
				}

				SlimeGod: {
					Short: Two giant slimes and their core.
					Summary: A slime core with two huge Paladin slimes (one Corruption, one Crimson) that split when damaged.
					Summon: Use an [item:CalamityMod/OverloadedSludge] anywhere.
					Unlocks: In Revengeance its Treasure Bag holds the [item:CalamityMod/ElectrolyteGelPack] (stronger Adrenaline).
					Tips: • The large slimes split into smaller ones when hurt; area damage helps.
				}

				Cryogen: {
					Short: Ice crystal boss of the Snow biome.
					Summary: A frozen crystal that fires ice in many patterns. Defeating it charges Cryonic ore and frees Permafrost the Archmage.
					Summon: Use a [item:CalamityMod/CryoKey] in the Snow biome.
					Unlocks: Cryonic ore in the ice caves, and the Archmage (Permafrost) can move in.
					Requires: Hardmode.
				}

				AquaticScourge: {
					Short: Sulphurous Sea worm; stronger Acid Rain.
					Summary: A giant sea worm of the Sulphurous Sea. Defeating it upgrades Acid Rain to its second tier.
					Summon: Use [item:CalamityMod/Seafood] in the Sulphurous Sea, or wait for it to appear there by itself.
					Unlocks: Acid Rain tier 2, with Cragmaw Mire and new drops.
					Requires: Hardmode.
				}

				AcidRain2: {
					Name: Acid Rain (tier 2)
					Short: Acid Rain tier 2 (after Aquatic Scourge).
					Summary: The second tier of Acid Rain, with stronger enemies and the Cragmaw Mire.
					Summon: Starts by itself at night or with a [item:CalamityMod/CausticTear] once the Aquatic Scourge is defeated.
					Requires: Defeat the Aquatic Scourge first.
				}

				CragmawMire: {
					Short: Acid Rain miniboss (tier 2+).
					Summary: An irradiated crab miniboss that appears during Acid Rain after the Aquatic Scourge.
				}

				BrimstoneElemental: {
					Short: Fire elemental of the Brimstone Crag.
					Summary: An elemental of brimstone fire from the Brimstone Crag in the Underworld.
					Summon: Use a [item:CalamityMod/CharredIdol] in the Brimstone Crag.
					Requires: Hardmode.
				}

				CalamitasClone: {
					Short: Brimstone witch clone; tests your gear.
					Summary: A clone of the witch Calamitas with two brothers. A good check before Plantera.
					Summon: Use an [item:CalamityMod/EyeofDesolation].
					Unlocks: Ashes of Calamity, later used to summon Supreme Calamitas.
					Requires: Hardmode.
				}

				GreatSandShark: {
					Short: Sand shark miniboss after Plantera.
					Summary: A giant shark that swims through sand, found in the Desert.
					Summon: Kill 10 Sand Sharks after Plantera, or use a [item:CalamityMod/SandstormsCore] in the Desert.
					Requires: Defeat Plantera first.
				}

				Leviathan: {
					Name: Leviathan and Anahita
					Short: Ocean duo: Anahita and the Leviathan.
					Summary: Anahita, a siren, fights first; the Leviathan joins later. Defeating them unlocks new drops in the Abyss.
					Summon: Kill the elusive singer that sometimes appears in the Ocean, or use a [item:CalamityMod/NaiadsWarhorn] in the Ocean. The horn needs Lumenyl, which only drops after this fight, so the first time is always through the singer.
					Unlocks: Lumenyl and other Abyss drops.
					Warning: The singer can appear in the Ocean even before Hardmode; killing it early summons Anahita.
					Requires: The singer appears much more often after Plantera or Calamitas Clone.
				}

				AstrumAureus: {
					Short: Astral mech-walker; another meteor falls.
					Summary: A giant astral walker from the Astral Infection. Defeating it drops another astral meteor and empowers astral enemies.
					Summon: Use an [item:CalamityMod/AstralChunk] in the Astral Infection.
					Unlocks: In Revengeance its Treasure Bag holds the [item:CalamityMod/StarlightFuelCell] (stronger Adrenaline).
					Requires: The Astral Chunk needs a decrypted schematic from the lab on the large sky planetoid.
				}

				PlaguebringerGoliath: {
					Short: Plague mecha-bee of the Jungle.
					Summary: A giant mechanical bee spreading the plague, fought in the Jungle after Golem.
					Summon: Use an [item:CalamityMod/Abombination] in the Jungle.
					Requires: The Abombination needs Plague Cell Canisters (plague enemies after Golem) and a decrypted schematic from the Jungle lab.
				}

				Ravager: {
					Short: Flesh golem of stone and bone.
					Summary: A huge flesh golem with detachable limbs.
					Summon: Use a [item:CalamityMod/DeathWhistle].
					Unlocks: In Revengeance its Treasure Bag holds [item:CalamityMod/InfernalBlood] (longer Rage).
					Requires: The whistle needs Lunar Tablet Fragments from Jungle Temple enemies (after Plantera).
				}

				AstrumDeus: {
					Short: Astral star-worm; unlocks Astral Ore.
					Summary: A cosmic worm of the Astral Infection that splits into two worms. Defeating it lets you mine Astral Ore.
					Summon: Offer a [item:CalamityMod/TitanHeart] or [item:CalamityMod/Starcore] at an [item:CalamityMod/AstralBeaconItem] (a beacon also stands in the Astral Infection).
					Unlocks: Astral Ore can be mined.
					Requires: Recommended after the Lunatic Cultist. Titan Hearts drop from Atlas, an enemy of the surface Astral Infection.
				}

				ProfanedGuardians: {
					Name: Profaned Guardians
					Short: Three guardians of the profaned flame.
					Summary: Three guardians of Providence: an attacker, a defender and a healer. Defeating them gives the Profaned Core.
					Summon: Use a [item:CalamityMod/ProfanedShard] in the Hallow or in the Underworld.
					Unlocks: The [item:CalamityMod/ProfanedCore] to summon Providence.
					Requires: Defeat the Moon Lord first.
				}

				Dragonfolly: {
					Short: Jungle thunder-bird.
					Summary: A giant electric bird of the Jungle. Its Effulgent Feathers are needed for Yharon's egg.
					Summon: Use [item:CalamityMod/ExoticPheromones] in the Jungle.
					Unlocks: Effulgent Feathers for the Yharon egg. In Revengeance its Treasure Bag holds the [item:CalamityMod/RedLightningContainer] (longer Rage).
					Requires: Defeat the Moon Lord first.
				}

				Providence: {
					Short: The Profaned Goddess.
					Summary: The Profaned Goddess. Defeating her releases Uelibloom ore and lets you fight the Sentinels.
					Summon: Use the [item:CalamityMod/ProfanedCore] in the Hallow or in the Underworld.
					Unlocks: Uelibloom ore in the Jungle, and the Mark of Providence for the Sentinels.
					Requires: The Profaned Core drops from the Profaned Guardians.
				}

				CeaselessVoid: {
					Short: Sentinel of the Dungeon.
					Summary: One of the three Sentinels of the Devourer: a void that pulls you in, fought in the Dungeon.
					Summon: Use a [item:CalamityMod/MarkofProvidence] in the Dungeon.
					Requires: Defeat the Moon Lord first. The Mark of Providence drops from Providence or can be crafted.
				}

				StormWeaver: {
					Short: Sentinel of space.
					Summary: One of the three Sentinels of the Devourer: an armored storm worm, fought high in the sky or in space.
					Summon: Use a [item:CalamityMod/MarkofProvidence] high in the sky or in space.
					Requires: Defeat the Moon Lord first. The Mark of Providence drops from Providence or can be crafted.
				}

				Signus: {
					Short: Sentinel of the Underworld.
					Summary: One of the three Sentinels of the Devourer: a teleporting assassin, fought in the Underworld.
					Summon: Use a [item:CalamityMod/MarkofProvidence] in the Underworld.
					Requires: Defeat the Moon Lord first. The Mark of Providence drops from Providence or can be crafted.
				}

				Polterghast: {
					Short: Dungeon ghost; last Acid Rain tier.
					Summary: A mass of restless souls haunting the Dungeon. Defeating it stirs the last tier of Acid Rain.
					Summon: Kill 30 Phantom Spirits (released by strong Dungeon enemies after the Moon Lord), or use a [item:CalamityMod/NecroplasmicBeacon] in the Dungeon.
					Unlocks: Acid Rain tier 3 (Mauler, Nuclear Terror and the Old Duke). In Revengeance its Treasure Bag holds the [item:CalamityMod/Ectoheart].
					Requires: Defeat the Moon Lord first.
					Tips: • The Phantom Spirit count resets when you leave the world.
				}

				AcidRain3: {
					Name: Acid Rain (tier 3)
					Short: Final Acid Rain; ends with the Old Duke.
					Summary: The last tier of Acid Rain, with the Mauler and the Nuclear Terror. Completing it summons the Old Duke.
					Summon: Starts by itself at night or with a [item:CalamityMod/CausticTear] once Polterghast is defeated.
					Requires: Defeat Polterghast first.
				}

				Mauler: {
					Short: Acid Rain miniboss (tier 3).
					Summary: An irradiated shark miniboss of the last Acid Rain tier.
				}

				NuclearTerror: {
					Short: Acid Rain miniboss (tier 3).
					Summary: A radioactive miniboss of the last Acid Rain tier.
				}

				OldDuke: {
					Short: Irradiated Duke Fishron.
					Summary: A rotting, irradiated Duke Fishron from the Sulphurous Sea.
					Summon: Finish the tier 3 Acid Rain, or fish in the Sulphurous Sea with a [item:CalamityMod/BloodwormItem] as bait (sold by the Sea King after the first win).
					Requires: Defeat Polterghast first.
				}

				DevourerOfGods: {
					Short: The cosmic serpent.
					Summary: A cosmic serpent that devours gods. Defeating it upgrades the Pumpkin Moon, Frost Moon and Solar Eclipse drops.
					Summon: Use a [item:CalamityMod/CosmicWorm]. It can be crafted from the three Sentinels' drops, or from Luminite, lunar fragments, Meld Blobs and Necroplasm.
					Unlocks: Nightmare Fuel, Endothermic Energy and Darksun Fragments from the moon events and the Eclipse.
					Requires: Defeat the Moon Lord first.
					Tips: • Its attacks are fast; a strong dash and good flight are essential.
				}

				Yharon: {
					Short: The Dragon of Rebirth; unlocks Auric ore.
					Summary: The Jungle Dragon, Yharon. Defeating him releases Auric ore, needed for the final bosses.
					Summon: Use the [item:CalamityMod/YharonEgg].
					Unlocks: Auric ore in the caverns, and the materials for the Exo Mechs and Supreme Calamitas.
					Requires: The egg needs Effulgent Feathers from the Dragonfolly.
				}

				ExoMechs: {
					Name: Exo Mechs
					Short: Draedon's three war machines.
					Summary: Draedon's final machines: Thanatos, Ares and the twins Artemis and Apollo. You choose which one to fight first.
					Summon: Fully upgrade the Codebreaker, put in an [item:CalamityMod/AuricQuantumCoolingCell] and contact Draedon.
					Requires: Defeat Yharon first: the cooling cell needs Auric Bars.
					Tips: • See the Draedon's labs guide for the Codebreaker upgrades.
				}

				SupremeCalamitas: {
					Short: The Brimstone Witch herself.
					Summary: Supreme Witch, Calamitas: one of the two final bosses of Calamity. Defeating her lets the Brimstone Witch move in.
					Summon: Offer [item:CalamityMod/AshesofCalamity] (or a [item:CalamityMod/CeremonialUrn] for later fights) at an [item:CalamityMod/AltarOfTheAccursedItem].
					Unlocks: The Brimstone Witch (Calamitas) as a town NPC; she can enchant your items.
					Requires: The Altar of the Accursed needs Auric Bars (after Yharon).
				}

				PrimordialWyrm: {
					Short: Ancient wyrm of the deepest Abyss.
					Summary: An ancient wyrm living in the deepest layer of the Abyss. It becomes enraged outside that layer.
					Summon: It appears when someone in the Abyss gets Chaos State, for example by teleporting with a Rod of Discord. With Infernum it can also be summoned with an Evoking Searune in the deepest layer.
					Unlocks: It drops a [item:CalamityMod/Terminus].
					Warning: This works at any point of the game: teleporting in the Abyss early means a fight you cannot win.
				}

				BossRush: {
					Name: Boss Rush
					Short: Fight every boss in a row.
					Summary: An extreme challenge: every boss in order, massively strengthened, with no breaks.
					Summon: Use the [item:CalamityMod/Terminus] (hold it to channel). It can be used at any time; use it again to stop.
					Warning: Boss Rush bosses are far stronger than normal. Start it only when you mean it.
				}

				Astrageldon: {
					Short: Astral slime; must be beaten before the Moon Lord.
					Summary: A giant astral slime from the Catalyst mod.
					Summon: Use the [item:CatalystMod/AstralCommunicator] on the surface of the Astral Infection. The communicator is not consumed and drops from Ascended Astral Slimes.
					Warning: Defeat Astrageldon before the Moon Lord: afterwards the Astral Communicator stops working unless Astrageldon was already killed.
					Requires: The Moon Lord was defeated before Astrageldon: in this world it can no longer be summoned.
				}

				Dreadnautilus: {
					Short: Blood Moon nautilus boss (Infernum).
					Summary: Infernum turns the Blood Moon's Dreadnautilus into a full boss.
					Summon: Use [item:InfernumMode/RedBait] at night (not consumed), or fish it up during a Blood Moon.
					Requires: Hardmode, with Infernum on.
				}

				BereftVassal: {
					Short: Infernum's desert warrior boss.
					Summary: A new boss added by Infernum: a lone warrior fought with the Great Sand Shark in the heart of the desert.
					Summon: Use a [item:CalamityMod/SandstormsCore] at the pedestal in the heart of the desert.
					Requires: Defeat the Lunatic Cultist first, with Infernum on.
				}

				Goozma: {
					Short: The slime god of Hunt of the Old God.
					Summary: Goozma, the ancient slime god. A very hard fight designed for the end of the game, though it can be summoned in Hardmode.
					Summon: Throw an [item:CalamityMod/OverloadedSludge] onto King Slime during a Slime Rain, or use a [item:CalamityHunt/PluripotentSpawnEgg] on an empowered Slime Ninja Statue.
					Unlocks: The [item:CalamityHunt/GoozmaSoul]: touch it to absorb it for permanent stats (see the Upgrades tab). With Hunt's Shadowspec Curse option on (the default), items crafted from Shadowspec Bars can only be used after Goozma is defeated.
					Requires: Hardmode.
					Warning: It is balanced for the end of the game; summoning it early is a trap.
				}

				SolynMeet: {
					Name: Meet Solyn
					Short: Wrath of the Gods: meet the star traveler.
					Summary: Solyn, a traveler from the stars, starts the story of Wrath of the Gods.
					Summon: After Skeletron (or in Hardmode) Solyn can appear in your world. Find her and talk to her until the introduction ends.
					Requires: Defeat Skeletron first.
				}

				SolynCamp: {
					Name: Solyn's camp
					Short: Choose where Solyn sets up camp.
					Summary: Solyn wants a place to set up camp in your world.
					Summon: Talk to Solyn: she gives you a [item:NoxusBoss/StrangeFlagpole]. Place it on open, flat ground to choose the camp site.
					Requires: Meet Solyn first.
				}

				SolynStargaze: {
					Name: Stargazing
					Short: Repair the telescope and stargaze with Solyn.
					Summary: Solyn wants to go stargazing. The quest ends with a gift: the [item:NoxusBoss/StarCharm].
					Summon: Talk to Solyn about stargazing, then repair the telescope at her camp with 10 Gold or Platinum Bars (whichever your world has) and 15 Wood. Talk to her again to watch the sky.
					Requires: Meet Solyn first.
				}

				PermafrostKeep: {
					Name: Permafrost Keep
					Short: Explore a frozen keep with Solyn.
					Summary: A frozen keep hidden in the snow. Solyn joins you to explore it.
					Summon: After Cryogen, Permafrost gives you the [item:NoxusBoss/DormantKey] as thanks for freeing him. Show it to Solyn, then open the keep with her.
					Requires: Finish the stargazing quest and defeat Cryogen.
				}

				GenesisReveal: {
					Name: The Genesis
					Short: Solyn tells you about the Genesis.
					Summary: After the Moon Lord a rift appears in the sky; Solyn explains the Genesis.
					Summon: Talk to Solyn once the rift is in the sky after the Moon Lord.
					Requires: Finish Permafrost Keep and defeat the Moon Lord.
				}

				Antiseed: {
					Name: The Antiseed
					Short: Enter the rift with Solyn for the Antiseed.
					Summary: Solyn asks for help with the Ceaseless Void's rift. Inside waits [item:NoxusBoss/TheAntiseed].
					Summon: After Providence, talk to Solyn about the Ceaseless Void, defeat it, then follow her into the rift.
					Requires: Learn about the Genesis and defeat Providence.
				}

				Mars: {
					Short: Draedon's machine, fought with Solyn.
					Summary: A war machine of Draedon, fought alongside Solyn in a special quest.
					Summon: Start the special quest with Solyn, then contact Draedon with the Codebreaker.
					Requires: Get the Antiseed and defeat the Exo Mechs.
				}

				AvatarOfEmptiness: {
					Short: Wrath of the Gods boss: activate the Genesis.
					Summary: The Avatar of Emptiness appears when the Genesis is activated.
					Summon: Construct and activate the Genesis.
					Requires: Defeat Mars and complete the Genesis.
				}

				NamelessDeity: {
					Short: The final god of Wrath of the Gods.
					Summary: The Nameless Deity, the final challenge of Wrath of the Gods.
					Summon: Use the [item:CalamityMod/Terminus] after its gaze has opened.
					Requires: Defeat the Avatar of Emptiness first.
				}

				SirNautilus: {
					Short: Fables: a lone soldier under the dunes.
					Summary: A lone soldier from Calamity Fables, waiting in a hidden chamber under the desert.
					Summon: Find his hidden chamber beneath the dunes; an ancient sandstone graveyard marks the spot.
				}

				FablesDesertScourge: {
					Short: Fables' reworked Desert Scourge.
					Summary: Calamity Fables' version of the Desert Scourge. With Calamity loaded it replaces Calamity's Desert Scourge while Fables' "replace Calamity" option is on (the default).
					Summon: Lure it out with stormlion grubs: [item:CalamityFables/StormlionLarvaItem], [item:CalamityFables/DeadStormlionLarvaItem] or the [item:CalamityFables/BucketOfLarvae].
				}

				ScourgeVsScarab: {
					Short: Duel: Desert Scourge vs. Scarabeus.
					Summary: A special duel added by Calamity Fables when Spirit Reforged is loaded: the Desert Scourge and Scarabeus fight each other and you.
					Summon: Offer a stormlion grub ([item:CalamityFables/StormlionLarvaItem], [item:CalamityFables/DeadStormlionLarvaItem] or [item:CalamityFables/BucketOfLarvae]) on an [item:SpiritReforged/ScarabAltarItem].
				}

				FablesCrabulon: {
					Short: Fables' reworked Crabulon.
					Summary: Calamity Fables' version of Crabulon. With Calamity loaded it replaces Calamity's Crabulon while Fables' "replace Calamity" option is on (the default).
					Summon: Before its first defeat it can peek out naturally in the mushroom caves. Draw its attention with a [item:CalamityFables/Hookstaff] used while standing on mushroom grass underground.
				}

				Scarabeus: {
					Short: Spirit Reforged: giant scarab of the Ziggurat.
					Summary: A giant scarab beetle from Spirit Reforged, fought at the desert Ziggurat.
					Summon: Use any gem at the [item:SpiritReforged/ScarabAltarItem] on the Ziggurat during the day.
				}
			}

			Stages: {
				pre-boss: {
					Name: Pre-Boss
					Hint: Build a few houses, collect Life Crystals and make ore armor. King Slime and the Desert Scourge are good first fights; with a Gravitation Potion you can also reach floating islands and Planetoids.
				}

				pre-evil1: {
					Name: Pre-Eater of Worlds / Brain of Cthulhu
					Hint: The Eye of Cthulhu lets Acid Rain start at the Sulphurous Sea, and the Desert Scourge lets the Giant Clam appear in the Sunken Sea. Crabulon waits in the underground Glowing Mushroom biome. Then face your world's evil boss.
				}

				pre-evil2: {
					Name: Pre-Hive Mind / Perforators
					Hint: With the first evil boss down, Meteorites can land and the Tavernkeep can move in. Calamity's own evil boss is next: The Hive Mind in the Corruption or The Perforators in the Crimson.
				}

				pre-skeletron: {
					Name: Pre-Skeletron
					Hint: Beating The Hive Mind or The Perforators activates the Aerialite ore on floating islands (needs 65% pickaxe power). Queen Bee and Deerclops are optional but drop gear that helps against Skeletron.
				}

				pre-wof: {
					Name: Pre-Wall of Flesh
					Hint: Skeletron opens the Dungeon and unlocks the locked chests of the Abyss. Fight the Slime God, then build a long flat arena in the Underworld for the Wall of Flesh.
				}

				pre-mech: {
					Name: Pre-Mechanical Bosses
					Hint: Hardmode! With Calamity's early Hardmode rework (on by default) Cobalt and Palladium appear right away and altars give nothing; each mechanical boss you defeat adds the next ore tier. Cryogen and Queen Slime are good early fights.
				}

				post-mech1: {
					Name: Post-Mechanical Boss 1
					Hint: One mechanical boss down: Mythril and Orichalcum have spawned. The Aquatic Scourge (Sulphurous Sea) is a good next fight; Solar Eclipses can now happen.
				}

				post-mech2: {
					Name: Post-Mechanical Boss 2
					Hint: Two mechanical bosses down: Adamantite and Titanium have spawned. The Brimstone Elemental waits in the Brimstone Crag in the Underworld.
				}

				pre-plantera: {
					Name: Pre-Plantera
					Hint: All three mechanical bosses down: Hallowed ore has spawned in the underground Hallow and Plantera's Bulbs grow in the underground Jungle. Calamitas Clone is a good test before Plantera.
				}

				pre-golem: {
					Name: Pre-Golem
					Hint: Plantera drops the Temple Key and releases Perennial ore underground. The Leviathan and Anahita, Astrum Aureus and the Great Sand Shark are now fair fights before Golem.
				}

				post-golem: {
					Name: Post-Golem
					Hint: Golem brings the plague to the Jungle and Martian Probes to the surface. The Plaguebringer Goliath, Ravager, Duke Fishron, the Empress of Light and the Pumpkin and Frost Moons all give strong gear.
				}

				pre-lunar: {
					Name: Pre-Lunar Events
					Hint: Kill the Lunatic Cultist at the Dungeon entrance to start the Celestial Pillars.
				}

				pre-moonlord: {
					Name: Pre-Moon Lord
					Hint: Destroy all four pillars to summon the Moon Lord. Astrum Deus can be fought before it. If you play with Catalyst, defeat Astrageldon before the Moon Lord.
				}

				pre-provi: {
					Name: Pre-Providence
					Hint: The Moon Lord awakens the profaned flame: the Profaned Guardians and Providence are next. A new ore appears in space, strong Dungeon enemies can release Phantom Spirits, and the Dragonfolly can be fought in the Jungle.
				}

				pre-polter: {
					Name: Pre-Polterghast
					Hint: Providence releases Uelibloom ore in the Jungle. Use the Mark of Providence in the Dungeon, the Underworld and space to fight the three Sentinels, then face Polterghast in the Dungeon.
				}

				pre-dog: {
					Name: Pre-Devourer of Gods
					Hint: Polterghast stirs the last tier of Acid Rain, which ends with the Old Duke. The Cosmic Worm for the Devourer of Gods can be crafted from the Sentinels' drops, or from Luminite, lunar fragments, Meld Blobs and Necroplasm.
				}

				pre-yharon: {
					Name: Pre-Yharon
					Hint: The Devourer of Gods makes the Pumpkin Moon, Frost Moon and Solar Eclipse drop new materials. Yharon's egg needs Effulgent Feathers from the Dragonfolly.
				}

				pre-scal-exo: {
					Name: Pre-Exo Mechs / Supreme Calamitas
					Hint: Yharon releases Auric ore. Two final bosses remain: the Exo Mechs (fully upgraded Codebreaker with an Auric Quantum Cooling Cell) and Supreme Witch, Calamitas (Altar of the Accursed).
				}

				endgame: {
					Name: Endgame
					Hint: Both final bosses are beaten. Remaining challenges: Boss Rush, the Primordial Wyrm in the Abyss, and the bosses of add-on mods.
				}

				v-pre-boss: {
					Name: Pre-Bosses
					Hint: Build houses, collect Life Crystals and make ore armor. Smashing a Shadow Orb or Crimson Heart gives an early weapon.
				}

				v-pre-skeletron: {
					Name: Pre-Skeletron
					Hint: The evil boss is down: Meteorites can land, the Tavernkeep can move in, and its bars make a pickaxe that mines Hellstone. Skeletron opens the Dungeon.
				}

				v-pre-wof: {
					Name: Pre-Wall of Flesh
					Hint: The Dungeon is open. Build a long flat arena in the Underworld for the Wall of Flesh; defeating it starts Hardmode.
				}

				v-pre-mech: {
					Name: Pre-Mechanical Bosses
					Hint: Hardmode: smash Demon or Crimson Altars with the Pwnhammer to spawn new ores. Queen Slime and the three mechanical bosses are next.
				}

				v-pre-plantera: {
					Name: Pre-Plantera
					Hint: All mechanical bosses down: Plantera's Bulbs grow in the underground Jungle and Chlorophyte can be mined.
				}

				v-pre-golem: {
					Name: Pre-Golem
					Hint: Plantera drops the Temple Key. Golem waits in the Jungle Temple; the Pumpkin and Frost Moons, Duke Fishron and the Empress of Light are strong optional fights.
				}

				v-pre-cultist: {
					Name: Pre-Lunatic Cultist
					Hint: Golem is down: the Lunatic Cultist appears at the Dungeon entrance, and Martian Probes can start Martian Madness.
				}

				v-pre-moonlord: {
					Name: Pre-Moon Lord
					Hint: Destroy the four Celestial Pillars; the Moon Lord arrives soon after.
				}

				v-endgame: {
					Name: Endgame
					Hint: The Moon Lord is defeated. Craft the best gear from Luminite and the lunar fragments.
				}
			}

			LoadoutNotes: {
				C1: Obtained by throwing an Enchanted Sword into Shimmer.
				C2: This is difficult to obtain.
				C3: Best on worms and other multi-hit targets.
				C4: Best on worms and other multi-hit targets; also a support weapon.
				C5: The Mystic Robe is difficult to obtain.
				C6: These are difficult to obtain.
				C7: Upgrades of this also work.
				C8: This is difficult to use.
				C9: Use with Purple Haze.
				C10: Works as rogue armor; difficult to obtain.
				C11: Use with the Wulfrum Knife.
				C12: Use it in its defensive form.
				C13: These have a new set bonus.
				C14: New set bonus; difficult to obtain if your world has no Silver.
				C15: Difficult to obtain; only one per world.
				C16: Difficult to obtain depending on your world evil.
				C17: This is risky to use.
				C18: Use with Musket Balls or Tungsten Bullets.
				C19: Used for support.
				C20: Use with Fungicide.
				C21: Difficult to use and to obtain.
				C22: Use the one that matches your world evil.
				C23: Use with a Counterweight.
				C24: Use with the Smoking Comet.
				C25: Use with Meteor armor.
				C26: Use with the Space Gun.
				C27: This item is difficult to use.
				C28: Dodges in Calamity are guaranteed but have a cooldown.
				C29: Use it on Skeletron.
				C30: Use it on Deerclops.
				C31: Use with Musket Balls or Tungsten Bullets.
				C32: Use with the Aquashard Shotgun.
				C33: Use with the Hive Pack.
				C34: Use with the Hornet Staff.
				C35: This weapon does not benefit from melee speed.
				C36: Use it on the Slime God.
				C37: Use it on the Wall of Flesh.
				C38: This has a new set bonus.
				C39: Use with the Archerfish.
				C40: Needs an arena at the same height as one of the Wall of Flesh's eyes.
				C41: Needs aggressive play.
				C42: Upgrades also work; keep it in your inventory if you use the Walking Cane.
				C43: Difficult to use because of screen clutter.
				C44: Difficult to use; best on worms and other multi-hit targets.
				C45: Use with the Endless Musket Pouch.
				C46: Use with the Needler.
				C47: Needs boss preparation; difficult to obtain.
				C48: You need to stay close to the boss for it to work well.
				C49: Background walls are not required.
				C50: Calamity increases this item's drop rate.
				C51: Works as rogue armor.
				C52: Use it for Cryogen.
				C53: Faster vertical speed.
				C54: Faster fall speed.
				C55: Fairy boots also give defensive benefits.
				C56: Use it on Queen Slime or the Destroyer.
				C57: Use it on Cryogen.
				C58: Difficult to use; use with the Power Glove.
				C59: Use with the Majestic Guard.
				C60: Needs boss preparation.
				C61: Difficult to use; best on worms and other multi-hit targets.
				C62: Faster acceleration.
				C63: Better vertical mobility.
				C64: Use it on the Destroyer.
				C65: Difficult to use; best on worms and other multi-hit targets.
				C66: Keep the Brimseekers in their empowered state, even when using a whip.
				C67: Every attunement except Decay's Retort and Heaven's Might works.
				C68: Use it for Plantera.
				C69: Use it for Calamitas Clone.
				C70: Use with Souls of Sight.
				C71: Use with the SHPC.
				C72: Use it on Plantera.
				C73: Use it on Calamitas Clone.
				C74: Used for support; the Crimson Key for it drops more often from Crimson Mimics.
